using std;

/** Provides a pure counter view and a named state update handler. */
module counter {

  /** Mutates borrowed application state after native event dispatch has returned. */
  function increment(
    state: ref i64,
    event: const ref ui.Event,
    queue: ref ui.EventQueue
  ) void throws {
    state += 1;
    return;
  }

  /** Runs the interactive counter or a real-signal acceptance scenario. */
  public function run(automated: bool) void throws {
    var title = String("Sun UI — Counter");
    var renderer = ui_gtk.Renderer(title);
    var session = ui.Session<i64>(0, view, increment);
    session.render(renderer);
    var original = session.tree.identity(1);
    if (automated) {
      renderer.click(original);
      renderer.poll(session.tree, session.queue, false);
      session.dispatch(renderer);
      if (session.state != 1 or session.tree.identity(1) != original or renderer.updates != 1 or
        renderer.creates != 1) {
        throw Error(1, "Counter did not perform one targeted text update");
      }
      // More clicks than one native collection turn must remain runnable without new input.
      for (var i: i64 = 0; i < 65; i += 1) {
        renderer.click(original);
      }
      renderer.poll(session.tree, session.queue, true);
      if (session.queue.size() != 64) {
        throw Error(1, "Native batch was not bounded");
      }
      session.dispatch(renderer);
      renderer.poll(session.tree, session.queue, true);
      session.dispatch(renderer);
      if (session.state != 66 or renderer.creates != 1) {
        throw Error(1, "Pending native clicks were stranded");
      }
      session.tree.shutdown(renderer);
      if (renderer.removals != 1) {
        throw Error(1, "Counter subscription was not removed");
      }
      std.io.println("Counter acceptance passed");
      return;
    }
    while (renderer.running()) {
      renderer.poll(session.tree, session.queue, true);
      session.dispatch(renderer);
    }
    session.tree.shutdown(renderer);
    return;
  }
}

/** Selects interactive execution or the bounded automated scenario. */
function main(argc: i32, argv: raw_ptr<raw_ptr<i8>>) i32 throws {
  var a = make_heap_allocator();
  var env = std.env.Env(a);
  var args = env.args(argc, argv);
  try {
    counter.run(args.size() == 2 and args[1].equals_literal("--self-test"));
    return 0;
  } catch (error: std.Error) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.AllocationError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.InvalidArgumentError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.OverflowError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.IndexOutOfBoundsError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.NotFoundError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.EmptyError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.IOError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.ConversionError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.DivisionByZeroError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.ArithmeticError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.json.JsonError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.xml.XmlError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.ProtoDecodeError) {
    std.io.eprintln(error.message());
    return 1;
  }
}
manifest {
  source_files: [
    "../../build/generated/examples/counter-xml/counter.view.sun"
  ], libraries: [
    "stdlib.moon",
    "sun_ui.moon",
    "${namo-robotics/sun_gobject}/lib/sun_gobject.moon",
    "${namo-robotics/sun_gobject}/lib/sun_gtk.moon",
    "sun_ui_gtk.moon"
  ]
}
