using std;

/** Demonstrates keyed component composition and owned task-ID event payloads. */
module tasks {

  /** Owns task IDs and selection independently of any renderer or widget handle. */
  class State {
    var ids: Vec<i64>;
    var next_id: i64 = 3;
    var selected: i64 = 0;
    var reversed: bool = false;

    /** Reverses display order when the generated dispatcher delivers the action. */
    public method reverse_tasks(event: const ref ui.Event, queue: ref ui.EventQueue) SystemResult<void> {
      this.reversed = not this.reversed;
      return SystemResult.Ok;
    }

    /** Seeds two tasks with stable keys. */
    init() {
      var a = make_heap_allocator();
      this.ids = Vec<i64>(a, 8);
      this.ids.push(1);
      this.ids.push(2);
    }
  }

  /** Composes a task button using its durable ID as both key and event payload. */
  function task(view: ref ui.View, parent: i64, id: i64, selected: bool) void {
    var label = `Task ${id}`;
    if (selected) {
      label.append(" — selected");
    }
    var node = ui.Element(ui.Key(id), ui.Kind.Button);
    node.text = label;
    node.action = 4;
    node.payload = id;
    view.append(parent, node);
  }

  /** Copies visible IDs in display order for a keyed XML repetition. */
  function visible_ids(state: const ref State) Vec<i64> {
    var a = make_heap_allocator();
    var result = Vec<i64>(a, state.ids.size());
    for (var i: i64 = 0; i < state.ids.size(); i += 1) {
      result.push(state.ids[state.reversed ? state.ids.size() - 1 - i : i]);
    }
    return result;
  }

  /** Resolves a task's scoped button using its durable application key. */
  function identity(tree: const ref ui.Tree, key: i64) u64 {
    var a = make_heap_allocator();
    var path = Vec<ui.Key>(a, 3);
    path.push(ui.Key(key));
    path.push(ui.Key(String("task")));
    path.push(ui.Key(key));
    return tree.identity_path(path);
  }

  /** Appends a task when the generated action dispatcher calls this function. */
  function add_task(state: ref State, event: const ref ui.Event, queue: ref ui.EventQueue) SystemResult<void> {
    state.ids.push(state.next_id);
    state.next_id += 1;
    return SystemResult.Ok;
  }

  /** Removes the selected task while retaining the remaining items' stable keys. */
  function remove_selected(state: ref State, event: const ref ui.Event, queue: ref ui.EventQueue) SystemResult<void> {
    for (var i: i64 = 0; i < state.ids.size(); i += 1) {
      if (state.ids[i] == state.selected) {
        match state.ids.remove(i) {
          AccessResult.Ok(_) => {},
          AccessResult.OutOfBounds(_) => {}
        };
        state.selected = 0;
        break;
      }
    }
    return SystemResult.Ok;
  }

  /** Handles numeric actions from the handwritten task component. */
  function handle(state: ref State, event: const ref ui.Event, queue: ref ui.EventQueue) SystemResult<void> {
    if (event.action == 4) {
      state.selected = event.payload;
    }
    return SystemResult.Ok;
  }

  /** Delivers a real native click through the framework's explicit dispatch boundary. */
  function click(renderer: ref ui_gtk.Renderer, session: ref ui.Session<State>, key: i64) SystemResult<void> {
    if (key < 0) {
      // Tests read generated toolbar keys instead of depending on their spelling.
      var a = make_heap_allocator();
      var description = view(session.state);
      var path = Vec<ui.Key>(a, 1);
      path.push(description.elements[-key - 1].key.clone(a));
      renderer.click(session.tree.identity_path(path));
    } else {
      renderer.click(identity(session.tree, key));
    }
    renderer.poll(session.tree, session.queue, false);
    return session.dispatch(renderer);
  }

  /** Checks identity, native order, focus, targeted updates, and subscription cleanup. */
  function acceptance(renderer: ref ui_gtk.Renderer, session: ref ui.Session<State>) SystemResult<void> {
    var first = identity(session.tree, 1);
    var second = identity(session.tree, 2);
    try click(renderer, session, 2);
    if (session.state.selected != 2 or renderer.updates != 1) {
      return SystemResult.Error(Error(1, "Task payload or targeted selection update failed"));
    }
    // Collection must preserve native order across controls, independently of tree order.
    renderer.click(second);
    renderer.click(first);
    renderer.poll(session.tree, session.queue, false);
    try session.dispatch(renderer);
    if (session.state.selected != 1) {
      return SystemResult.Error(Error(1, "Cross-widget native event order was changed"));
    }
    try click(renderer, session, 2);
    renderer.focus(second);
    if (renderer.focused(second) == false) {
      return SystemResult.Error(Error(1, "Initial native focus failed"));
    }
    try click(renderer, session, -2);
    if (renderer.focused(second) == false) {
      return SystemResult.Error(Error(1, "Reorder did not preserve native focus and order"));
    }
    try click(renderer, session, -1);
    var third = identity(session.tree, 3);
    if (third == 0 or renderer.focused(second) == false) {
      return SystemResult.Error(Error(1, "Insertion did not preserve focus or order"));
    }
    if (identity(session.tree, 1) != first or identity(session.tree, 2) != second or renderer.creates != 12) {
      return SystemResult.Error(Error(1, "Surviving tasks were remounted"));
    }
    try click(renderer, session, -3);
    if (identity(session.tree, 2) != 0 or renderer.removals != 3) {
      return SystemResult.Error(Error(1, "Removal did not clean up the selected task"));
    }
    session.tree.enqueue(second, session.queue);
    if (session.queue.size() != 0) {
      return SystemResult.Error(Error(1, "Removed task still delivers events"));
    }
    session.tree.shutdown(renderer);
    if (renderer.removals != renderer.creates) {
      return SystemResult.Error(Error(1, "Subscriptions survived shutdown"));
    }
    println("Task list acceptance passed");
    return SystemResult.Ok;
  }

  /** Runs the native task list with explicitly owned state and bounded dispatch turns. */
  public function run(automated: bool) SystemResult<void> {
    var title = String("Sun UI — Keyed tasks");
    var renderer = try ui_gtk.Renderer(title);
    var state = State();
    var session = ui.Session<State>(state, view, view_handle);
    try session.render(renderer);
    if (automated) {
      return acceptance(renderer, session);
    }
    while (renderer.running()) {
      renderer.poll(session.tree, session.queue, true);
      try session.dispatch(renderer);
    }
    session.tree.shutdown(renderer);
    return SystemResult.Ok;
  }
}

/** Runs the interactive demo or its display-backed acceptance scenario. */
function main(argc: i32, argv: raw_ptr<raw_ptr<i8>>) i32 {
  var a = make_heap_allocator();
  var env = std.env.Env(a);
  var args = env.args(argc, argv);
  return match tasks.run(args.size() == 2 and args[1].equals_literal("--self-test")) {
    SystemResult.Ok => 0,
    SystemResult.Error(error) => {
      eprintln(error.message());
      return 1;
    }
  };
}
manifest { source_files: ["../../build/generated/examples/tasks-xml/tasks.view.sun"], libraries: ["stdlib.moon", "sun_ui.moon", "sun_gobject.moon", "sun_gtk.moon", "sun_ui_gtk.moon"] }
