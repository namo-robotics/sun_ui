using std;

/** Demonstrates controlled forms, weighted grid layout, themes, and named template slots. */
module forms {

  /** Owns form values and resolved themes independently of GTK widgets. */
  class State {
    var name: String;
    var enabled: bool = false;
    var selected: i64 = 0;
    var dark: bool = false;
    var light_style: ui.Style;
    var dark_style: ui.Style;
    var seen_alpha: bool = false;
    var seen_beta_after_alpha: bool = false;
    var edits: i64 = 0;

    /** Validates and resolves generated resources before opening the application. */
    init() SystemResult<void> {
      this.name = try String("");

      var dictionary = try resources();
      var light = try String("light");
      var dark = try String("dark");
      this.light_style = try dictionary.style(1, light);
      this.dark_style = try dictionary.style(1, dark);
    }
  }

  /** Explicitly copies the selected theme into one owned control description. */
  function theme(state: const ref State) AllocationResult<ui.Style> {
    var result = try ui.Style();
    if (state.dark) {
      try result.overlay(state.dark_style);
    } else {
      try result.overlay(state.light_style);
    }
    return AllocationResult.Ok(result);
  }

  /** Appends a handwritten child through a generated template's named slot. */
  function footer(view: ref ui.View, parent: i64) AllocationResult<void> {
    var label = try ui.Element(try ui.Key(try String("help")), ui.Kind.Label);
    label.text = try String("State and event handlers are ordinary Sun functions.");
    try view.append(parent, label);

    return AllocationResult.Ok;
  }

  /** Accepts edits through named actions and deliberately rejects one test value. */
  function handle(
    state: ref State,
    event: const ref ui.Event,
    queue: ref ui.EventQueue
  ) SystemResult<void> {
    var a = make_heap_allocator();
    if (event.action == 1 and event.value.kind == ui.ValueKind.Text) {
      state.edits += 1;
      if (event.value.text.equals_literal("alpha")) {
        state.seen_alpha = true;
      }
      if (event.value.text.equals_literal("beta") and state.seen_alpha) {
        state.seen_beta_after_alpha = true;
      }
      if (not event.value.text.equals_literal("reject")) {
        state.name = try event.value.text.clone(a);
      }
    } else if (event.action == 2 and event.value.kind == ui.ValueKind.Boolean) {
      state.enabled = event.value.boolean;
    } else if (event.action == 3 and event.value.kind == ui.ValueKind.Selection) {
      var high = try ui.Key(try String("high"));
      state.selected = event.value.selection.equals(high) ? 1 : 0;
    } else if (event.action == 4) {
      state.dark = not state.dark;
    }
    return SystemResult.Ok;
  }

  /** Resolves one editable control within its stable nested layout. */
  function control(tree: const ref ui.Tree, name: static_ptr<u8>) AllocationResult<u64> {
    var a = make_heap_allocator();
    var path = try Vec<ui.Key>(a, 4);
    try path.push(try ui.Key(try String("page")));
    try path.push(try ui.Key(try String("form")));
    try path.push(try ui.Key(try String("fields")));
    try path.push(try ui.Key(try String(name)));
    return AllocationResult.Ok(tree.identity_path(path));
  }

  /** Verifies native FIFO edits, controlled restoration, themes, and cleanup. */
  function acceptance(
    renderer: ref ui_gtk.Renderer,
    session: ref ui.Session<State>
  ) std.Result<void> {
    var name = try control(session.tree, "name");
    var enabled = try control(session.tree, "enabled");
    var choice = try control(session.tree, "choice");
    var text = try String("alpha");
    try renderer.edit(name, text, 0);
    text = try String("beta");
    try renderer.edit(name, text, 0);
    try renderer.poll(session.tree, session.queue, false);
    try session.dispatch(renderer);
    if (not session.state.name.equals_literal("beta") or not session.state.seen_beta_after_alpha) {
      return std.Result.Error(Error(1, "Text edits lost their captured FIFO values"));
    }
    text = try String("reject");
    try renderer.edit(name, text, 0);
    try renderer.poll(session.tree, session.queue, false);
    try session.dispatch(renderer);
    if (not session.state.name.equals_literal("beta")) {
      return std.Result.Error(Error(1, "Rejected edit changed state"));
    }
    var edits = session.state.edits;
    try renderer.poll(session.tree, session.queue, false);
    try session.dispatch(renderer);
    if (session.state.edits != edits) {
      return std.Result.Error(Error(1, "Programmatic text update emitted an edit"));
    }
    text = try String("");
    try renderer.edit(enabled, text, 1);
    try renderer.edit(choice, text, 1);
    try renderer.poll(session.tree, session.queue, false);
    try session.dispatch(renderer);
    if (not session.state.enabled or session.state.selected != 1) {
      return std.Result.Error(Error(1, "Typed checkbox or selection event was lost"));
    }
    var creates = renderer.creates;
    session.state.dark = true;
    try session.render(renderer);
    if (try control(session.tree, "name") != name or renderer.creates != creates) {
      return std.Result.Error(Error(1, "Theme update remounted controls"));
    }
    session.tree.shutdown(renderer);
    if (renderer.creates != renderer.removals) {
      return std.Result.Error(Error(1, "Form subscriptions survived shutdown"));
    }
    std.io.println("XML forms acceptance passed");
    return std.Result.Ok;
  }

  /** Runs the generated form using the normal state/session/event pipeline. */
  public function run(automated: bool) std.Result<void> {
    var state = try State();
    var title = try String("Sun XML forms");
    var renderer = try ui_gtk.Renderer(title);
    var session = try ui.Session<State>(state, view, handle);
    try session.render(renderer);
    if (automated) {
      return acceptance(renderer, session);
    }
    while (renderer.running()) {
      try renderer.poll(session.tree, session.queue, true);
      try session.dispatch(renderer);
    }
    session.tree.shutdown(renderer);
    return std.Result.Ok;
  }
}

/** Runs the interactive form or its native acceptance scenario. */
function main(argc: i32, argv: raw_ptr<raw_ptr<i8>>) AllocationResult<i32> {
  var a = make_heap_allocator();
  var env = try std.env.Env(a);
  var args = try env.args(argc, argv);
  return AllocationResult.Ok(
    match forms.run(args.size() == 2 and args[1].equals_literal("--self-test")) {
      std.Result.Ok => 0,
      (error: const ref IError) => {
        std.io.eprintln(try error.message());
        return AllocationResult.Ok(1);
      }
    }
  );
}
manifest {
  source_files: [
    "../../build/generated/examples/forms/forms.view.sun"
  ], libraries: [
    "stdlib.moon",
    "sun_ui.moon",
    "${namo-robotics/sun_gobject}/lib/sun_gobject.moon",
    "${namo-robotics/sun_gobject}/lib/sun_gtk.moon",
    "sun_ui_gtk.moon"
  ]
}
