using std;
using std.mem;

/** Writes the scientific example as a portable vector figure. */
function main(argc: i32, argv: raw_ptr<raw_ptr<i8>>) i32 throws {
  var a = make_heap_allocator();
  var env = std.env.Env(a);
  var args = env.args(argc, argv);
  var path = args.size() == 2 ? args[1].clone(a) : String("scientific-plot.svg");
  try {
    export_plot(path);
    return 0;
  } catch (error: std.Error) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.AllocationError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.InvalidArgumentError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.OverflowError) {
    std.io.eprintln(error.message());
    return 1;
  }
}

/** Writes an SVG to the requested path without requiring a graphical display. */
function export_plot(path: ref String) void throws {
  var figure = plot_example.figure();
  var drawing = figure.draw(1440.0, 1100.0);
  drawing.save(path);
  std.io.println(`Wrote ${path}`);
  return;
}

manifest {
  source_files: [
    "data.sun"
  ]
  libraries: [
    "sun/stdlib",
    "namo-robotics/sun_ui/sun_ui",
    "namo-robotics/sun_ui/sun_plot"
  ],
}
