using std;

/** Writes the scientific example as a portable vector figure. */
function main() i32 throws {
  try {
    export_plot();
    return 0;
  } catch (error: std.Error) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.AllocationError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.InvalidArgumentError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.OverflowError) {
    std.io.eprintln(error.message());
    return 1;
  }
}

/** Generates an SVG in the build directory without requiring a graphical display. */
function export_plot() void throws {
  var figure = plot_example.figure();
  var drawing = figure.draw(1440.0, 1100.0);
  var path = String("build/scientific-plot.svg");
  drawing.save(path);
  std.io.println("Wrote build/scientific-plot.svg");
  return;
}

manifest {
  libraries: [
    "stdlib.moon",
    "sun_ui.moon",
    "sun_plot.moon"
  ], source_files: [
    "data.sun"
  ]
}
