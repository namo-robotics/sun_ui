using std;

/** Writes the scientific example as a portable vector figure. */
function main() AllocationResult<i32> {
  return AllocationResult.Ok(
    match export_plot() {
      SystemResult.Ok => 0,
      SystemResult.Error(error) => {
        std.io.eprintln(try error.message());
        return AllocationResult.Ok(1);
      }
    }
  );
}

/** Generates an SVG in the build directory without requiring a graphical display. */
function export_plot() SystemResult<void> {
  var figure = try plot_example.figure();
  var drawing = try figure.draw(1440.0, 1100.0);
  var path = try String("build/scientific-plot.svg");
  try drawing.save(path);
  std.io.println("Wrote build/scientific-plot.svg");
  return SystemResult.Ok;
}

manifest {
  libraries: [
    "stdlib.moon",
    "sun_ui.moon",
    "sun_plot.moon"
  ], source_files: [
    "data.sun"
  ]
}
