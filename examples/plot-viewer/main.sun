using std;

/** Waits for a successful paint with a bounded deadline. */
function await_frame(window: ref ui_gtk_drawing.Window) void throws {
  for (var i: i64 = 0; i < 200; i += 1) {
    window.poll(false);
    if (window.rendered()) {
      return;
    }
    std.time.sleep(std.time.create_duration_millis(10));
  }
  throw Error(1, "GTK did not render the vector document");
}

/** Displays a vector figure or exercises native rendering, replacement, resize, and cleanup. */
function run(automated: bool) void throws {
  var figure = plot_example.figure();
  var drawing = figure.draw(1440.0, 1100.0);
  var title = String("Sun Plot — Damped oscillator study");
  var window = ui_gtk_drawing.Window(title, drawing);
  if (automated) {
    await_frame(window);
    figure.title = String("Updated damping study");
    var updated = figure.draw(1280.0, 1000.0);
    window.update(updated);
    window.resize(1280, 1000);
    await_frame(window);
    var export_path = String("build/plot_viewer-export.svg");
    window.export_svg(export_path);
    var allocator = make_heap_allocator();
    var exported = std.io.read_to_string(allocator, export_path);
    var expected = updated.svg();
    if (exported.equals(expected) == false) {
      throw Error(1, "Export did not save the current drawing");
    }
    var invalid_path = String("build");

    var operation_completed_1 = false;
    try {
      window.export_svg(invalid_path);
      operation_completed_1 = true;
      throw Error(1, "Export to a directory unexpectedly succeeded");
    } catch (error: std.Error) {
      if (operation_completed_1) {
        throw;
      }
    }

    window.export_svg(export_path);
    if (window.running() == false) {
      throw Error(1, "Drawing window closed unexpectedly");
    }
    std.io.println("Plot GTK acceptance passed");
    return;
  }
  while (window.running()) {
    window.poll(true);
  }
  return;
}

/** Selects the interactive viewer or its bounded native acceptance scenario. */
function main(argc: i32, argv: raw_ptr<raw_ptr<i8>>) i32 throws {
  var a = make_heap_allocator();
  var env = std.env.Env(a);
  var args = env.args(argc, argv);
  try {
    run(args.size() == 2 and args[1].equals_literal("--self-test"));
    return 0;
  } catch (error: std.Error) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.AllocationError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.InvalidArgumentError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.OverflowError) {
    std.io.eprintln(error.message());
    return 1;
  }
}
manifest {
  libraries: [
    "stdlib.moon",
    "sun_ui.moon",
    "sun_plot.moon",
    "${namo-robotics/sun_gobject}/lib/sun_gobject.moon",
    "${namo-robotics/sun_gobject}/lib/sun_gtk.moon",
    "sun_ui_gtk_drawing.moon"
  ], source_files: [
    "../plot-export/data.sun"
  ]
}
