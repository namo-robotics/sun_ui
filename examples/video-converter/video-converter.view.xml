<Views module="video_app">
  <Resources name="resources">
    <Style name="panel"><Normal background="0x152135" radius="0" padding="18" /></Style>
    <Style name="muted"><Normal foreground="0x91a3bc" fontSize="12" /></Style>
    <Style name="title"><Normal foreground="0xf4f8ff" fontSize="28" /></Style>
    <Style name="section"><Normal foreground="0x73e2cb" fontSize="12" /></Style>
    <Style name="field"><Normal foreground="0xeaf2ff" background="0x23334b" borderWidth="0" radius="0" padding="8" /><Disabled foreground="0x6c8098" /></Style>
    <Style name="primary"><Normal foreground="0x082b2a" background="0x73e2cb" fontSize="15" borderWidth="0" radius="0" padding="10" /><Disabled foreground="0x476b70" /></Style>
    <Style name="secondary"><Normal foreground="0xeaf2ff" background="0x293d55" borderWidth="0" radius="0" padding="8" /><Disabled foreground="0x6c8098" /></Style>
  </Resources>
  <View name="view" state="State" resources="{resources()}" theme="{theme()}">
    <Scroll expandX="true" expandY="true" background="0x0b1220">
      <Column margin="24" spacing="20" expandY="true">
        <Row spacing="16">
          <Column spacing="4" expandX="true">
            <Label text="Video studio" styleResource="title" horizontal="Start" />
            <Label text="A lighter file. Just the part you want." styleResource="muted" horizontal="Start" />
          </Column>
          <Button text="Open video…" action="13" enabled="{state.job.mode == 0}" styleResource="primary" width="145" />
        </Row>
        <Grid spacing="24" expandX="true" expandY="true">
          <Grid.Columns><Track kind="Weight" value="3" /><Track kind="Fixed" value="300" /></Grid.Columns>
          <Grid.Rows><Track kind="Weight" value="1" /></Grid.Rows>
          <Column column="0" spacing="12" expandX="true" expandY="true" styleResource="panel">
            <Label text="01   SOURCE &amp; PREVIEW" styleResource="section" horizontal="Start" />
            <Label text="{source_name(state)}" horizontal="Start" />
            <Label text="{metadata(state)}" styleResource="muted" horizontal="Start" />
            <Video text="{preview_source(state)}" duration="{duration_us(state)}" trimStart="{start_us(state)}" trimEnd="{end_us(state)}" position="{state.position}" changeAction="15" enabled="{state.job.mode == 0}" spacing="12" expandX="true" expandY="true" />
            <Row spacing="12">
              <Label text="02   TRIM YOUR CLIP" styleResource="section" horizontal="Start" expandX="true" />
              <Button text="Reset trim" action="16" enabled="{state.job.ready and state.job.mode == 0}" styleResource="secondary" />
            </Row>
            <Label text="Drag the mint handles to keep a section. Click the track to seek." styleResource="muted" horizontal="Start" />
            <Grid spacing="8" expandX="true">
              <Grid.Columns><Track kind="Weight" value="1" /><Track kind="Weight" value="1" /></Grid.Columns>
              <Grid.Rows><Track kind="Auto" /><Track kind="Auto" /></Grid.Rows>
              <Label text="Start time" horizontal="Start" styleResource="muted" />
              <Label column="1" text="End time" horizontal="Start" styleResource="muted" />
              <TextInput row="1" value="{state.settings.start.clone(a)}" changeAction="3" enabled="{state.job.ready and state.job.mode == 0}" styleResource="field" expandX="true" />
              <TextInput row="1" column="1" value="{state.settings.end.clone(a)}" changeAction="4" enabled="{state.job.ready and state.job.mode == 0}" styleResource="field" expandX="true" />
            </Grid>
            <Label text="{selection_summary(state)}" foreground="0x73e2cb" horizontal="Start" />
          </Column>
          <Column column="1" spacing="12" expandY="true" styleResource="panel">
            <Label text="03   EXPORT SETTINGS" styleResource="section" horizontal="Start" />
            <Label text="Format" horizontal="Start" />
            <Select selected="{state.settings.format}" changeAction="5" enabled="{state.job.mode == 0}" styleResource="field">
              <Select.Options><Option key="{0}" text="MP4 · widely compatible" /><Option key="{1}" text="MOV · QuickTime" /></Select.Options>
            </Select>
            <Label text="Quality &amp; compression" horizontal="Start" />
            <Select selected="{state.settings.quality}" changeAction="6" enabled="{state.job.mode == 0}" styleResource="field">
              <Select.Options><Option key="{0}" text="High quality" /><Option key="{1}" text="Balanced · recommended" /><Option key="{2}" text="Smaller file" /></Select.Options>
            </Select>
            <Label text="Maximum resolution" horizontal="Start" />
            <Select selected="{state.settings.resolution}" changeAction="7" enabled="{state.job.mode == 0}" styleResource="field">
              <Select.Options><Option key="{0}" text="Keep original" /><Option key="{1}" text="Fit within 1080 px" /><Option key="{2}" text="Fit within 720 px" /></Select.Options>
            </Select>
            <Checkbox text="Keep audio" checked="{state.settings.audio}" changeAction="8" enabled="{state.job.mode == 0}" />
            <Label text="Save as" horizontal="Start" />
            <TextInput value="{state.settings.output.clone(a)}" changeAction="2" enabled="{state.job.mode == 0}" styleResource="field" />
            <Button text="Choose destination…" action="14" enabled="{state.job.mode == 0}" styleResource="secondary" />
            <Checkbox text="Replace existing output" checked="{state.settings.overwrite}" changeAction="9" enabled="{state.job.mode == 0}" />
            <Button text="Export video" action="11" enabled="{state.job.mode == 0 and state.job.ready}" height="48" styleResource="primary" />
            <Button text="Cancel export" action="12" visible="{state.job.mode != 0}" enabled="{state.job.mode != 0}" styleResource="secondary" />
            <Label text="{progress_label(state)}" foreground="0x73e2cb" horizontal="Start" />
            <Label text="Your original stays untouched." styleResource="muted" horizontal="Start" />
          </Column>
        </Grid>
        <Label text="{status_text(state)}" styleResource="muted" horizontal="Start" />
      </Column>
    </Scroll>
  </View>
</Views>
