using std;

/** Demonstrates shared scene settings with independent embedded and FPS cameras. */
module graphics_demo {

  /** Evaluates camera yaw for movement in world coordinates. */
  extern "C" function sin(value: f64) f64;

  /** Evaluates camera yaw for forward movement. */
  extern "C" function cos(value: f64) f64;

  /** Owns scene settings changed through ordinary GTK controls. */
  class Settings {
    public var blue: bool = false;
    public var animated: bool = true;

    /** Starts with a rotating warm-colored cube. */
    init() {}
  }

  /** Describes ordinary controls surrounding the registered viewport. */
  function view(state: const ref Settings) ui.View throws {
    var v = ui.View(make_heap_allocator());
    v.button(1, String(state.blue ? "Use warm color" : "Use blue color"), 1, 0);
    v.button(2, String(state.animated ? "Pause rotation" : "Resume rotation"), 2, 0);
    var e = ui.Element(ui.Key(3), ui.Kind.Viewport);
    e.viewport_id = 1;
    e.min_width = 480;
    e.min_height = 320;
    e.expand_x = true;
    e.expand_y = true;
    v.append(-1, e);
    return v;
  }

  /** Applies UI actions without touching GPU resources or camera state. */
  function handle(
    state: ref Settings,
    event: const ref ui.Event,
    queue: ref ui.EventQueue
  ) void throws {
    if (event.action == 1) {
      state.blue = not state.blue;
    }
    if (event.action == 2) {
      state.animated = not state.animated;
    }
    return;
  }

  /** Owns one camera and its held input state. */
  class Camera {
    public var x: f64 = 0.0;
    public var z: f64 = 6.0;
    public var yaw: f64 = 0.0;
    public var pitch: f64 = 0.0;
    var forward: bool = false;
    var backward: bool = false;
    var left: bool = false;
    var right: bool = false;
    var dragging: bool = false;
    var last_x: f64 = 0.0;
    var last_y: f64 = 0.0;

    /** Starts facing the scene from in front of the cube. */
    init() {}

    /** Consumes bounded input and advances movement independently of UI reconciliation. */
    public method update(surface: ref gpu.Surface, dt: f64) void {
      for (var i: i64 = 0; i < 64; i += 1) {
        match surface.next() {
          Option.None => {
            break;
          },
          Option.Some(e) => {
            if (e.kind == gpu.InputKind.Focus and e.code == 0) {
              this.forward = false;
              this.backward = false;
              this.left = false;
              this.right = false;
              this.dragging = false;
            }
            if (e.kind == gpu.InputKind.Button) {
              if (e.code == 1) {
                this.dragging = true;
                this.last_x = e.x;
                this.last_y = e.y;
              }
              if (e.code == -1) {
                this.dragging = false;
              }
            }
            if (e.kind == gpu.InputKind.Relative) {
              this.yaw += e.x * 0.004;
              this.pitch += e.y * 0.004;
            }
            if (e.kind == gpu.InputKind.Move) {
              if (this.dragging) {
                this.yaw += (e.x - this.last_x) * 0.004;
                this.pitch += (e.y - this.last_y) * 0.004;
              }
              this.last_x = e.x;
              this.last_y = e.y;
            }
            if (e.kind == gpu.InputKind.Key) {
              var down = e.x != 0.0;
              if (e.code == 119) {
                this.forward = down;
              }
              if (e.code == 115) {
                this.backward = down;
              }
              if (e.code == 97) {
                this.left = down;
              }
              if (e.code == 100) {
                this.right = down;
              }
            }
            if (e.kind == gpu.InputKind.Scroll) {
              this.z += e.y * 0.2;
            }
          }
        };
      }
      if (this.pitch > 1.4) {
        this.pitch = 1.4;
      }
      if (this.pitch < -1.4) {
        this.pitch = -1.4;
      }
      var forward = (this.forward ? 1.0 : 0.0) - (this.backward ? 1.0 : 0.0);
      var side = (this.right ? 1.0 : 0.0) - (this.left ? 1.0 : 0.0);
      var s = unsafe { sin(this.yaw); };
      var c = unsafe { cos(this.yaw); };
      this.x += (forward * s + side * c) * dt * 3.0;
      this.z += (-forward * c + side * s) * dt * 3.0;
    }
  }

  /** Appends one XYZ position into an explicitly allocated mesh builder. */
  function point(v: ref Vec<f64>, x: f64, y: f64, z: f64) void throws {
    v.push(x);
    v.push(y);
    v.push(z);

    return;
  }

  /** Builds immutable indexed cube geometry. */
  function cube() gpu.Mesh throws {
    var a = make_heap_allocator();
    var v = Vec<f64>(a, 24);
    var indices = Vec<i64>(a, 36);
    point(v, -1.0, -1.0, -1.0);
    point(v, 1.0, -1.0, -1.0);
    point(v, 1.0, 1.0, -1.0);
    point(v, -1.0, 1.0, -1.0);
    point(v, -1.0, -1.0, 1.0);
    point(v, 1.0, -1.0, 1.0);
    point(v, 1.0, 1.0, 1.0);
    point(v, -1.0, 1.0, 1.0);
    indices.push(0);
    indices.push(1);
    indices.push(2);
    indices.push(0);
    indices.push(2);
    indices.push(3);
    indices.push(4);
    indices.push(6);
    indices.push(5);
    indices.push(4);
    indices.push(7);
    indices.push(6);
    indices.push(0);
    indices.push(4);
    indices.push(5);
    indices.push(0);
    indices.push(5);
    indices.push(1);
    indices.push(3);
    indices.push(2);
    indices.push(6);
    indices.push(3);
    indices.push(6);
    indices.push(7);
    indices.push(0);
    indices.push(3);
    indices.push(7);
    indices.push(0);
    indices.push(7);
    indices.push(4);
    indices.push(1);
    indices.push(5);
    indices.push(6);
    indices.push(1);
    indices.push(6);
    indices.push(2);
    return gpu.Mesh(v, indices);
  }

  /** Builds a ground grid to make camera translation and perspective visible. */
  function grid() gpu.Mesh throws {
    var a = make_heap_allocator();
    var v = Vec<f64>(a, 252);
    var indices = Vec<i64>(a, 0);
    for (var i: i32 = -10; i <= 10; i += 1) {
      var t = _convert<f64>(i);
      point(v, t, -1.1, -10.0);
      point(v, t, -1.1, 10.0);
      point(v, -10.0, -1.1, t);
      point(v, 10.0, -1.1, t);
    }
    return gpu.Mesh(v, indices);
  }

  /** Copies one uniform vector into a packet. */
  function uniform4(
    frame: ref gpu.Frame,
    name: static_ptr<u8>,
    x: f64,
    y: f64,
    z: f64,
    w: f64
  ) void throws {
    var v = Vec<f64>(make_heap_allocator(), 4);
    v.push(x);
    v.push(y);
    v.push(z);
    v.push(w);
    var key = String(name);
    return frame.uniform(key, v);
  }

  /** Describes a camera-specific frame using shared immutable geometry and shaders. */
  function frame(
    camera: const ref Camera,
    settings: const ref Settings,
    angle: f64,
    aspect: f64,
    cube_mesh: const ref gpu.Mesh,
    grid_mesh: const ref gpu.Mesh,
    shader: const ref gpu.Shader
  ) gpu.Frame throws {
    var f = gpu.Frame(0.035, 0.045, 0.07, 1.0);
    f.draw(cube_mesh, shader, gpu.Primitive.Triangles, true, false);
    uniform4(f, "camera", _convert<f64>(camera.x), 0.6, _convert<f64>(camera.z), aspect);
    uniform4(
      f,
      "rotation",
      _convert<f64>(camera.yaw),
      _convert<f64>(camera.pitch),
      _convert<f64>(angle),
      0.0
    );
    uniform4(
      f,
      "color",
      settings.blue ? 0.15 : 0.95,
      settings.blue ? 0.55 : 0.4,
      settings.blue ? 0.95 : 0.15,
      1.0
    );
    f.draw(grid_mesh, shader, gpu.Primitive.Lines, true, false);
    uniform4(f, "camera", _convert<f64>(camera.x), 0.6, _convert<f64>(camera.z), aspect);
    uniform4(f, "rotation", _convert<f64>(camera.yaw), _convert<f64>(camera.pitch), 0.0, 0.0);
    uniform4(f, "color", 0.3, 0.35, 0.45, 1.0);
    return f;
  }

  /** Uses the last physical framebuffer size, with a sensible initial aspect ratio. */
  function aspect(surface: const ref gpu.Surface) f64 {
    var h = surface.extent(false);
    return h > 0 ? _convert<f64>(surface.extent(true)) / _convert<f64>(h) : 1.5;
  }

  /** Runs both hosts with one bounded main-thread loop and independent cameras. */
  public function run() void throws {
    var title = String("Sun UI graphics — drag to look");
    var renderer = ui_gtk.Renderer(title);
    var viewport = gpu_gtk.Viewport();
    renderer.register_viewport(1, viewport.widget());
    var session = ui.Session<Settings>(Settings(), view, handle);
    session.render(renderer);
    gtk.clear_gl_context();
    var game_title = String("Sun graphics — click to capture, WASD, Escape to release");
    var window = gpu_sdl.Window(game_title, 900, 600);
    var embedded_state = viewport.surface();
    var fps_state = window.surface();
    var embedded = Camera();
    var fps = Camera();
    var cube_mesh = cube();
    var grid_mesh = grid();
    var vertex = String(
      "#version 330 core\nlayout(location=0) in vec3 position; uniform vec4 camera; uniform vec4 rotation; out float shade; void main(){vec3 p=position; float a=rotation.z; p.xz=mat2(cos(a),-sin(a),sin(a),cos(a))*p.xz; shade=0.65+0.25*clamp(p.y,-1.,1.); p-=camera.xyz; a=rotation.x; p.xz=mat2(cos(a),-sin(a),sin(a),cos(a))*p.xz; a=-rotation.y; p.yz=mat2(cos(a),-sin(a),sin(a),cos(a))*p.yz; gl_Position=vec4(p.x*1.7/camera.w,p.y*1.7,-1.002*p.z-0.2002,-p.z);}"
    );
    var fragment = String(
      "#version 330 core\nuniform vec4 color; in float shade; out vec4 result; void main(){result=vec4(color.rgb*shade,color.a);}"
    );
    var shader = gpu.Shader(vertex, fragment);
    var previous = gpu_sdl.time();
    var angle: f64 = 0.0;
    while (renderer.running() or window.running()) {
      if (renderer.running()) {
        renderer.poll(session.tree, session.queue, false);
        session.dispatch(renderer);
      }
      gtk.clear_gl_context();
      gpu_sdl.poll();
      var now = gpu_sdl.time();
      var dt = now - previous;
      previous = now;
      if (dt > 0.05) {
        dt = 0.05;
      }
      if (session.state.animated) {
        angle += dt * 0.6;
      }
      embedded.update(embedded_state, dt);
      fps.update(fps_state, dt);
      if (renderer.running()) {
        var f = frame(
          embedded,
          session.state,
          angle,
          aspect(viewport.surface()),
          cube_mesh,
          grid_mesh,
          shader
        );
        viewport.submit(f);
        var error = viewport.error();
        if (not error.is_empty()) {
          throw Error(1, error);
        }
      }
      if (window.running()) {
        var f = frame(
          fps,
          session.state,
          angle,
          aspect(window.surface()),
          cube_mesh,
          grid_mesh,
          shader
        );
        window.submit(f);
        window.render();
        var error = window.error();
        if (not error.is_empty()) {
          throw Error(1, error);
        }
      }
      gpu_sdl.delay(8);
    }
    session.tree.shutdown(renderer);
    return;
  }
}

/** Reports graphics initialization or rendering failures without hiding unsupported hosts. */
function main() i32 throws {
  try {
    graphics_demo.run();
    return 0;
  } catch (error: std.Error) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.AllocationError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.InvalidArgumentError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.OverflowError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.IndexOutOfBoundsError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.NotFoundError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.EmptyError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.IOError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.ConversionError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.DivisionByZeroError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.ArithmeticError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.json.JsonError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.xml.XmlError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.ProtoDecodeError) {
    std.io.eprintln(error.message());
    return 1;
  }
}
manifest {
  libraries:[
    "stdlib.moon",
    "sun_ui.moon",
    "sun_ui_gtk.moon",
    "${namo-robotics/sun_gobject}/lib/sun_gobject.moon",
    "${namo-robotics/sun_gobject}/lib/sun_gtk.moon",
    "sun_ui_graphics.moon",
    "sun_ui_graphics_gtk.moon",
    "sun_ui_sdl.moon"
  ]
}
