using std;

/** Exercises independent vector ownership and keyed reconciliation in a single window. */
module drawing_controls {

  /** Describes a drawing leaf beside an ordinary control. */
  function view(id: const ref i64) AllocationResult<ui.View> {
    var a = make_heap_allocator();
    var v = try ui.View(a);
    v.button(1, try String("Drawing surface"), 1, 0);
    var e = try ui.Element(try ui.Key(2), ui.Kind.Drawing);
    e.drawing_id = id;
    e.min_width = 400;
    e.min_height = 300;
    try v.append(-1, e);
    return AllocationResult.Ok(v);
  }

  /** Leaves the example state unchanged when its illustrative button is clicked. */
  function handle(
    id: ref i64,
    event: const ref ui.Event,
    queue: ref ui.EventQueue
  ) SystemResult<void> {
    return SystemResult.Ok;
  }

  /** Paints a document after its temporary SVG owner leaves scope. */
  function update(area: ref gtk.DrawingArea, text: static_ptr<u8>) SystemResult<void> {
    var d = try ui_drawing.Drawing(400.0, 300.0);
    d.text(30.0, 50.0, try String(text), 24.0, false, 0.0);
    var content = try d.svg();
    var document = try svg.Document(content);
    area.set_document(document);
    return SystemResult.Ok;
  }

  /** Waits for a native frame with a bounded deadline. */
  function paint(
    renderer: ref ui_gtk.Renderer,
    session: ref ui.Session<i64>,
    area: const ref gtk.DrawingArea
  ) SystemResult<void> {
    for (var i: i64 = 0; i < 200; i += 1) {
      renderer.poll(session.tree, session.queue, false);
      try session.dispatch(renderer);
      if (area.rendered()) {
        return SystemResult.Ok;
      }
      std.time.sleep(std.time.create_duration_millis(10));
    }
    return SystemResult.Error(Error(1, "Embedded drawing did not paint"));
  }

  /** Validates registrations, replacements, retention, redraw, and mounted cleanup rules. */
  public function run() SystemResult<void> {
    var title = try String("Embedded drawings");
    var renderer = try ui_gtk.Renderer(title);
    var first = try gtk.DrawingArea();
    var second = try gtk.DrawingArea();
    try update(first, "First drawing");
    try update(second, "Second drawing");
    try renderer.register_drawing(1, gtk.DrawingArea(first));
    match renderer.register_drawing(2, gtk.DrawingArea(first)) {
      SystemResult.Error(_) => {},
      SystemResult.Ok => {
        return SystemResult.Error(Error(1, "Duplicate surface accepted"));
      }
    };
    match renderer.register_drawing(1, gtk.DrawingArea(second)) {
      SystemResult.Error(_) => {},
      SystemResult.Ok => {
        return SystemResult.Error(Error(1, "Duplicate identifier accepted"));
      }
    };
    try renderer.register_drawing(2, gtk.DrawingArea(second));
    var session = ui.Session<i64>(1, view, handle);
    try session.render(renderer);
    try paint(renderer, session, first);
    var identity = session.tree.identity(2);
    match renderer.unregister_drawing(1) {
      SystemResult.Error(_) => {},
      SystemResult.Ok => {
        return SystemResult.Error(Error(1, "Mounted surface released"));
      }
    };
    session.state = 2;
    try session.render(renderer);
    try paint(renderer, session, second);
    if (session.tree.identity(2) != identity) {
      return SystemResult.Error(Error(1, "Replacement changed keyed identity"));
    }
    try renderer.unregister_drawing(1);
    try update(second, "Updated drawing");
    try paint(renderer, session, second);
    var retained = try renderer.drawing(2);
    if (not retained.same(second)) {
      return SystemResult.Error(Error(1, "Retained surface changed identity"));
    }
    session.tree.shutdown(renderer);
    try renderer.unregister_drawing(2);
    if (renderer.creates != renderer.removals) {
      return SystemResult.Error(Error(1, "Mounted controls leaked"));
    }
    std.io.println("Drawing controls acceptance passed");
    return SystemResult.Ok;
  }
}

/** Runs the bounded drawing integration scenario. */
function main() AllocationResult<i32> {
  return AllocationResult.Ok(
    match drawing_controls.run() {
      SystemResult.Ok => 0,
      SystemResult.Error(error) => {
        std.io.eprintln(try error.message());
        return AllocationResult.Ok(1);
      }
    }
  );
}
manifest {
  libraries: [
    "stdlib.moon",
    "sun_ui.moon",
    "${namo-robotics/sun_gobject}/lib/sun_gobject.moon",
    "${namo-robotics/sun_gobject}/lib/sun_gtk.moon",
    "sun_ui_gtk.moon"
  ]
}
