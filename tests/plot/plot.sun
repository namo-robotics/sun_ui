using std;

/** Verifies numerical layout and safe vector output without GTK. */
module plot_tests {

  /** Places four independent figures in distinct viewports without losing their labels. */
  test_function subplot_grid_composes_panels() {
    var grid = plot.Grid(
      2,
      2,
      String("Study & results"),
      String("Four panels")
    );
    for (var i: i64 = 0; i < 4; i += 1) {
      var figure = plot.Figure(
        `Panel ${i}`,
        String("x"),
        String("y")
      );
      grid.add(figure.draw(684.0, 471.0));
    }
    var drawing = grid.draw(1440.0, 1100.0);
    var svg = drawing.svg();
    std.test.assert(svg.contains("Study &amp; results"));
    std.test.assert(svg.contains("Panel 0"));
    std.test.assert(svg.contains("Panel 3"));
    std.test.assert(svg.contains("<svg x=\"24\" y=\"110\""));
    std.test.assert(svg.contains("<svg x=\"732\" y=\"605\""));
    std.test.assert_eq(drawing.width, 1440.0);
    var small = grid.draw(1280.0, 1000.0);
    std.test.assert_eq(small.height, 1000.0);
    return;
  }

  /** Rejects missing panels, invalid dimensions, and cells too small for readable axes. */
  test_function subplot_grid_rejects_invalid_layout() {
    var grid = plot.Grid(
      1,
      1,
      String("Study"),
      String("")
    );

    var operation_completed_8 = false;
    try {
      grid.draw(800.0, 600.0);
      operation_completed_8 = true;
      std.test.assert(false);
    } catch (error: std.Error) {
      if (operation_completed_8) {
        throw;
      }
    }

    var figure = plot.Figure(
      String("Panel"),
      String("x"),
      String("y")
    );
    grid.add(figure.draw(400.0, 300.0));

    var operation_completed_7 = false;
    try {
      grid.draw(400.0, 300.0);
      operation_completed_7 = true;
      std.test.assert(false);
    } catch (error: std.Error) {
      if (operation_completed_7) {
        throw;
      }
    }

    var invalid = plot.Grid(
      0,
      2,
      String("Study"),
      String("")
    );

    var operation_completed_6 = false;
    try {
      invalid.draw(1440.0, 1100.0);
      operation_completed_6 = true;
      std.test.assert(false);
    } catch (error: std.Error) {
      if (operation_completed_6) {
        throw;
      }
    }

    return;
  }

  /** Checks ordinary and reversed output transforms at interval boundaries. */
  test_function coordinate_mapping() {
    var limits = plot.Limits(-2.0, 2.0);
    std.test.assert(limits.valid());
    std.test.assert_eq(limits.map(-2.0, 100.0, 500.0), 100.0);
    std.test.assert_eq(limits.map(0.0, 100.0, 500.0), 300.0);
    std.test.assert_eq(limits.map(2.0, 500.0, 100.0), 100.0);
    return;
  }

  /** Checks readable tick increments across small and large scales. */
  test_function tick_intervals_and_labels() {
    std.test.assert_eq(plot.tick_step(10.0), 2.0);
    std.test.assert_eq(plot.tick_step(23.0), 5.0);
    std.test.assert_eq(plot.tick_step(0.01), 0.002);
    var zero = plot.tick_label(-1e-16, 0.2);
    var small = plot.tick_label(0.000002, 0.000001);
    var large = plot.tick_label(2000000.0, 1000000.0);
    var offset = plot.tick_label(1000000.2, 0.2);
    std.test.assert(zero.equals_literal("0"));
    std.test.assert(small.equals_literal("2e-6"));
    std.test.assert(large.equals_literal("2e6"));
    std.test.assert(offset.equals_literal("1.0000002e6"));
    return;
  }

  /** Verifies deterministic limits for empty and constant samples. */
  test_function empty_and_constant_ranges() {
    var figure = plot.Figure(
      String("Empty"),
      String("x"),
      String("y")
    );
    var empty = figure.bounds(true);
    std.test.assert_eq(empty.min, 0.0);
    std.test.assert_eq(empty.max, 1.0);
    var series = plot.Series(
      String("Constant"),
      String("blue"),
      false
    );
    series.add(4.0, -3.0);
    figure.add(series);
    var x = figure.bounds(true);
    var y = figure.bounds(false);
    std.test.assert(x.min < 4.0 and x.max > 4.0);
    std.test.assert(y.min < -3.0 and y.max > -3.0);
    var drawing = figure.draw(640.0, 480.0);
    std.test.assert_eq(drawing.width, 640.0);
    return;
  }

  /** Rejects unusable ranges and dimensions before producing a drawing. */
  test_function invalid_layout_is_rejected() {
    var figure = plot.Figure(
      String("Invalid"),
      String("x"),
      String("y")
    );

    var operation_completed_5 = false;
    try {
      figure.draw(0.0, 480.0);
      operation_completed_5 = true;
      std.test.assert(false);
    } catch (error: std.Error) {
      if (operation_completed_5) {
        throw;
      }
    }

    figure.x_limits = Option.Some(plot.Limits(1.0, 1.0));

    var operation_completed_4 = false;
    try {
      figure.draw(640.0, 480.0);
      operation_completed_4 = true;
      std.test.assert(false);
    } catch (error: std.Error) {
      if (operation_completed_4) {
        throw;
      }
    }

    figure.x_limits = Option.Some(plot.Limits(2.0, -2.0));

    var operation_completed_3 = false;
    try {
      figure.draw(640.0, 480.0);
      operation_completed_3 = true;
      std.test.assert(false);
    } catch (error: std.Error) {
      if (operation_completed_3) {
        throw;
      }
    }

    return;
  }

  /** Ensures user labels cannot become markup or escape XML attributes. */
  test_function xml_text_is_escaped() {
    var text = String("A & B <tag> \"quoted\" 'single'");
    var escaped = ui_drawing.escape(text);
    std.test.assert(
      escaped.equals_literal("A &amp; B &lt;tag&gt; &quot;quoted&quot; &apos;single&apos;")
    );
    return;
  }

  /** Non-finite paired samples neither affect limits nor connect unrelated line segments. */
  test_function nonfinite_samples_break_lines() {
    var huge = F64_MAX;
    var infinity = huge + huge;
    var nan = infinity - infinity;
    std.test.assert(plot.finite(infinity) == false);
    std.test.assert(plot.finite(nan) == false);
    std.test.assert_eq(plot.tick_step(infinity), 0.0);
    var figure = plot.Figure(
      String("Gaps"),
      String("x"),
      String("y")
    );
    var series = plot.Series(
      String(""),
      String("#123456"),
      false
    );
    series.add(0.0, 0.0);
    series.add(999.0, nan);
    series.add(1.0, 1.0);
    figure.add(series);
    var bounds = figure.bounds(true);
    std.test.assert_eq(bounds.max, 1.0);
    var drawing = figure.draw(640.0, 480.0);
    var svg = drawing.svg();
    std.test.assert(svg.contains("stroke=\"#123456\"") == false);
    return;
  }

  /** Explicit limits are honored and data marks are enclosed in an SVG clipping viewport. */
  test_function scatter_export_and_explicit_limits() {
    var figure = plot.Figure(
      String("A & B"),
      String("x < y"),
      String("µm")
    );
    figure.x_limits = Option.Some(plot.Limits(0.0, 10.0));
    figure.y_limits = Option.Some(plot.Limits(0.0, 10.0));
    var series = plot.Series(
      String(""),
      String("#123456"),
      true
    );
    series.add(5.0, 5.0);
    series.add(50.0, 50.0);
    figure.add(series);
    var drawing = figure.draw(640.0, 480.0);
    var svg = drawing.svg();
    std.test.assert(svg.contains("<circle cx=\"354\" cy=\"232\""));
    std.test.assert(svg.contains("overflow=\"hidden\""));
    std.test.assert(svg.contains("A &amp; B"));
    std.test.assert(svg.contains("x &lt; y"));
    std.test.assert(svg.contains("µm"));
    return;
  }

  /** Rejects invalid styles and overflowing data bounds rather than exporting invalid geometry. */
  test_function invalid_styles_and_extreme_ranges() {
    var figure = plot.Figure(
      String("Invalid"),
      String("x"),
      String("y")
    );
    var series = plot.Series(
      String(""),
      String("blue"),
      false
    );
    series.line_width = -1.0;
    figure.add(series);

    var operation_completed_2 = false;
    try {
      figure.draw(640.0, 480.0);
      operation_completed_2 = true;
      std.test.assert(false);
    } catch (error: std.Error) {
      if (operation_completed_2) {
        throw;
      }
    }

    figure.series[0].line_width = 2.0;
    figure.x_limits = Option.Some(plot.Limits(0.0 - F64_MAX, F64_MAX));

    var operation_completed_1 = false;
    try {
      figure.draw(640.0, 480.0);
      operation_completed_1 = true;
      std.test.assert(false);
    } catch (error: std.Error) {
      if (operation_completed_1) {
        throw;
      }
    }

    return;
  }
}
