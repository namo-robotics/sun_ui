using std;

/** Checks generation and diagnostics through the compiler's owned-input interface. */
module markup_tests {

  /** Compiles a minimal view and retains a deterministic original source mapping. */
  test_function generates_owned_view() {
    var compiler = markup.Compiler(
      String("counter.view.xml"),
      String(
        "<Views module=\"counter\"><View name=\"view\" state=\"i64\"><Button key=\"{1}\" text=\"A &amp; B\" action=\"1\"/></View></Views>"
      )
    );
    compiler.compile();
    std.test.assert(compiler.output.contains("ui.Key(1)"), "numeric key stays numeric");
    std.test.assert(
      compiler.output.contains("String(\"A & B\")"),
      "XML entities are decoded once"
    );
    std.test.assert(
      compiler.output.contains("state: const ref i64"),
      "state is borrowed only during construction"
    );
    std.test.assert(compiler.source_map.contains("\t"), "generated lines map to source bytes");
  }

  /** Generates typed media fields and a captured edit action from XML. */
  test_function video_range_properties() {
    var compiler = markup.Compiler(
      String("video.view.xml"),
      String(
        "<Views module=\"app\"><View name=\"view\" state=\"State\"><Video key=\"preview\" text=\"{state.path.clone(a)}\" duration=\"4000000\" frameRateNum=\"30000\" frameRateDen=\"1001\" trimStart=\"500000\" trimEnd=\"2000000\" position=\"1000000\" changeAction=\"15\"/></View></Views>"
      )
    );
    compiler.compile();
    std.test.assert(compiler.output.contains("ui.Kind.Video"));
    std.test.assert(compiler.output.contains(".frame_rate_num = 30000"));
    std.test.assert(compiler.output.contains(".frame_rate_den = 1001"));
    std.test.assert(compiler.output.contains(".trim_start = 500000"));
    std.test.assert(compiler.output.contains(".trim_end = 2000000"));
    std.test.assert(compiler.output.contains(".position = 1000000"));
    std.test.assert(compiler.output.contains(".action = 15"));
    return;
  }

  /** Preserves borderless panel styling in both resources and inline XML properties. */
  test_function flat_panel_styles() {
    var compiler = markup.Compiler(
      String("panel.view.xml"),
      String(
        "<Views module=\"app\"><Resources name=\"resources\"><Style name=\"panel\"><Normal borderWidth=\"0\" radius=\"16\" padding=\"18\"/></Style></Resources><View name=\"view\" state=\"State\"><Column borderWidth=\"0\" radius=\"8\" padding=\"12\"/></View></Views>"
      )
    );
    compiler.compile();
    std.test.assert(compiler.output.contains(".normal.border_width = 0"));
    std.test.assert(compiler.output.contains(".normal.radius = 16"));
    std.test.assert(compiler.output.contains(".overrides.normal.padding = 12"));
    return;
  }

  /** Preserves explicit ownership expressions without inserting copies. */
  test_function expressions_and_conditions() {
    var compiler = markup.Compiler(
      String("conditional.view.xml"),
      String(
        "<Views module=\"app\"><View name=\"view\" state=\"State\"><If test=\"{state.visible}\"><Label text=\"{state.name.clone(a)}\"/><Else><Label text=\"Hidden\"/></Else></If></View></Views>"
      )
    );
    compiler.compile();
    std.test.assert(
      compiler.output.contains("state.name.clone(a)"),
      "explicit copy is retained"
    );
    std.test.assert(compiler.output.contains("} else {"), "condition compiles to Sun");
  }

  /** Emits one collection evaluation and a stable per-item scope. */
  test_function keyed_repetition() {
    var compiler = markup.Compiler(
      String("loop.view.xml"),
      String(
        "<Views module=\"app\"><View name=\"view\" state=\"State\"><For each=\"id\" in=\"{state.ids}\" key=\"{id}\"><Button text=\"Item\"/></For></View></Views>"
      )
    );
    compiler.compile();
    std.test.assert(compiler.output.contains(" = state.ids;"), "collection is captured once");
    std.test.assert(
      compiler.output.contains("ui.Key(id), ui.Kind.Group"),
      "stable keys scope repeated children"
    );
  }

  /** Rejects a bad document with its original filename and location. */
  function rejects(source: static_ptr<u8>, expected: static_ptr<u8>) void throws {
    var compiler = markup.Compiler(String("invalid.view.xml"), String(source));

    var operation_completed_6 = false;
    try {
      compiler.compile();
      operation_completed_6 = true;
      std.test.assert(false, "invalid input was accepted");
    } catch (error: std.Error) {
      if (operation_completed_6) {
        throw;
      }
      var message = error.message();
      std.test.assert(
        message.contains("invalid.view.xml:"),
        "diagnostic contains source filename"
      );
      std.test.assert(
        message.contains(expected),
        "diagnostic explains the invalid declaration"
      );
    }

    return;
  }

  /** Rejects malformed XML without a project-specific fallback parser. */
  test_function malformed_xml() {
    return rejects("<Views>", "Malformed XML");
  }

  /** Rejects unknown vocabulary and misspelled properties. */
  test_function unknown_declarations() {
    rejects(
      "<Views module=\"app\"><View name=\"view\" state=\"State\"><Unknown/></View></Views>",
      "Unknown view declaration"
    );
    return rejects(
      "<Views module=\"app\"><View name=\"view\" state=\"State\"><Label typo=\"x\"/></View></Views>",
      "Unknown attribute"
    );
  }

  /** Requires durable repetition keys instead of silently using item indexes. */
  test_function missing_loop_key() {
    return rejects(
      "<Views module=\"app\"><View name=\"view\" state=\"State\"><For each=\"id\" in=\"{state.ids}\"/></View></Views>",
      "stable key"
    );
  }

  /** Rejects unstructured text so formatting whitespace cannot become UI content. */
  test_function unexpected_text() {
    return rejects(
      "<Views module=\"app\"><View name=\"view\" state=\"State\">oops</View></Views>",
      "Unknown view declaration"
    );
  }

  /** Keeps imported template declarations explicit and source-relative. */
  test_function imports_and_templates() {
    var compiler = markup.Compiler(
      String("app.view.xml"),
      String(
        "<Views module=\"app\"><Import name=\"Card\" function=\"parts.Card\" source=\"parts/card.view.xml\"><Param name=\"title\" type=\"String\"/></Import><View name=\"view\" state=\"State\"><Card title=\"Hello\"/></View></Views>"
      )
    );
    compiler.compile();
    std.test.assert_eq(compiler.imports.size(), 1);
    std.test.assert(
      compiler.output.contains("parts.Card(result,"),
      "import calls the qualified function"
    );
    std.test.assert(
      compiler.output.contains("template_id"),
      "template identity participates in reconciliation"
    );
  }

  /** Propagates fallible slot callbacks while retaining ordinary void callbacks. */
  test_function slot_callback_results() {
    var compiler = markup.Compiler(
      String("slots.view.xml"),
      String(
        "<Views module=\"slots\"><Template name=\"Panel\"><Param name=\"plain\" type=\"function (ref ui.View, i64) void\"/><Param name=\"checked\" type=\"function (ref ui.View, i64) void throws\"/><Column><Slot name=\"plain\"/><Slot name=\"checked\"/></Column></Template></Views>"
      )
    );
    compiler.compile();
    std.test.assert(compiler.output.contains("plain(result,"));
    std.test.assert(not compiler.output.contains("try plain(result,"));
    std.test.assert(compiler.output.contains("checked(result,"));
  }

  /** Rejects child controls and property declarations in invalid locations. */
  test_function invalid_children() {
    rejects(
      "<Views module=\"app\"><View name=\"view\" state=\"State\"><Button><Label/></Button></View></Views>",
      "cannot contain"
    );
    return rejects(
      "<Views module=\"app\"><View name=\"view\" state=\"State\"><Column><Param name=\"bad\"/></Column></View></Views>",
      "Unknown view declaration"
    );
  }

  /** Compiles generated Sun to prove invalid property expressions fail real type checking. */
  test_function generated_type_error() {
    var a = make_heap_allocator();
    var compiler = markup.Compiler(
      String("invalid-type.view.xml"),
      String(
        "<Views module=\"app\"><View name=\"view\" state=\"i64\"><Label text=\"{42}\"/></View></Views>"
      )
    );
    compiler.compile();
    compiler.output.append(
      "\n/** Drives type checking of a deliberately invalid generated view. */\nfunction main() i32 { return 0; }\nmanifest { libraries: [\"stdlib.moon\", \"sun_ui.moon\"] }\n"
    );
    var path = String("tmp/markup-invalid-type.sun");
    std.io.write_string(path, compiler.output);
    var env = std.env.Env(a);
    var executable = match env.get("SUN_EXECUTABLE") {
      Option.Some(value) => value.clone(a),
      Option.None => String("sun")
    };
    var command = std.process.Command(a, executable);
    command.add_arg("--dynamic");
    command.add_arg("--lib-path");
    command.add_arg("build");
    command.add_arg("-c");
    command.add_arg("-o");
    command.add_arg("tmp/markup-invalid-type");
    command.add_arg(path);
    var output = command.output();
    std.test.assert(
      output.status() != 0,
      "Sun must reject integer text without an explicit conversion"
    );
    std.test.assert(
      output.stderr().contains("String"),
      "diagnostic identifies the required type"
    );
  }

  /** Ensures generated descriptions cannot silently move strings out of borrowed state. */
  test_function generated_ownership_error() {
    var a = make_heap_allocator();
    var compiler = markup.Compiler(
      String("invalid-ownership.view.xml"),
      String(
        "<Views module=\"app\"><View name=\"view\" state=\"String\"><Label text=\"{state}\"/></View></Views>"
      )
    );
    compiler.compile();
    compiler.output.append(
      "\n/** Forces generated ownership checking. */\nfunction main() i32 { return 0; }\nmanifest { libraries: [\"stdlib.moon\", \"sun_ui.moon\"] }\n"
    );
    var path = String("tmp/markup-invalid-ownership.sun");
    std.io.write_string(path, compiler.output);
    var env = std.env.Env(a);
    var executable = match env.get("SUN_EXECUTABLE") {
      Option.Some(value) => value.clone(a),
      Option.None => String("sun")
    };
    var command = std.process.Command(a, executable);
    command.add_arg("--dynamic");
    command.add_arg("--lib-path");
    command.add_arg("build");
    command.add_arg("-c");
    command.add_arg("-o");
    command.add_arg("tmp/markup-invalid-ownership");
    command.add_arg(path);
    var output = command.output();
    std.test.assert(
      output.status() != 0,
      "owned properties require an explicit clone of borrowed state"
    );
    std.test.assert(
      output.stderr().contains("const ref String"),
      "failure concerns ownership"
    );
  }

  /** Rejects contradictory or nested resource declarations rather than ignoring them. */
  test_function invalid_resources() {
    rejects(
      "<Views module=\"app\"><Resources name=\"resources\"><Color name=\"x\" basedOn=\"base\"/></Resources></Views>",
      "Invalid property"
    );
    rejects(
      "<Views module=\"app\"><Resources name=\"resources\"><Color name=\"x\" ref=\"base\" value=\"12\"/></Resources></Views>",
      "alias cannot"
    );
    rejects(
      "<Views module=\"app\"><Resources name=\"resources\"><Style name=\"x\"><Normal/><Normal/></Style></Resources></Views>",
      "Duplicate style"
    );
    return rejects(
      "<Views module=\"app\"><Resources name=\"resources\"><Style name=\"x\"><Normal><Label/></Normal></Style></Resources></Views>",
      "Appearance cannot"
    );
  }

  /** Rejects invalid template resources even when no Use declaration instantiates them. */
  test_function invalid_template_resources() {
    rejects(
      "<Views module=\"app\"><Resources name=\"resources\"><Template name=\"x\" value=\"Missing\"/></Resources></Views>",
      "declared component function"
    );
    return rejects(
      "<Views module=\"app\"><Resources name=\"resources\"><Template name=\"a\" ref=\"b\"/><Template name=\"b\" ref=\"a\"/></Resources></Views>",
      "cycle"
    );
  }

  /** Ensures even unused template imports are checked against their declared parameter types. */
  test_function unused_template_signature() {
    var a = make_heap_allocator();
    var compiler = markup.Compiler(
      String("template-type.view.xml"),
      String(
        "<Views module=\"app\"><Import name=\"Card\" function=\"foreign.Card\"><Param name=\"value\" type=\"i64\"/></Import><Resources name=\"resources\"><Template name=\"card\" value=\"Card\"/></Resources></Views>"
      )
    );
    compiler.compile();
    compiler.output.append(
      "\n/** Provides a deliberately incompatible imported component. */\nmodule foreign { /** Takes owned text rather than the declared integer. */ public function Card(view: ref ui.View, parent: i64, value: String) void {} }\n/** Runs signature checking without invoking the resource. */\nfunction main() i32 { return 0; }\nmanifest { libraries: [\"stdlib.moon\", \"sun_ui.moon\"] }\n"
    );
    var path = String("tmp/markup-template-type.sun");
    std.io.write_string(path, compiler.output);
    var env = std.env.Env(a);
    var executable = match env.get("SUN_EXECUTABLE") {
      Option.Some(value) => value.clone(a),
      Option.None => String("sun")
    };
    var command = std.process.Command(a, executable);
    command.add_arg("--dynamic");
    command.add_arg("--lib-path");
    command.add_arg("build");
    command.add_arg("-c");
    command.add_arg("-o");
    command.add_arg("tmp/markup-template-type");
    command.add_arg(path);
    var output = command.output();
    std.test.assert(
      output.status() != 0,
      "typed template accessor rejects the incompatible import"
    );
    std.test.assert(
      output.stderr().contains("No overload") and output.stderr().contains("function"),
      "diagnostic identifies incompatible function signatures"
    );
  }

  /** Rejects ambiguous routing and state-dependent handlers in untyped reusable components. */
  test_function invalid_named_actions() {
    rejects(
      "<Views module=\"app\"><View name=\"view\" state=\"State\"><Button action=\"click\" changeAction=\"edit\"/></View></Views>",
      "not both"
    );
    return rejects(
      "<Views module=\"app\"><Component name=\"Card\"><Button action=\"click\"/></Component></Views>",
      "Named actions require a View"
    );
  }

  /** Rejects malformed slots, conflicting appearance inputs, and invalid theme declarations. */
  test_function content_and_theme_diagnostics() {
    rejects(
      "<Views module=\"app\"><Component name=\"Panel\"><Slot name=\"unknown\"/></Component></Views>",
      "Unknown slot input"
    );
    rejects(
      "<Views module=\"app\"><Component name=\"Panel\"><Content name=\"body\"/></Component></Views>",
      "exactly one"
    );
    rejects(
      "<Views module=\"app\"><Component name=\"Panel\"><Content name=\"body\"/><Slot name=\"body\"/><Slot name=\"body\"/></Component></Views>",
      "exactly one"
    );
    rejects(
      "<Views module=\"app\"><Component name=\"Panel\"><Content name=\"body\"/><If test=\"true\"><Slot name=\"body\"/></If></Component></Views>",
      "unconditional"
    );
    rejects(
      "<Views module=\"app\"><Component name=\"Panel\"><Content name=\"body\"/><Content name=\"body\"/><Slot name=\"body\"/></Component></Views>",
      "Duplicate component input"
    );
    rejects(
      "<Views module=\"app\"><Component name=\"Panel\"><Content name=\"body\"/><Slot name=\"body\"/></Component><View name=\"view\" state=\"i64\"><Panel/></View></Views>",
      "Missing content body"
    );
    rejects(
      "<Views module=\"app\"><Component name=\"Panel\"><Content name=\"body\"/><Slot name=\"body\"/></Component><View name=\"view\" state=\"i64\"><Panel><Panel.body/><Panel.body/></Panel></View></Views>",
      "Duplicate content body"
    );
    rejects(
      "<Views module=\"app\"><Component name=\"Panel\"><Content name=\"body\"/><Slot name=\"body\"/></Component><View name=\"view\" state=\"i64\"><Panel><Panel.body/><Panel.other/></Panel></View></Views>",
      "Unknown component content"
    );
    rejects(
      "<Views module=\"app\"><Resources name=\"resources\"><Style name=\"bad\"><Normal padding=\"1\" paddingResource=\"space\"/></Style></Resources></Views>",
      "Conflicting"
    );
    rejects(
      "<Views module=\"app\"><Resources name=\"resources\"><Theme name=\"bad\"><Default kind=\"Missing\" styleResource=\"x\"/></Theme></Resources></Views>",
      "control kind"
    );
    rejects(
      "<Views module=\"app\"><View name=\"view\" state=\"i64\" theme=\"{ui.Style()}\" themeResource=\"x\"/></Views>",
      "either theme"
    );
    rejects("<Views module=\"app\"><Include source=\"../bad.view.xml\"/></Views>", "relative");
  }

  /** Discovers typed inputs once and resolves plain component tags without imports. */
  test_function application_component_registry() {
    var a = make_heap_allocator();
    var registry = markup.Registry(a);
    var parts = markup.Compiler(
      String("parts.view.xml"),
      String(
        "<Views module=\"parts\"><Component name=\"Caption\"><Param name=\"text\" type=\"String\"/><Label text=\"{text}\"/></Component></Views>"
      )
    );
    parts.register_components(registry);
    var consumer = markup.Compiler(
      String("app.view.xml"),
      String(
        "<Views module=\"app\"><View name=\"view\" state=\"i64\"><Caption text=\"Hello\"/></View></Views>"
      )
    );
    consumer.use_registry(registry);
    consumer.compile();
    std.test.assert(consumer.output.contains("parts.Caption(result,"));
    std.test.assert(consumer.output.contains("String(\"Hello\")"));
    parts.use_registry(registry);
    parts.compile();
    var missing = markup.Compiler(
      String("missing.view.xml"),
      String(
        "<Views module=\"app\"><View name=\"view\" state=\"i64\"><Caption/></View></Views>"
      )
    );
    missing.use_registry(registry);

    var operation_completed_5 = false;
    try {
      missing.compile();
      operation_completed_5 = true;
      std.test.assert(false, "registered inputs must be checked");
    } catch (error: std.Error) {
      if (operation_completed_5) {
        throw;
      }
      std.test.assert(
        (error.message()).contains("Missing component input"),
        "Expected registry diagnostic: Missing component input"
      );
    }

    var duplicate = markup.Compiler(
      String("other.view.xml"),
      String(
        "<Views module=\"other\"><Component name=\"Caption\"><Label/></Component></Views>"
      )
    );

    var operation_completed_4 = false;
    try {
      duplicate.register_components(registry);
      operation_completed_4 = true;
      std.test.assert(false, "duplicate registrations accepted");
    } catch (error: std.Error) {
      if (operation_completed_4) {
        throw;
      }
      std.test.assert(
        (error.message()).contains("Duplicate registered component"),
        "Expected registry diagnostic: Duplicate registered component"
      );
      std.test.assert(
        (error.message()).contains("parts.view.xml"),
        "Expected registry diagnostic: parts.view.xml"
      );
    }

    var conflict = markup.Compiler(
      String("local.view.xml"),
      String(
        "<Views module=\"local\"><Component name=\"Caption\"><Label/></Component></Views>"
      )
    );

    var operation_completed_3 = false;
    try {
      conflict.use_registry(registry);
      operation_completed_3 = true;
      std.test.assert(false, "local collision accepted");
    } catch (error: std.Error) {
      if (operation_completed_3) {
        throw;
      }
      std.test.assert(
        (error.message()).contains("conflicts"),
        "Expected registry diagnostic: conflicts"
      );
    }

    var reserved = markup.Compiler(
      String("reserved.view.xml"),
      String(
        "<Views module=\"parts\"><Component name=\"Button\"><Label/></Component></Views>"
      )
    );

    var operation_completed_2 = false;
    try {
      reserved.register_components(registry);
      operation_completed_2 = true;
      std.test.assert(false, "built-in component shadowed");
    } catch (error: std.Error) {
      if (operation_completed_2) {
        throw;
      }
      std.test.assert(
        (error.message()).contains("reserved"),
        "Expected registry diagnostic: reserved"
      );
    }
  }

  /** Checks registry diagnostics without starting the command-line generator. */
  function rejects_registry(source: static_ptr<u8>, expected: static_ptr<u8>) void throws {
    var compiler = markup.Compiler(String("components.registry.xml"), String(source));

    var operation_completed_1 = false;
    try {
      compiler.registry_sources();
      operation_completed_1 = true;
      std.test.assert(false, "invalid XML registry accepted");
    } catch (error: std.Error) {
      if (operation_completed_1) {
        throw;
      }
      std.test.assert((error.message()).contains("components.registry.xml:"));
      std.test.assert((error.message()).contains(expected));
    }

    return;
  }

  /** Accepts source lists and rejects malformed registry structure and unsafe paths. */
  test_function xml_component_registry() {
    var compiler = markup.Compiler(
      String("components.registry.xml"),
      String(
        "<ComponentRegistry><!-- reusable parts --><Source path=\"parts/panel.view.xml\"/></ComponentRegistry>"
      )
    );
    var sources = compiler.registry_sources();
    std.test.assert_eq(sources.size(), 1);
    std.test.assert(sources[0].equals_literal("parts/panel.view.xml"));
    rejects_registry("<Views/>", "ComponentRegistry root");
    rejects_registry("<ComponentRegistry extra=\"x\"/>", "Unknown attribute");
    rejects_registry("<ComponentRegistry><Source/></ComponentRegistry>", "relative");
    rejects_registry(
      "<ComponentRegistry><Source path=\"../parts.view.xml\"/></ComponentRegistry>",
      "relative"
    );
    rejects_registry(
      "<ComponentRegistry><Source path=\"parts.view.xml\"><Source path=\"nested.view.xml\"/></Source></ComponentRegistry>",
      "empty Source"
    );
    rejects_registry("<ComponentRegistry>unexpected text</ComponentRegistry>", "empty Source");
    rejects_registry(
      "<ComponentRegistry><Source></ComponentRegistry>",
      "Malformed registry XML"
    );
  }

  /** Generates a viewport identifier while retaining ordinary layout properties. */
  test_function viewport_properties() {
    var compiler = markup.Compiler(
      String("viewport.view.xml"),
      String(
        "<Views module=\"app\"><View name=\"view\" state=\"State\"><Viewport key=\"scene\" viewportId=\"{state.viewport}\" width=\"640\" expandX=\"true\"/></View></Views>"
      )
    );
    compiler.compile();
    std.test.assert(compiler.output.contains("ui.Kind.Viewport"));
    std.test.assert(compiler.output.contains(".viewport_id = state.viewport"));
    std.test.assert(compiler.output.contains(".expand_x = true"));
  }
}
