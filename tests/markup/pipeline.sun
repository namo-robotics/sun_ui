using std;

/** Exercises the command-line import graph without GTK or a display. */
module markup_pipeline_tests {

  /** Writes a fixture owned by this test under the workspace temporary directory. */
  function write(path: static_ptr<u8>, text: static_ptr<u8>) void throws {
    var filename = String(path);
    var source = String(text);
    return std.io.write_string(filename, source);
  }

  /** Runs the already-built generator and captures structural diagnostics. */
  function generate() std.process.Output throws {
    var a = make_heap_allocator();
    var target = build_targets.load("sun_viewc");
    var command = std.process.Command(a, target.output);
    command.add_arg("tmp/markup-pipeline/main.view.xml");
    command.add_arg("build/generated/tests/pipeline/main.view.sun");
    return command.output();
  }

  /** Regenerates imported changes deterministically and rejects invalid dependency graphs. */
  test_function import_regeneration_and_failures() {
    var a = make_heap_allocator();
    var mkdir = std.process.Command(a, "mkdir");
    mkdir.add_arg("-p");
    mkdir.add_arg("tmp/markup-pipeline/parts");
    std.test.assert_eq(mkdir.status(), 0);
    write(
      "tmp/markup-pipeline/main.view.xml",
      "<Views module=\"pipeline\"><Import name=\"Footer\" function=\"parts.Footer\" source=\"parts/footer.view.xml\"/><View name=\"view\" state=\"i64\"><Footer/></View></Views>"
    );
    write(
      "tmp/markup-pipeline/parts/footer.view.xml",
      "<Views module=\"parts\"><Template name=\"Footer\"><Label text=\"Original\"/></Template></Views>"
    );
    var first = generate();
    std.test.assert_eq(first.status(), 0);
    var path = String("build/generated/tests/pipeline/main.view.sun");
    var original = std.io.read_to_string(a, path);
    var map_path = String("build/generated/tests/pipeline/main.view.sun.map");

    var original_map = std.io.read_to_string(a, map_path);
    std.test.assert(
      original_map.contains("tmp/markup-pipeline/parts/footer.view.xml"),
      "import mappings retain their filenames"
    );
    var repeated = generate();
    std.test.assert_eq(repeated.status(), 0);
    var repeated_source = std.io.read_to_string(a, path);
    var repeated_map = std.io.read_to_string(a, map_path);
    std.test.assert(original.equals(repeated_source), "source generation is deterministic");
    std.test.assert(original_map.equals(repeated_map), "mapping generation is deterministic");
    write(
      "tmp/markup-pipeline/parts/footer.view.xml",
      "<Views module=\"parts\"><Template name=\"Footer\"><Label text=\"Changed\"/></Template></Views>"
    );
    var changed = generate();
    std.test.assert_eq(changed.status(), 0);
    var changed_source = std.io.read_to_string(a, path);
    std.test.assert(
      changed_source.contains("Changed") and not changed_source.contains("Original"),
      "imported changes reach the consumer"
    );
    write(
      "tmp/markup-pipeline/parts/footer.view.xml",
      "<Views module=\"parts\"><Template name=\"Footer\"><Unknown/></Template></Views>"
    );
    var invalid = generate();
    std.test.assert(invalid.status() != 0, "invalid imports stop the build");
    std.test.assert(
      invalid.stderr().contains("footer.view.xml:"),
      "dependency error names its source"
    );
    write(
      "tmp/markup-pipeline/parts/footer.view.xml",
      "<Views module=\"parts\"><Import name=\"Again\" function=\"parts.Footer\" source=\"footer.view.xml\"/><Template name=\"Footer\"><Label text=\"Cycle\"/></Template></Views>"
    );
    var cycle = generate();
    std.test.assert(cycle.status() != 0, "import cycles stop generation");
    std.test.assert(cycle.stderr().contains("cycle"), "cycle diagnostic explains the failure");
    write(
      "tmp/markup-pipeline/main.view.xml",
      "<Views module=\"pipeline\"><Include source=\"parts/footer.view.xml\"/><Include source=\"parts/footer.view.xml\"/></Views>"
    );
    write(
      "tmp/markup-pipeline/parts/footer.view.xml",
      "<Views module=\"palette\"><Resources name=\"resources\"><Color name=\"accent\" value=\"7\"/></Resources></Views>"
    );
    var included = generate();
    std.test.assert_eq(included.status(), 0);
    var included_source = std.io.read_to_string(a, path);
    var lines = included_source.split(a, b'\n');
    var definitions: i64 = 0;
    for (var line: ref String in lines) {
      if (line.contains("public function resources")) {
        definitions += 1;
      }
    }
    std.test.assert_eq(definitions, 1);
    write(
      "tmp/markup-pipeline/parts/footer.view.xml",
      "<Views module=\"palette\"><Include source=\"footer.view.xml\"/></Views>"
    );
    var include_cycle = generate();
    std.test.assert(include_cycle.status() != 0);
    std.test.assert(include_cycle.stderr().contains("cycle"));
  }

  /** Maps compiler diagnostics to imported XML, counting CRLF and Unicode correctly. */
  test_function imported_diagnostic_locations() {
    write("tmp/markup-map-source.view.xml", "<Views>\r\n  é<Label/>\r\n</Views>");
    write(
      "tmp/markup-map.sun.map",
      "1\t0\ttmp/markup-map-source.view.xml\n5\t13\ttmp/markup-map-source.view.xml\n"
    );
    var generated = String("tmp/markup-map.sun");
    var original = String("unused.view.xml");
    var diagnostic = String("/workspace/tmp/markup-map.sun:6:3: error: expected String\n");

    var messages = build_diagnostics.mapped(diagnostic, generated, original);
    std.test.assert(
      messages.contains("tmp/markup-map-source.view.xml:2:4:"),
      "maps to original Unicode column across CRLF"
    );
    std.test.assert(
      not messages.contains("unused.view.xml"),
      "uses imported source instead of root fallback"
    );
  }

  /** Runs a registry fixture through either explicit selection or adjacent discovery. */
  function generate_registered(explicit_registry: bool) std.process.Output throws {
    var a = make_heap_allocator();
    var target = build_targets.load("sun_viewc");
    var command = std.process.Command(a, target.output);
    command.add_arg(
      explicit_registry ? "tmp/registry-pipeline/views/main.view.xml" : "tmp/registry-pipeline/main.view.xml"
    );
    command.add_arg("build/generated/tests/registry/main.view.sun");
    if (explicit_registry) {
      command.add_arg("--registry");
      command.add_arg("tmp/registry-pipeline/components.registry.xml");
    }
    return command.output();
  }

  /** Checks registry discovery, source regeneration, deduplication, and failure diagnostics. */
  test_function registry_pipeline() {
    var a = make_heap_allocator();
    var mkdir = std.process.Command(a, "mkdir");
    mkdir.add_arg("-p");
    mkdir.add_arg("tmp/registry-pipeline/views");
    std.test.assert_eq(mkdir.status(), 0);
    write(
      "tmp/registry-pipeline/main.view.xml",
      "<Views module=\"app\"><View name=\"view\" state=\"i64\"><Caption text=\"Hello\"/></View></Views>"
    );
    write(
      "tmp/registry-pipeline/views/main.view.xml",
      "<Views module=\"app\"><View name=\"view\" state=\"i64\"><Caption text=\"Nested\"/></View></Views>"
    );
    write(
      "tmp/registry-pipeline/components.registry.xml",
      "<ComponentRegistry><Source path=\"parts.view.xml\"/><Source path=\"parts.view.xml\"/></ComponentRegistry>"
    );
    write(
      "tmp/registry-pipeline/parts.view.xml",
      "<Views module=\"parts\"><Component name=\"Caption\"><Param name=\"text\" type=\"String\"/><Label text=\"{text}\"/></Component></Views>"
    );
    var first = generate_registered(false);
    std.test.assert_eq(first.status(), 0);
    var output = String("build/generated/tests/registry/main.view.sun");
    var map = String("build/generated/tests/registry/main.view.sun.map");

    var original = std.io.read_to_string(a, output);
    var mapping = std.io.read_to_string(a, map);
    std.test.assert(original.contains("parts.Caption(result,"));
    std.test.assert(mapping.contains("tmp/registry-pipeline/parts.view.xml"));
    var lines = original.split(a, b'\n');
    var count: i64 = 0;
    for (var line: ref String in lines) {
      if (line.contains("public function Caption(")) {
        count += 1;
      }
    }
    std.test.assert_eq(count, 1);
    var repeated = generate_registered(false);
    std.test.assert_eq(repeated.status(), 0);
    var repeated_source = std.io.read_to_string(a, output);
    std.test.assert(original.equals(repeated_source));
    var explicit_result = generate_registered(true);
    std.test.assert_eq(explicit_result.status(), 0);
    write(
      "tmp/registry-pipeline/parts.view.xml",
      "<Views module=\"parts\"><Component name=\"Caption\"><Param name=\"text\" type=\"String\"/><Label text=\"Changed\"/></Component></Views>"
    );
    var changed = generate_registered(false);
    std.test.assert_eq(changed.status(), 0);
    var changed_source = std.io.read_to_string(a, output);
    std.test.assert(changed_source.contains("Changed"));
    write("tmp/registry-pipeline/components.registry.xml", "<ComponentRegistry/>");
    var unknown = generate_registered(false);
    std.test.assert(unknown.status() != 0);
    std.test.assert(unknown.stderr().contains("main.view.xml:"));
    var preserved = std.io.read_to_string(a, output);
    std.test.assert(
      changed_source.equals(preserved),
      "failed generation must not publish partial output"
    );
    write(
      "tmp/registry-pipeline/components.registry.xml",
      "<ComponentRegistry><Source path=\"parts.view.xml\"></ComponentRegistry>"
    );
    var malformed = generate_registered(false);
    std.test.assert(malformed.status() != 0);
    write(
      "tmp/registry-pipeline/components.registry.xml",
      "<ComponentRegistry><Source path=\"../parts.view.xml\"/></ComponentRegistry>"
    );
    var traversal = generate_registered(false);
    std.test.assert(traversal.status() != 0);
    write(
      "tmp/registry-pipeline/components.registry.xml",
      "<ComponentRegistry><Source path=\"missing.view.xml\"/></ComponentRegistry>"
    );
    var missing = generate_registered(false);
    std.test.assert(missing.status() != 0);
  }
}
