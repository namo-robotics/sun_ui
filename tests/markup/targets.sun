using std;

/** Verifies target selection independently of this workspace's artifact names. */
module build_targets {

  /** Keeps explicit library and test output names when selecting among multiple entries. */
  test_function configured_artifact_names() {
    var a = make_heap_allocator();
    var document = std.json.parse_json(
      a,
      "{\"entrypoints\":[{\"name\":\"other\"},{\"name\":\"sample\",\"path\":\"src/example.sun\",\"type\":\"library\",\"output_name\":\"tmp/custom.moon\",\"test_binary_name\":\"tmp/custom-tests\"}]}"
    );
    var target = select(document, "sample");
    std.test.assert(target.library);
    std.test.assert(target.source.equals_literal("src/example.sun"));
    std.test.assert(target.output.equals_literal("tmp/custom.moon"));
    std.test.assert(target.tests.equals_literal("tmp/custom-tests"));
    return;
  }

  /** Derives a binary's default test artifact from its configured output. */
  test_function default_test_artifact() {
    var a = make_heap_allocator();
    var document = std.json.parse_json(
      a,
      "{\"entrypoints\":[{\"name\":\"sample\",\"path\":\"src/example.sun\",\"type\":\"binary\",\"output_name\":\"tmp/custom\"}]}"
    );
    var target = select(document, "sample");
    std.test.assert(target.library == false);
    std.test.assert(target.tests.equals_literal("tmp/custom_test"));
    return;
  }

  /** Reports missing targets and invalid target types instead of compiling a fallback. */
  test_function invalid_targets() {
    var a = make_heap_allocator();
    var document = std.json.parse_json(
      a,
      "{\"entrypoints\":[{\"name\":\"sample\",\"path\":\"src/example.sun\",\"type\":\"invalid\",\"output_name\":\"tmp/custom\"}]}"
    );
    var missing: bool = false;

    try {
      select(document, "absent");

      missing = false;
    } catch (error: std.json.JsonError) {
      missing = true;
    } catch (error: std.Error) {
      std.io.eprintln(error.message());
      std.test.fail("Unexpected target selection failure");
      return;
    }

    var invalid: bool = false;

    try {
      select(document, "sample");

      invalid = false;
    } catch (error: std.json.JsonError) {
      invalid = true;
    } catch (error: std.Error) {
      std.io.eprintln(error.message());
      std.test.fail("Unexpected target selection failure");
      return;
    }

    std.test.assert(missing);
    std.test.assert(invalid);
    return;
  }
}
