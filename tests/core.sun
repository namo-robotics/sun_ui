  /** Rejects local resource lookup errors before changing a previously mounted description. */
  test_function construction_resources_are_atomic() std.test.AssertionResult<void> {
    var a = make_heap_allocator();
    var tree = try ui.Tree(a);
    var renderer = try Recording();
    try tree.render(renderer, try pair(1, 2));
    var identity = try tree.identity(1);
    var view = try ui.View(a);
    var parent = try view.push_resources();
    var node = try ui.Element(try ui.Key(3), ui.Kind.Label);
    node.style = try view.style_resource(try String("missing"));
    try view.append(-1, node);
    view.resource_scope = parent;
    match tree.render(renderer, view) {
      SystemResult.Error(_) => {},
      SystemResult.Allocation(error) => {
        return std.test.AssertionResult.Allocation(error);
      },
      SystemResult.InvalidArgument(error) => {
        return std.test.AssertionResult.InvalidArgument(error);
      },
      SystemResult.Overflow(error) => {
        return std.test.AssertionResult.Overflow(error);
      },
      SystemResult.Ok => {
        try std.test.assert(false, "missing local resource must fail");
      }
    };
    try std.test.assert_eq(renderer.created, 2);
    try std.test.assert_eq(renderer.removed, 0);
    try std.test.assert_eq(try tree.identity(1), identity);
    try std.test.assert(tree.active(), "construction failure preserves the mounted tree");
  }

  /** Supplies a generated route without retaining a function or state reference in the description. */
  function routed_view(state: const ref i64) SystemResult<ui.View> {
    var a = make_heap_allocator();
    var result = try ui.View(a);
    var button = try ui.Element(try ui.Key(1), ui.Kind.Button);
    button.action_scope = try String("original-view");
    button.action = 4;
    try result.append(-1, button);
    return SystemResult.Ok(result);
  }

  /** Checks that queued routing remains the snapshot captured before a later render. */
  function routed_handler(
    state: ref i64,
    event: const ref ui.Event,
    queue: ref ui.EventQueue
  ) SystemResult<void> {
    if (not event.action_scope.equals_literal("original-view") or event.action != 4) {
      return SystemResult.Error(Error(1, "Queued generated routing changed"));
    }
    state += 1;
    return SystemResult.Ok;
  }

  /** Keeps generated route namespaces owned and captured alongside numeric IDs. */
  test_function generated_route_is_captured() std.test.AssertionResult<void> {
    var a = make_heap_allocator();
    var renderer = try Recording();
    var session = try ui.Session<i64>(0, routed_view, routed_handler);
    try session.render(renderer);
    try session.tree.enqueue(try session.tree.identity(1), session.queue);
    var changed = try routed_view(session.state);
    changed.elements[0].action_scope = try String("replacement-view");
    changed.elements[0].action = 9;
    try session.tree.render(renderer, changed);
    try session.dispatch(renderer);
    try std.test.assert_eq(session.state, 1);
  }

  /** Resolves forward palette references in their defining scopes for every appearance. */
  test_function palette_references_and_scopes() std.test.AssertionResult<void> {
    var a = make_heap_allocator();
    var resources = try ui.Resources(a);
    var base = try ui.Resource(try String("base"), ui.ResourceKind.Style);
    base.normal_references.foreground = try String("accent");
    base.hover_references.background = try String("accent");
    base.focus_references.padding = try String("space");
    base.disabled_references.font = try String("font");
    base.normal_references.font_size = try String("space");
    base.normal_references.border_width = try String("space");
    base.normal_references.radius = try String("space");
    try resources.add(0, base);
    var accent = try ui.Resource(try String("accent"), ui.ResourceKind.Color);
    accent.number = 12;
    try resources.add(0, accent);
    var space = try ui.Resource(try String("space"), ui.ResourceKind.Spacing);
    space.number = 8;
    try resources.add(0, space);
    var font = try ui.Resource(try String("font"), ui.ResourceKind.Font);
    font.text = try String("Sans");
    try resources.add(0, font);
    var local = try resources.scope(1);
    var shadow = try ui.Resource(try String("accent"), ui.ResourceKind.Color);
    shadow.number = 99;
    try resources.add(local, shadow);
    var derived = try ui.Resource(try String("derived"), ui.ResourceKind.Style);
    derived.based_on = try String("base");
    derived.style.normal.padding = 3;
    try resources.add(local, derived);
    try resources.validate();
    var style = try resources.style(local, try String("derived"));
    try std.test.assert_eq(style.normal.foreground, 12);
    try std.test.assert_eq(style.hover.background, 12);
    try std.test.assert_eq(style.focus.padding, 8);
    try std.test.assert_eq(style.normal.font_size, 8);
    try std.test.assert_eq(style.normal.border_width, 8);
    try std.test.assert_eq(style.normal.radius, 8);
    try std.test.assert_eq(style.normal.padding, 3);
    try std.test.assert(style.disabled.font.equals_literal("Sans"));
  }

  /** Rejects missing, mistyped, conflicting, and overflowing appearance resources. */
  test_function invalid_palette_references() std.test.AssertionResult<void> {
    var a = make_heap_allocator();
    for (var scenario: i32 = 0; scenario < 5; scenario += 1) {
      var resources = try ui.Resources(a);
      var style = try ui.Resource(try String("bad"), ui.ResourceKind.Style);
      style.normal_references.padding = try String("value");
      if (scenario == 2) {
        style.style.normal.padding = 3;
      }
      try resources.add(1, style);
      if (scenario != 0) {
        var value = try ui.Resource(
          try String("value"),
          scenario == 1 ? ui.ResourceKind.Color : ui.ResourceKind.Spacing
        );
        value.number = scenario == 3 ? 2147483648 : (scenario == 4 ? -1 : 4);
        try resources.add(1, value);
      }
      match resources.validate() {
        SystemResult.Error(_) => {},
        SystemResult.Allocation(error) => {
          return std.test.AssertionResult.Allocation(error);
        },
        SystemResult.InvalidArgument(error) => {
          return std.test.AssertionResult.InvalidArgument(error);
        },
        SystemResult.Overflow(error) => {
          return std.test.AssertionResult.Overflow(error);
        },
        SystemResult.Ok => {
          try std.test.assert(false, "invalid appearance resource was accepted");
        }
      };
    }
  }

  /** Records final button colors to check rendering precedence. */
  class ThemeRecording implements ui.Renderer {
    public var color: i64 = -1;
    public var background: i64 = -1;
    public var created: i64 = 0;
    public var updated: i64 = 0;

    /** Starts with no rendered appearance. */
    init() {}

    /** Captures a newly resolved appearance. */
    public method create(identity: u64, element: const ref ui.Element) SystemResult<void> {
      this.created += 1;
      this.color = element.style.normal.foreground;
      this.background = element.style.normal.background;
      return SystemResult.Ok;
    }

    /** Captures a changed appearance without replacing its control. */
    public method update(identity: u64, element: const ref ui.Element) SystemResult<void> {
      this.updated += 1;
      this.color = element.style.normal.foreground;
      this.background = element.style.normal.background;
      return SystemResult.Ok;
    }

    /** Accepts logical placement without a native widget. */
    public method place(identity: u64, parent: u64, previous: u64) SystemResult<void> {
      return SystemResult.Ok;
    }

    /** Completes the in-memory render. */
    public method finish() SystemResult<void> {
      return SystemResult.Ok;
    }

    /** Accepts removal of the recorded control. */
    public method remove(identity: u64) void {}

    /** Accepts focus without a native widget. */
    public method focus(identity: u64) void {}

    /** Releases the recorded appearance. */
    public method clear() void {}
  }

  /** Applies kind defaults below explicit styles and rejects unused invalid themes atomically. */
  test_function themes_update_without_remount() std.test.AssertionResult<void> {
    var a = make_heap_allocator();
    var tree = try ui.Tree(a);
    var renderer = ThemeRecording();
    var identity: u64 = 0;
    for (var stage: i64 = 0; stage < 4; stage += 1) {
      var view = try ui.View(a);
      var theme = try ui.Theme(a);
      theme.base.normal.foreground = 1;
      var control = try ui.Style();
      control.normal.foreground = 2;
      control.normal.background = stage;
      try theme.defaults.push(ui.ThemeDefault(ui.Kind.Button, control));
      try view.set_theme(theme);
      var button = try ui.Element(try ui.Key(1), ui.Kind.Button);
      if (stage >= 1) {
        button.style.normal.foreground = 3;
      }
      if (stage >= 2) {
        button.overrides.normal.foreground = 4;
      }
      try view.append(-1, button);
      try tree.render(renderer, view);
      if (stage == 0) {
        identity = try tree.identity(1);
      }
      try std.test.assert_eq(try tree.identity(1), identity);
      try std.test.assert_eq(renderer.color, stage == 0 ? 2 : (stage == 1 ? 3 : 4));
      try std.test.assert_eq(renderer.background, stage);
    }
    try std.test.assert_eq(renderer.created, 1);
    try std.test.assert_eq(renderer.updated, 3);
    var invalid = try ui.View(a);
    var resource = try ui.Resource(try String("unused"), ui.ResourceKind.Theme);
    try resource.defaults.push(
      ui.ThemeReference(ui.Kind.Button, try String("missing"))
    );

    try invalid.define(resource);
    match tree.render(renderer, invalid) {
      SystemResult.Error(_) => {},
      SystemResult.Allocation(error) => {
        return std.test.AssertionResult.Allocation(error);
      },
      SystemResult.InvalidArgument(error) => {
        return std.test.AssertionResult.InvalidArgument(error);
      },
      SystemResult.Overflow(error) => {
        return std.test.AssertionResult.Overflow(error);
      },
      SystemResult.Ok => {
        try std.test.assert(false, "unused invalid theme accepted");
      }
    };
    try std.test.assert_eq(try tree.identity(1), identity);
    try std.test.assert_eq(renderer.updated, 3);
    var duplicate = try ui.Theme(a);
    try duplicate.defaults.push(ui.ThemeDefault(ui.Kind.Button, try ui.Style()));

    try duplicate.defaults.push(ui.ThemeDefault(ui.Kind.Button, try ui.Style()));

    match duplicate.validate() {
      SystemResult.Error(_) => {},
      SystemResult.Allocation(error) => {
        return std.test.AssertionResult.Allocation(error);
      },
      SystemResult.InvalidArgument(error) => {
        return std.test.AssertionResult.InvalidArgument(error);
      },
      SystemResult.Overflow(error) => {
        return std.test.AssertionResult.Overflow(error);
      },
      SystemResult.Ok => {
        try std.test.assert(false, "duplicate theme default accepted");
      }
    };
  }

