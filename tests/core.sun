  /** Builds a grid containing a controlled selection for update regression checks. */
  function selection_view(label: static_ptr<u8>, weight: i32) AllocationResult<ui.View> {
    var a = make_heap_allocator();
    var view = try ui.View(a);
    var grid = try ui.Element(try ui.Key(1), ui.Kind.Grid);
    try grid.columns.push(ui.Track(ui.TrackKind.Weight, weight));
    var parent = try view.append(-1, grid);
    var select = try ui.Element(try ui.Key(2), ui.Kind.Select);
    try select.choices.push(
      ui.Choice(
        try ui.Key(try String("first")),
        try String(label)
      )
    );

    select.selected = 0;
    try view.append(parent, select);
    return AllocationResult.Ok(view);
  }

  /** Leaves unchanged collection properties mounted and updates only changed controls. */
  test_function collection_updates() std.test.AssertionResult<void> {
    var a = make_heap_allocator();
    var tree = try ui.Tree(a);
    var renderer = try Recording();
    try tree.render(renderer, try selection_view("First", 1));
    try tree.render(renderer, try selection_view("First", 1));
    try std.test.assert_eq(renderer.updated, 0);
    try tree.render(renderer, try selection_view("Renamed", 1));
    try std.test.assert_eq(renderer.updated, 1);
    try tree.render(renderer, try selection_view("Renamed", 2));
    try std.test.assert_eq(renderer.updated, 2);
    try std.test.assert_eq(renderer.created, 2);
  }

  /** Remounts template implementations and cross-parent moves, preserving unrelated scopes. */
  test_function template_and_parent_changes() std.test.AssertionResult<void> {
    var a = make_heap_allocator();
    var tree = try ui.Tree(a);
    var renderer = try Recording();
    try tree.render(renderer, try nested(false, false));
    var first = try child_identity(tree, 1);
    var second = try child_identity(tree, 2);
    var changed = try nested(false, false);
    changed.elements[0].template_id = try String("replacement");
    try changed.focus_path.push(try ui.Key(1));
    try changed.focus_path.push(try ui.Key(try String("local")));

    try tree.render(renderer, changed);
    try std.test.assert(
      try child_identity(tree, 1) != first,
      "template replacement remounts descendants"
    );
    try std.test.assert_eq(try child_identity(tree, 2), second);
    try std.test.assert_eq(renderer.focused, try child_identity(tree, 1));
    var moved = try nested(false, false);
    moved.elements[0].template_id = try String("replacement");
    moved.elements[1].parent = -1;
    try tree.render(renderer, moved);
    try std.test.assert_eq(try child_identity(tree, 1), 0);
    try std.test.assert_eq(try child_identity(tree, 2), second);
    var path = try Vec<ui.Key>(a, 1);
    try path.push(try ui.Key(try String("local")));
    try std.test.assert(
      tree.identity_path(path) != renderer.focused,
      "moving between parents remounts"
    );
  }

