using std;

/** Tests core behavior without loading GTK, native libraries, or a display. */
module core_tests {

  /** Accepts an expected system failure while propagating unrelated failures. */
  function expect_system_error(result: std.Result<void>) std.test.AssertionResult<void> {
    match result {
      (error: const ref Error) => {
        return std.test.AssertionResult.Ok;
      },
      _ => {}
    };
    try result;
    return std.test.fail("Expected a system failure");
  }

  /** Rejects invalid video rates and detects rate changes during reconciliation. */
  test_function video_frame_rates() std.test.AssertionResult<void> {
    var first = try ui.Element(try ui.Key(1), ui.Kind.Video);
    var second = try ui.Element(try ui.Key(1), ui.Kind.Video);
    second.frame_rate_num = 30000;
    second.frame_rate_den = 1001;
    try std.test.assert(not first.equals(second));
    first.frame_rate_num = 30000;
    first.frame_rate_den = 1001;
    try std.test.assert(first.equals(second));
    var renderer = try Recording();
    var tree = try ui.Tree(make_heap_allocator());
    for (var rate: i64 = 0; rate < 3; rate += 1) {
      var view = try ui.View(make_heap_allocator());
      var node = try ui.Element(try ui.Key(1), ui.Kind.Video);
      node.frame_rate_num = rate == 0 ? -1 : (rate == 1 ? 30000 : 1000000001);
      node.frame_rate_den = rate == 1 ? 0 : 1;
      try view.append(-1, node);
      match tree.render(renderer, view) {
        SystemResult.Error(_) => {},
        SystemResult.Allocation(error) => {
          return std.test.AssertionResult.Allocation(error);
        },
        SystemResult.InvalidArgument(error) => {
          return std.test.AssertionResult.InvalidArgument(error);
        },
        SystemResult.Overflow(error) => {
          return std.test.AssertionResult.Overflow(error);
        },
        SystemResult.Ok => {
          try std.test.assert(false, "invalid frame rate accepted");
        }
      };
    }
  }

  /** Requires ordered, nonoverlapping handle pairs and tracks icon and tooltip changes. */
  test_function kept_ranges_and_button_hints() std.test.AssertionResult<void> {
    var renderer = try Recording();
    var tree = try ui.Tree(make_heap_allocator());
    var view = try ui.View(make_heap_allocator());
    var node = try ui.Element(try ui.Key(1), ui.Kind.Video);
    node.duration = 4000000;
    node.trim_end = 1000000;
    node.active_range = 1;
    try node.trim_ranges.push(ui.TrimRange(1, 0, 1000000));
    try node.trim_ranges.push(ui.TrimRange(2, 2000000, 4000000));
    try view.append(-1, node);
    try tree.render(renderer, view);
    var invalid = try ui.View(make_heap_allocator());
    var overlap = try ui.Element(try ui.Key(1), ui.Kind.Video);
    overlap.duration = 4000000;
    overlap.trim_end = 2000000;
    overlap.active_range = 1;
    try overlap.trim_ranges.push(ui.TrimRange(1, 0, 2000000));
    try overlap.trim_ranges.push(ui.TrimRange(2, 1000000, 4000000));
    try invalid.append(-1, overlap);
    match tree.render(renderer, invalid) {
      SystemResult.Error(_) => {},
      SystemResult.Allocation(error) => {
        return std.test.AssertionResult.Allocation(error);
      },
      SystemResult.InvalidArgument(error) => {
        return std.test.AssertionResult.InvalidArgument(error);
      },
      SystemResult.Overflow(error) => {
        return std.test.AssertionResult.Overflow(error);
      },
      SystemResult.Ok => {
        try std.test.assert(false, "overlapping ranges accepted");
      }
    };
    var first = try ui.Element(try ui.Key(2), ui.Kind.Button);
    var second = try ui.Element(try ui.Key(2), ui.Kind.Button);
    second.tooltip = try String("Split section at playhead");
    try std.test.assert(not first.equals(second));
    first.tooltip = try String("Split section at playhead");
    second.icon = try String("edit-cut-symbolic");
    try std.test.assert(not first.equals(second));
    return std.test.AssertionResult.Ok;
  }

  /** Records renderer operations and models live native subscriptions. */
  class Recording implements ui.Renderer {
    public var created: i64 = 0;
    public var updated: i64 = 0;
    public var removed: i64 = 0;
    public var live: i64 = 0;
    public var focused: u64 = 0;
    public var fail: bool = false;
    public var fail_update: bool = false;
    public var order: Vec<u64>;

    /** Allocates the recorded order buffer. */
    init() AllocationResult<void> {
      var a = make_heap_allocator();
      this.order = try Vec<u64>(a, 8);
    }

    /** Records a newly allocated subscription, or simulates platform failure. */
    public method create(identity: u64, element: const ref ui.Element) SystemResult<void> {
      if (this.fail) {
        return SystemResult.Error(Error(1, "Injected create failure"));
      }
      this.created += 1;
      this.live += 1;
      return SystemResult.Ok;
    }

    /** Counts targeted text updates, or simulates a failed platform update. */
    public method update(identity: u64, element: const ref ui.Element) SystemResult<void> {
      if (this.fail_update) {
        return SystemResult.Error(Error(1, "Injected update failure"));
      }
      this.updated += 1;
      return SystemResult.Ok;
    }

    /** Records each desired sibling sequence. */
    public method place(identity: u64, parent: u64, previous: u64) SystemResult<void> {
      if (previous == 0) {
        this.order.clear();
      }
      try this.order.push(identity);
      return SystemResult.Ok;
    }

    /** Completes the recording renderer's immediate placement operations. */
    public method finish() SystemResult<void> {
      return SystemResult.Ok;
    }

    /** Models subscription cleanup at unmount. */
    public method remove(identity: u64) void {
      this.removed += 1;
      this.live -= 1;
    }

    /** Records a post-commit focus effect. */
    public method focus(identity: u64) void {
      this.focused = identity;
    }

    /** Models idempotent release of every remaining resource. */
    public method clear() void {
      this.removed += this.live;
      this.live = 0;
    }
  }

  /** Builds a two-button description in the supplied key order. */
  function pair(first: i64, second: i64) AllocationResult<ui.View> {
    var a = make_heap_allocator();
    var view = try ui.View(a);
    try view.button(first, try String("Task"), 1, first);
    try view.button(second, try String("Task"), 1, second);
    return AllocationResult.Ok(view);
  }

  /** Preserves mounted identity and subscriptions across a sibling reorder. */
  test_function keyed_reorder() std.test.AssertionResult<void> {
    var a = make_heap_allocator();
    var tree = try ui.Tree(a);
    var renderer = try Recording();
    try tree.render(renderer, try pair(10, 20));
    var first = try tree.identity(10);
    var second = try tree.identity(20);
    try tree.render(renderer, try pair(20, 10));
    try std.test.assert_eq(try tree.identity(10), first);
    try std.test.assert_eq(try tree.identity(20), second);
    try std.test.assert_eq(renderer.order[0], second);
    try std.test.assert_eq(renderer.order[1], first);
    try std.test.assert_eq(renderer.created, 2);
    try std.test.assert_eq(renderer.updated, 0);
    try std.test.assert_eq(renderer.removed, 0);
  }

  /** Rejects duplicate sibling keys before any renderer mutation and permits a later valid render. */
  test_function duplicates_are_atomic() std.test.AssertionResult<void> {
    var a = make_heap_allocator();
    var tree = try ui.Tree(a);
    var renderer = try Recording();
    try tree.render(renderer, try pair(10, 20));
    var original = try tree.identity(10);
    match tree.render(renderer, try pair(10, 10)) {
      SystemResult.Ok => {
        try std.test.assert(false);
      },
      SystemResult.Error(_) => {},
      SystemResult.Allocation(error) => {
        return std.test.AssertionResult.Allocation(error);
      },
      SystemResult.InvalidArgument(error) => {
        return std.test.AssertionResult.InvalidArgument(error);
      },
      SystemResult.Overflow(error) => {
        return std.test.AssertionResult.Overflow(error);
      }
    };
    try std.test.assert_eq(renderer.created, 2);
    try std.test.assert_eq(renderer.removed, 0);
    try std.test.assert_eq(try tree.identity(10), original);
    try tree.render(renderer, try pair(20, 10));
  }

  /** Allocates a new identity for a reinserted key and cleans removed subscriptions exactly once. */
  test_function removal_reinsertion_and_shutdown() std.test.AssertionResult<void> {
    var a = make_heap_allocator();
    var tree = try ui.Tree(a);
    var renderer = try Recording();
    try tree.render(renderer, try pair(10, 20));
    var original = try tree.identity(10);
    try tree.render(renderer, try pair(20, 30));
    try std.test.assert_eq(renderer.removed, 1);
    try std.test.assert(tree.alive(original) == false);
    try tree.render(renderer, try pair(10, 20));
    try std.test.assert(try tree.identity(10) != original);
    tree.shutdown(renderer);
    tree.shutdown(renderer);
    try std.test.assert_eq(renderer.live, 0);
    try std.test.assert_eq(renderer.removed, renderer.created);
  }

  /** Clears even partially committed resources and rejects later renders after a native failure. */
  test_function renderer_failure_stops_tree() std.test.AssertionResult<void> {
    var a = make_heap_allocator();
    var tree = try ui.Tree(a);
    var renderer = try Recording();
    try tree.render(renderer, try pair(10, 20));
    renderer.fail = true;
    match tree.render(renderer, try pair(20, 30)) {
      SystemResult.Ok => {
        try std.test.assert(false);
      },
      SystemResult.Error(_) => {},
      SystemResult.Allocation(error) => {
        return std.test.AssertionResult.Allocation(error);
      },
      SystemResult.InvalidArgument(error) => {
        return std.test.AssertionResult.InvalidArgument(error);
      },
      SystemResult.Overflow(error) => {
        return std.test.AssertionResult.Overflow(error);
      }
    };
    try std.test.assert_eq(renderer.live, 0);
    try std.test.assert_eq(try tree.identity(20), 0);
    renderer.fail = false;
    match tree.render(renderer, try pair(10, 20)) {
      SystemResult.Ok => {
        try std.test.assert(false);
      },
      SystemResult.Error(_) => {},
      SystemResult.Allocation(error) => {
        return std.test.AssertionResult.Allocation(error);
      },
      SystemResult.InvalidArgument(error) => {
        return std.test.AssertionResult.InvalidArgument(error);
      },
      SystemResult.Overflow(error) => {
        return std.test.AssertionResult.Overflow(error);
      }
    };
  }

  /** Produces a state-derived label for dispatch and targeted-update tests. */
  function view(state: const ref i64) SystemResult<ui.View> {
    var a = make_heap_allocator();
    var result = try ui.View(a);
    try result.button(1, try `Count ${state}`, 7, 42);
    return SystemResult.Ok(result);
  }

  /** Posts one follow-up event to verify handler execution never recurses. */
  function handler(
    state: ref i64,
    event: const ref ui.Event,
    queue: ref ui.EventQueue
  ) SystemResult<void> {
    if (event.action != 7 or event.payload != 42) {
      return SystemResult.Error(Error(1, "Lost message payload"));
    }
    state += 1;
    if (state == 1) {
      try queue.post(try ui.Event(event.identity, 7, 42));
    }
    return SystemResult.Ok;
  }

  /** Defers handler-posted messages to the next boundary and batches one render per snapshot. */
  test_function deferred_delivery_and_batching() std.test.AssertionResult<void> {
    var renderer = try Recording();
    var session = try ui.Session<i64>(0, view, handler);
    try session.render(renderer);
    var id = try session.tree.identity(1);
    try session.tree.enqueue(id, session.queue);
    try session.tree.enqueue(id, session.queue);
    try session.dispatch(renderer);
    try std.test.assert_eq(session.state, 2);
    try std.test.assert_eq(session.queue.size(), 1);
    try std.test.assert_eq(renderer.updated, 1);
    try session.dispatch(renderer);
    try std.test.assert_eq(session.state, 3);
    try std.test.assert_eq(renderer.updated, 2);
    try std.test.assert_eq(session.queue.size(), 0);
  }

  /** Discards deliveries queued for a removed mount even if its key is reused. */
  test_function stale_events_are_skipped() std.test.AssertionResult<void> {
    var a = make_heap_allocator();
    var renderer = try Recording();
    var session = try ui.Session<i64>(0, view, handler);
    try session.render(renderer);
    try session.tree.enqueue(try session.tree.identity(1), session.queue);
    var empty = try ui.View(a);
    try session.tree.render(renderer, empty);
    try session.render(renderer);
    try session.dispatch(renderer);
    try std.test.assert_eq(session.state, 0);
    try std.test.assert_eq(session.queue.size(), 0);
  }

  /** Captures owned event data when queued, independently of subsequent descriptions. */
  test_function payload_is_captured() std.test.AssertionResult<void> {
    var a = make_heap_allocator();
    var renderer = try Recording();
    var session = try ui.Session<i64>(0, view, handler);
    try session.render(renderer);
    try session.tree.enqueue(try session.tree.identity(1), session.queue);
    var next = try ui.View(a);
    try next.button(1, try String("Changed"), 99, 99);
    try session.tree.render(renderer, next);
    try session.dispatch(renderer);
    try std.test.assert_eq(session.state, 1);
  }

  /** Simulates a handler failure after mutating explicitly owned state. */
  function failing(
    state: ref i64,
    event: const ref ui.Event,
    queue: ref ui.EventQueue
  ) SystemResult<void> {
    state += 1;
    return SystemResult.Error(Error(1, "Handler failed"));
  }

  /** Stops and cleans subscriptions on handler failure without pretending to roll back state. */
  test_function handler_error_cleans_up() std.test.AssertionResult<void> {
    var renderer = try Recording();
    var session = try ui.Session<i64>(0, view, failing);
    try session.render(renderer);
    var id = try session.tree.identity(1);
    try session.tree.enqueue(id, session.queue);
    try session.tree.enqueue(id, session.queue);
    try expect_system_error(session.dispatch(renderer));
    try expect_system_error(session.dispatch(renderer));
    try std.test.assert_eq(session.state, 1);
    try std.test.assert_eq(renderer.live, 0);
    try std.test.assert_eq(session.queue.size(), 0);
  }

  /** Exercises storage growth and an empty commit without replacing surviving identities. */
  test_function growing_list_and_empty_commit() std.test.AssertionResult<void> {
    var a = make_heap_allocator();
    var tree = try ui.Tree(a);
    var renderer = try Recording();
    var initial = try ui.View(a);
    for (var i: i64 = 0; i < 40; i += 1) {
      try initial.button(i, try String("Task"), 1, i);
    }
    try tree.render(renderer, initial);
    var retained = try tree.identity(19);
    var reverse = try ui.View(a);
    for (var i: i64 = 39; i >= 0; i -= 1) {
      try reverse.button(i, try String("Task"), 1, i);
    }
    try tree.render(renderer, reverse);
    try std.test.assert_eq(try tree.identity(19), retained);
    try std.test.assert_eq(renderer.created, 40);
    var empty = try ui.View(a);
    try tree.render(renderer, empty);
    try std.test.assert_eq(renderer.live, 0);
    try std.test.assert_eq(renderer.removed, 40);
  }

  /** Applies focus after successful commit and suppresses effects after a failed update. */
  test_function focus_and_failed_update() std.test.AssertionResult<void> {
    var a = make_heap_allocator();
    var tree = try ui.Tree(a);
    var renderer = try Recording();
    var initial = try pair(1, 2);
    initial.focus_key = Option.Some(2);
    try tree.render(renderer, initial);
    var focused = try tree.identity(2);
    try std.test.assert_eq(renderer.focused, focused);
    renderer.fail_update = true;
    var next = try ui.View(a);
    try next.button(1, try String("Changed"), 1, 1);
    next.focus_key = Option.Some(1);
    match tree.render(renderer, next) {
      SystemResult.Ok => {
        try std.test.assert(false);
      },
      SystemResult.Error(_) => {},
      SystemResult.Allocation(error) => {
        return std.test.AssertionResult.Allocation(error);
      },
      SystemResult.InvalidArgument(error) => {
        return std.test.AssertionResult.InvalidArgument(error);
      },
      SystemResult.Overflow(error) => {
        return std.test.AssertionResult.Overflow(error);
      }
    };
    try std.test.assert_eq(renderer.focused, focused);
    try std.test.assert_eq(renderer.live, 0);
  }

  /** Builds independent component scopes with repeated local child keys. */
  function nested(reverse: bool, changed: bool) AllocationResult<ui.View> {
    var a = make_heap_allocator();
    var view = try ui.View(a);
    for (var i: i64 = 0; i < 2; i += 1) {
      var key: i64 = reverse ? 2 - i : i + 1;
      var parent = try view.append(-1, try ui.Element(try ui.Key(key), ui.Kind.Column));

      var child = try ui.Element(
        try ui.Key(try String("local")),
        changed and key == 1 ? ui.Kind.Label : ui.Kind.Button
      );
      child.text = try String("Child");
      child.action = 7;
      child.payload = key;
      try view.append(parent, child);
    }
    return AllocationResult.Ok(view);
  }

  /** Resolves a symbolic child in an integer component scope. */
  function child_identity(tree: const ref ui.Tree, parent: i64) AllocationResult<u64> {
    var a = make_heap_allocator();
    var path = try Vec<ui.Key>(a, 2);
    try path.push(try ui.Key(parent));
    try path.push(try ui.Key(try String("local")));
    return AllocationResult.Ok(tree.identity_path(path));
  }

  /** Reorders whole components while preserving their children, and remounts changed kinds. */
  test_function nested_identity_and_kind() std.test.AssertionResult<void> {
    var a = make_heap_allocator();
    var tree = try ui.Tree(a);
    var renderer = try Recording();
    try tree.render(renderer, try nested(false, false));
    var first = try child_identity(tree, 1);
    var second = try child_identity(tree, 2);
    try std.test.assert(first != second, "local keys are scoped by parent");
    try tree.render(renderer, try nested(true, false));
    try std.test.assert_eq(try child_identity(tree, 1), first);
    try std.test.assert_eq(try child_identity(tree, 2), second);
    try std.test.assert_eq(renderer.created, 4);
    try tree.render(renderer, try nested(false, true));
    try std.test.assert(try child_identity(tree, 1) != first, "kind changes remount");
    try std.test.assert_eq(try child_identity(tree, 2), second);
    try std.test.assert_eq(renderer.removed, 1);
    var queue = try ui.EventQueue(a);
    try tree.enqueue(first, queue);
    try std.test.assert_eq(queue.size(), 0);
  }

  /** Rejects malformed parent relationships before changing native state. */
  test_function nested_validation_is_atomic() std.test.AssertionResult<void> {
    var a = make_heap_allocator();
    var tree = try ui.Tree(a);
    var renderer = try Recording();
    try tree.render(renderer, try nested(false, false));
    var invalid = try nested(false, false);
    invalid.elements[1].parent = 1;
    match tree.render(renderer, invalid) {
      SystemResult.Error(_) => {},
      SystemResult.Allocation(error) => {
        return std.test.AssertionResult.Allocation(error);
      },
      SystemResult.InvalidArgument(error) => {
        return std.test.AssertionResult.InvalidArgument(error);
      },
      SystemResult.Overflow(error) => {
        return std.test.AssertionResult.Overflow(error);
      },
      SystemResult.Ok => {
        try std.test.assert(false, "self parenting must fail");
      }
    };
    try std.test.assert_eq(renderer.created, 4);
    try std.test.assert_eq(renderer.removed, 0);
    try std.test.assert(tree.active(), "validation failure leaves tree usable");
  }

  /** Keeps numeric and symbolic keys distinct even when their spelling matches. */
  test_function key_types_are_distinct() std.test.AssertionResult<void> {
    var a = make_heap_allocator();
    var tree = try ui.Tree(a);
    var renderer = try Recording();
    var view = try ui.View(a);
    try view.append(-1, try ui.Element(try ui.Key(1), ui.Kind.Label));
    try view.append(-1, try ui.Element(try ui.Key(try String("1")), ui.Kind.Label));

    try tree.render(renderer, view);
    var path = try Vec<ui.Key>(a, 1);
    try path.push(try ui.Key(try String("1")));
    try std.test.assert(
      try tree.identity(1) != tree.identity_path(path),
      "key types must not collide"
    );
  }

  /** Checks flat style inheritance and media validation before any renderer changes. */
  test_function media_range_and_flat_styles() std.test.AssertionResult<void> {
    var base = try ui.Style();
    base.normal.border_width = 2;
    base.normal.radius = 8;
    var flat = try ui.Style();
    flat.normal.border_width = 0;
    flat.normal.padding = 12;
    try base.overlay(flat);
    try std.test.assert_eq(base.normal.border_width, 0);
    try std.test.assert_eq(base.normal.radius, 8);
    try std.test.assert_eq(base.normal.padding, 12);
    flat.normal.padding = -2;
    try std.test.assert(not flat.valid());
    var a = make_heap_allocator();
    var tree = try ui.Tree(a);
    var renderer = try Recording();
    var view = try ui.View(a);
    var node = try ui.Element(try ui.Key(1), ui.Kind.Video);
    node.duration = 4000000;
    node.trim_start = 3000000;
    node.trim_end = 1000000;
    try view.append(-1, node);
    match tree.render(renderer, view) {
      SystemResult.Error(_) => {},
      SystemResult.Allocation(error) => {
        return std.test.AssertionResult.Allocation(error);
      },
      SystemResult.InvalidArgument(error) => {
        return std.test.AssertionResult.InvalidArgument(error);
      },
      SystemResult.Overflow(error) => {
        return std.test.AssertionResult.Overflow(error);
      },
      SystemResult.Ok => {
        try std.test.assert(false, "crossed range was accepted");
      }
    };
    try std.test.assert_eq(renderer.created, 0);
    var event = try ui.EventValue(500000, 2000000, 1000000);
    try std.test.assert(event.kind == ui.ValueKind.Range);
    try std.test.assert_eq(event.range_start, 500000);
    return std.test.AssertionResult.Ok;
  }

  /** Resolves nearest resources and applies derived style overrides without changing bases. */
  test_function resources_and_style_precedence() std.test.AssertionResult<void> {
    var a = make_heap_allocator();
    var resources = try ui.Resources(a);
    var base = try ui.Resource(try String("base"), ui.ResourceKind.Style);
    base.style.normal.foreground = 255;
    base.style.normal.font_size = 12;
    try resources.add(0, base);
    var derived = try ui.Resource(try String("primary"), ui.ResourceKind.Style);
    derived.based_on = try String("base");
    derived.style.normal.font_size = 16;
    try resources.add(1, derived);
    var scope = try resources.scope(1);
    var color = try ui.Resource(try String("accent"), ui.ResourceKind.Color);
    color.number = 42;
    try resources.add(0, color);
    var local = try ui.Resource(try String("accent"), ui.ResourceKind.Color);
    local.number = 99;
    try resources.add(scope, local);
    var name = try String("accent");
    try std.test.assert_eq(try resources.number(scope, name, ui.ResourceKind.Color), 99);
    var style_name = try String("primary");
    var style = try resources.style(scope, style_name);
    try std.test.assert_eq(style.normal.foreground, 255);
    try std.test.assert_eq(style.normal.font_size, 16);
    var direct = try ui.Style();
    direct.normal.font_size = 20;
    try style.overlay(direct);
    try std.test.assert_eq(style.normal.font_size, 20);
  }

  /** Rejects resource cycles and type mismatches rather than selecting arbitrary fallbacks. */
  test_function resource_errors() std.test.AssertionResult<void> {
    var a = make_heap_allocator();
    var resources = try ui.Resources(a);
    var first = try ui.Resource(try String("a"), ui.ResourceKind.Color);
    first.reference = try String("b");
    try resources.add(1, first);
    var second = try ui.Resource(try String("b"), ui.ResourceKind.Color);
    second.reference = try String("a");
    try resources.add(1, second);
    var name = try String("a");
    match resources.number(1, name, ui.ResourceKind.Color) {
