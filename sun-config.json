{
  "root": true,
  "path_variables": {
    "SUN_UI_BUILD": "build",
    "GRAPHICS_NATIVE_SOURCE": "src/graphics/native",
    "GRAPHICS_NATIVE_OUTPUT": "build/graphics-native",
    "GRAPHICS_EXECUTOR_SOURCE": "src/graphics/native/graphics.c",
    "GRAPHICS_EXECUTOR_OUTPUT": "build/graphics-native/libsun_ui_graphics.a",
    "GRAPHICS_SDL_SOURCE": "src/adapters/sdl/native.c",
    "GRAPHICS_SDL_OUTPUT": "build/graphics-native/libsun_ui_sdl.a",
    "GRAPHICS_TEST_INPUT_SOURCE": "tests/graphics/input.c",
    "GRAPHICS_TEST_INPUT_OUTPUT": "build/graphics-native/libgraphics_test_input.a"
  },
  "entrypoints": [
    {
      "name": "sun_ui",
      "path": "src/ui.sun",
      "type": "library",
      "export": true,
      "compile_args": [
        "--dynamic"
      ]
    },
    {
      "name": "sun_plot",
      "path": "src/plot/plot.sun",
      "type": "library",
      "export": true,
      "requires": [
        "sun_ui"
      ],
      "compile_args": [
        "--dynamic"
      ]
    },
    {
      "name": "sun_ui_tests",
      "path": "tests/main.sun",
      "type": "binary",
      "export": false
    },
    {
      "name": "sun_plot_tests",
      "path": "tests/plot/main.sun",
      "type": "binary",
      "export": false
    },
    {
      "name": "sun_ui_gtk",
      "path": "src/adapters/gtk/renderer.sun",
      "type": "library",
      "export": true,
      "requires": [
        "sun_ui"
      ],
      "compile_args": [
        "--dynamic"
      ]
    },
    {
      "name": "sun_ui_gtk_drawing",
      "path": "src/adapters/gtk/drawing.sun",
      "type": "library",
      "export": true,
      "requires": [
        "sun_ui",
        "sun_ui_gtk"
      ],
      "compile_args": [
        "--dynamic"
      ]
    },
    {
      "name": "counter",
      "path": "examples/counter/main.sun",
      "type": "binary",
      "export": false
    },
    {
      "name": "tasks",
      "path": "examples/tasks/main.sun",
      "type": "binary",
      "export": false
    },
    {
      "name": "plot_export",
      "path": "examples/plot-export/main.sun",
      "type": "binary",
      "export": false
    },
    {
      "name": "plot_viewer",
      "path": "examples/plot-viewer/main.sun",
      "type": "binary",
      "export": false
    },
    {
      "name": "sun_viewc",
      "path": "src/tools/viewc.sun",
      "type": "binary",
      "export": true,
      "requires": [
        "sun_ui"
      ],
      "compile_args": [
        "--dynamic"
      ]
    },
    {
      "name": "xml_probe",
      "path": "src/tools/xml_probe.sun",
      "type": "binary",
      "export": false
    },
    {
      "name": "markup_tests",
      "path": "tests/markup/main.sun",
      "type": "binary",
      "export": false
    },
    {
      "name": "generated_view_tests",
      "path": "tests/markup/generated.sun",
      "type": "binary",
      "export": false
    },
    {
      "name": "counter_xml",
      "path": "examples/counter-xml/main.sun",
      "type": "binary",
      "export": false
    },
    {
      "name": "tasks_xml",
      "path": "examples/tasks-xml/main.sun",
      "type": "binary",
      "export": false
    },
    {
      "name": "forms_xml",
      "path": "examples/forms/main.sun",
      "type": "binary",
      "export": false
    },
    {
      "name": "sun_ui_build",
      "path": "src/tools/build.sun",
      "type": "binary",
      "export": false
    },
    {
      "name": "release_package_tool",
      "path": "src/tools/package.sun",
      "type": "binary",
      "export": false
    },
    {
      "name": "sun_ui_graphics",
      "path": "src/graphics/graphics.sun",
      "type": "library",
      "export": true,
      "compile_args": [
        "--dynamic"
      ],
      "steps": [
        "graphics_native"
      ]
    },
    {
      "name": "sun_ui_graphics_gtk",
      "path": "src/graphics/gtk.sun",
      "type": "library",
      "export": true,
      "compile_args": [
        "--dynamic"
      ],
      "requires": [
        "sun_ui_graphics"
      ]
    },
    {
      "name": "sun_ui_sdl",
      "path": "src/adapters/sdl/window.sun",
      "type": "library",
      "export": true,
      "compile_args": [
        "--dynamic"
      ],
      "requires": [
        "sun_ui_graphics"
      ]
    },
    {
      "name": "graphics_tests",
      "path": "tests/graphics/main.sun",
      "type": "binary",
      "export": false
    },
    {
      "name": "graphics",
      "path": "examples/graphics/main.sun",
      "type": "binary",
      "export": false
    },
    {
      "name": "drawing_controls",
      "path": "examples/drawing-controls/main.sun",
      "type": "binary",
      "export": false
    }
  ],
  "package_id": "namo-robotics/sun_ui",
  "dependencies": [
    {
      "target": {
        "x86_64-linux-gnu": {
          "package": "namo-robotics/sun_gobject",
          "library": "namo-robotics/sun_gobject",
          "url": "https://github.com/namo-robotics/sun_gobject/releases/download/dev/sun_gobject-x86_64-linux-gnu.moon"
        },
        "arm64-apple-darwin": {
          "package": "namo-robotics/sun_gobject",
          "library": "namo-robotics/sun_gobject",
          "url": "https://github.com/namo-robotics/sun_gobject/releases/download/dev/sun_gobject-arm64-apple-darwin.moon"
        }
      }
    },
    {
      "target": {
        "x86_64-linux-gnu": {
          "package": "namo-robotics/sun_gobject",
          "library": "namo-robotics/sun_gtk",
          "url": "https://github.com/namo-robotics/sun_gobject/releases/download/dev/sun_gtk-x86_64-linux-gnu.moon"
        },
        "arm64-apple-darwin": {
          "package": "namo-robotics/sun_gobject",
          "library": "namo-robotics/sun_gtk",
          "url": "https://github.com/namo-robotics/sun_gobject/releases/download/dev/sun_gtk-arm64-apple-darwin.moon"
        }
      }
    }
  ],
  "exports": [
    {
      "path": "LICENSE",
      "destination": "share/sun_ui/LICENSE"
    }
  ],
  "steps": [
    {
      "name": "graphics_configure",
      "command": [
        "cmake",
        "-S",
        "src/graphics/native",
        "-B",
        "${SUN_BUILD}/graphics-native",
        "-DBUILD_SDL_HOST=ON"
      ],
      "inputs": [
        "src/graphics/native/CMakeLists.txt"
      ],
      "outputs": [
        "${SUN_BUILD}/graphics-native/CMakeCache.txt"
      ]
    },
    {
      "name": "graphics_native",
      "requires": [
        "graphics_configure"
      ],
      "command": [
        "cmake",
        "--build",
        "${SUN_BUILD}/graphics-native",
        "--parallel",
        "1"
      ],
      "inputs": [
        "src/graphics/native",
        "src/adapters/sdl/native.c"
      ],
      "outputs": [
        "${SUN_BUILD}/graphics-native/libsun_ui_graphics.a",
        "${SUN_BUILD}/graphics-native/libsun_ui_sdl.a"
      ]
    }
  ],
  "packages": [
    {
      "name": "sun_ui",
      "entrypoints": [
        "sun_ui",
        "sun_plot",
        "sun_ui_gtk",
        "sun_ui_gtk_drawing",
        "sun_ui_graphics",
        "sun_ui_graphics_gtk",
        "sun_ui_sdl",
        "sun_viewc"
      ],
      "resources": [
        {
          "path": "LICENSE",
          "destination": "share/sun_ui/LICENSE"
        },
        {
          "path": "${SUN_BUILD}/graphics-native/libsun_ui_graphics.a",
          "destination": "lib/native/libsun_ui_graphics.a"
        },
        {
          "path": "${SUN_BUILD}/graphics-native/libsun_ui_sdl.a",
          "destination": "lib/native/libsun_ui_sdl.a"
        }
      ]
    }
  ]
}
