{
  "package_id": "namo-robotics/sun_ui",
  "root": true,
  "path_variables": {
    "GRAPHICS_NATIVE_SOURCE": "src/graphics/native",
    "GRAPHICS_NATIVE_OUTPUT": "${SUN_BUILD}/graphics-native",
    "GRAPHICS_EXECUTOR_SOURCE": "src/graphics/native/graphics.c",
    "GRAPHICS_EXECUTOR_OUTPUT": "${SUN_BUILD}/graphics-native/libsun_ui_graphics.a",
    "GRAPHICS_SDL_SOURCE": "src/adapters/sdl/native.c",
    "GRAPHICS_SDL_OUTPUT": "${SUN_BUILD}/graphics-native/libsun_ui_sdl.a",
    "GRAPHICS_TEST_INPUT_SOURCE": "tests/graphics/input.c",
    "GRAPHICS_TEST_INPUT_OUTPUT": "${SUN_BUILD}/graphics-native/libgraphics_test_input.a"
  },
  "entrypoints": [
    {
      "name": "sun_ui",
      "path": "src/ui.sun",
      "type": "library",
      "export": true
    },
    {
      "name": "sun_plot",
      "path": "src/plot/plot.sun",
      "type": "library",
      "export": true,
      "requires": [
        "sun_ui"
      ]
    },
    {
      "name": "sun_ui_tests",
      "path": "tests/main.sun",
      "type": "binary",
      "export": false,
      "requires": [
        "sun_ui"
      ]
    },
    {
      "name": "sun_plot_tests",
      "path": "tests/plot/main.sun",
      "type": "binary",
      "export": false,
      "requires": [
        "sun_plot"
      ]
    },
    {
      "name": "sun_ui_gtk",
      "path": "src/adapters/gtk/renderer.sun",
      "type": "library",
      "export": true,
      "compile_args": [
        "--dynamic"
      ],
      "requires": [
        "sun_ui"
      ]
    },
    {
      "name": "sun_ui_gtk_drawing",
      "path": "src/adapters/gtk/drawing.sun",
      "type": "library",
      "export": true,
      "compile_args": [
        "--dynamic"
      ],
      "requires": [
        "sun_ui",
        "sun_ui_gtk"
      ]
    },
    {
      "name": "counter",
      "path": "examples/counter/main.sun",
      "type": "binary",
      "export": false,
      "compile_args": [
        "--dynamic",
        "-lm"
      ],
      "requires": [
        "sun_ui_gtk"
      ],
      "pkg_config": [
        "gtk4",
        "gio-2.0",
        "librsvg-2.0"
      ]
    },
    {
      "name": "tasks",
      "path": "examples/tasks/main.sun",
      "type": "binary",
      "export": false,
      "compile_args": [
        "--dynamic",
        "-lm"
      ],
      "requires": [
        "sun_ui_gtk"
      ],
      "pkg_config": [
        "gtk4",
        "gio-2.0",
        "librsvg-2.0"
      ]
    },
    {
      "name": "plot_export",
      "path": "examples/plot-export/main.sun",
      "type": "binary",
      "export": false,
      "requires": [
        "sun_plot"
      ]
    },
    {
      "name": "plot_viewer",
      "path": "examples/plot-viewer/main.sun",
      "type": "binary",
      "export": false,
      "compile_args": [
        "--dynamic",
        "-lm"
      ],
      "requires": [
        "sun_plot",
        "sun_ui_gtk_drawing"
      ],
      "pkg_config": [
        "gtk4",
        "gio-2.0",
        "librsvg-2.0"
      ]
    },
    {
      "name": "sun_viewc",
      "path": "src/tools/viewc.sun",
      "type": "binary",
      "export": true,
      "requires": [
        "sun_ui"
      ]
    },
    {
      "name": "markup_tests",
      "path": "tests/markup/main.sun",
      "type": "binary",
      "export": false,
      "build": [
        "scripts/build-markup-tests.sh"
      ],
      "requires": [
        "sun_viewc"
      ]
    },
    {
      "name": "generated_view_tests",
      "path": "tests/markup/generated.sun",
      "type": "binary",
      "export": false,
      "steps": [
        "generated_views"
      ],
      "requires": [
        "sun_viewc"
      ]
    },
    {
      "name": "counter_xml",
      "path": "examples/counter-xml/main.sun",
      "type": "binary",
      "export": false,
      "steps": [
        "generated_views"
      ],
      "compile_args": [
        "--dynamic",
        "-lm"
      ],
      "requires": [
        "sun_viewc",
        "sun_ui_gtk"
      ],
      "pkg_config": [
        "gtk4",
        "gio-2.0",
        "librsvg-2.0"
      ]
    },
    {
      "name": "tasks_xml",
      "path": "examples/tasks-xml/main.sun",
      "type": "binary",
      "export": false,
      "steps": [
        "generated_views"
      ],
      "compile_args": [
        "--dynamic",
        "-lm"
      ],
      "requires": [
        "sun_viewc",
        "sun_ui_gtk"
      ],
      "pkg_config": [
        "gtk4",
        "gio-2.0",
        "librsvg-2.0"
      ]
    },
    {
      "name": "forms_xml",
      "path": "examples/forms/main.sun",
      "type": "binary",
      "export": false,
      "steps": [
        "generated_views"
      ],
      "compile_args": [
        "--dynamic",
        "-lm"
      ],
      "requires": [
        "sun_viewc",
        "sun_ui_gtk"
      ],
      "pkg_config": [
        "gtk4",
        "gio-2.0",
        "librsvg-2.0"
      ]
    },
    {
      "name": "sun_ui_build",
      "path": "src/tools/build.sun",
      "type": "binary",
      "export": false
    },
    {
      "name": "release_package_tool",
      "path": "src/tools/package.sun",
      "type": "binary",
      "export": false
    },
    {
      "name": "sun_ui_graphics",
      "path": "src/graphics/graphics.sun",
      "type": "library",
      "export": true,
      "steps": [
        "graphics_native"
      ],
      "compile_args": [
        "--dynamic"
      ]
    },
    {
      "name": "sun_ui_graphics_gtk",
      "path": "src/graphics/gtk.sun",
      "type": "library",
      "export": true,
      "compile_args": [
        "--dynamic"
      ],
      "requires": [
        "sun_ui_graphics",
        "sun_ui_gtk"
      ]
    },
    {
      "name": "sun_ui_sdl",
      "path": "src/adapters/sdl/window.sun",
      "type": "library",
      "export": true,
      "compile_args": [
        "--dynamic"
      ],
      "requires": [
        "sun_ui_graphics"
      ]
    },
    {
      "name": "graphics_tests",
      "path": "tests/graphics/main.sun",
      "type": "binary",
      "export": false,
      "steps": [
        "graphics_test_native"
      ],
      "compile_args": [
        "--dynamic",
        "-L${SUN_BUILD}/graphics-native",
        "-lsun_ui_sdl",
        "-lsun_ui_graphics",
        "-lm",
        "-lgraphics_test_input"
      ],
      "requires": [
        "sun_ui_graphics_gtk",
        "sun_ui_sdl"
      ],
      "pkg_config": [
        "gtk4",
        "gio-2.0",
        "librsvg-2.0",
        "sdl3",
        "epoxy"
      ]
    },
    {
      "name": "graphics",
      "path": "examples/graphics/main.sun",
      "type": "binary",
      "export": false,
      "compile_args": [
        "--dynamic",
        "-L${SUN_BUILD}/graphics-native",
        "-lsun_ui_sdl",
        "-lsun_ui_graphics",
        "-lm"
      ],
      "requires": [
        "sun_ui_graphics_gtk",
        "sun_ui_sdl"
      ],
      "pkg_config": [
        "gtk4",
        "gio-2.0",
        "librsvg-2.0",
        "sdl3",
        "epoxy"
      ]
    },
    {
      "name": "drawing_controls",
      "path": "examples/drawing-controls/main.sun",
      "type": "binary",
      "export": false,
      "compile_args": [
        "--dynamic",
        "-lm"
      ],
      "requires": [
        "sun_ui_gtk"
      ],
      "pkg_config": [
        "gtk4",
        "gio-2.0",
        "librsvg-2.0"
      ]
    }
  ],
  "packages": [
    {
      "name": "sun_ui",
      "entrypoints": [
        "sun_ui",
        "sun_plot",
        "sun_ui_gtk",
        "sun_ui_gtk_drawing",
        "sun_ui_graphics",
        "sun_ui_graphics_gtk",
        "sun_ui_sdl",
        "sun_viewc"
      ],
      "resources": [
        {
          "path": "LICENSE",
          "destination": "share/sun_ui/LICENSE"
        },
        {
          "path": "${SUN_BUILD}/graphics-native/libsun_ui_graphics.a",
          "destination": "lib/native/libsun_ui_graphics.a"
        },
        {
          "path": "${SUN_BUILD}/graphics-native/libsun_ui_sdl.a",
          "destination": "lib/native/libsun_ui_sdl.a"
        }
      ]
    }
  ],
  "exports": [
    {
      "path": "LICENSE",
      "destination": "share/sun_ui/LICENSE"
    }
  ],
  "dependencies": [
    {
      "type": "system",
      "check": {
        "type": "pkg-config",
        "version": ">=3.2",
        "name": "sdl3"
      },
      "target": {
        "linux": {
          "apt": [
            "libsdl3-dev"
          ]
        },
        "macos": {
          "brew": [
            "sdl3"
          ]
        }
      }
    },
    {
      "type": "git",
      "url": "git@github.com:namo-robotics/sun_gobject.git",
      "version": "main",
      "packages": {
        "namo-robotics/sun_gobject": {
          "entrypoints": [
            "sun_gobject",
            "sun_gtk"
          ]
        }
      },
      "supported_targets": [
        "x86_64-linux-gnu",
        "arm64-apple-darwin"
      ]
    }
  ],
  "steps": [
    {
      "name": "graphics_configure",
      "command": [
        "cmake",
        "-S",
        "src/graphics/native",
        "-B",
        "${SUN_BUILD}/graphics-native",
        "-DBUILD_SDL_HOST=ON",
        "-DBUILD_GRAPHICS_TESTS=ON"
      ],
      "inputs": [
        "src/graphics/native/CMakeLists.txt"
      ],
      "outputs": [
        "${SUN_BUILD}/graphics-native/CMakeCache.txt"
      ]
    },
    {
      "name": "graphics_native",
      "command": [
        "cmake",
        "--build",
        "${SUN_BUILD}/graphics-native",
        "--parallel",
        "1"
      ],
      "inputs": [
        "src/graphics/native",
        "src/adapters/sdl/native.c"
      ],
      "outputs": [
        "${SUN_BUILD}/graphics-native/libsun_ui_graphics.a",
        "${SUN_BUILD}/graphics-native/libsun_ui_sdl.a"
      ],
      "requires": [
        "graphics_configure"
      ]
    },
    {
      "name": "graphics_test_native",
      "command": [
        "cmake",
        "--build",
        "${SUN_BUILD}/graphics-native",
        "--target",
        "graphics_test_input",
        "--parallel",
        "1"
      ],
      "inputs": [
        "tests/graphics/input.c"
      ],
      "outputs": [
        "${SUN_BUILD}/graphics-native/libgraphics_test_input.a"
      ],
      "requires": [
        "graphics_configure"
      ]
    },
    {
      "name": "generated_views",
      "command": [
        "bash",
        "scripts/generate-configured-views.sh",
        "${SUN_BUILD}/sun_viewc",
        "${SUN_BUILD}"
      ],
      "inputs": [
        "scripts/generate-configured-views.sh",
        "examples",
        "tests/markup",
        "${SUN_BUILD}/sun_viewc"
      ],
      "outputs": [
        "${SUN_BUILD}/generated/examples/counter-xml/counter.view.sun",
        "${SUN_BUILD}/generated/examples/tasks-xml/tasks.view.sun",
        "${SUN_BUILD}/generated/examples/forms/forms.view.sun",
        "${SUN_BUILD}/generated/tests/markup/scoped.view.sun",
        "${SUN_BUILD}/generated/tests/markup/actions.view.sun",
        "${SUN_BUILD}/generated/tests/markup/reusable.view.sun"
      ]
    }
  ]
}
