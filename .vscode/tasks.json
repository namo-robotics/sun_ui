{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bootstrap Sun",
      "type": "shell",
      "command": "./scripts/bootstrap-sun.sh",
      "problemMatcher": []
    },
    {
      "label": "Build and test",
      "type": "shell",
      "command": "./build.sh",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "sun src/tools/build.sun -- test",
      "problemMatcher": []
    },
    {
      "label": "Build Sun",
      "type": "shell",
      "command": "sun src/tools/build.sun -- build",
      "problemMatcher": []
    },
    {
      "label": "Build and test GTK",
      "type": "shell",
      "command": "./build.sh --gtk",
      "problemMatcher": []
    },
    {
      "label": "Counter",
      "type": "shell",
      "command": "\"$(sun describe --config sun-config.json --field build_root)/counter\"",
      "problemMatcher": []
    },
    {
      "label": "Keyed tasks",
      "type": "shell",
      "command": "\"$(sun describe --config sun-config.json --field build_root)/tasks\"",
      "problemMatcher": []
    },
    {
      "label": "Build video editor",
      "type": "shell",
      "command": "./src/sun_video_editor/build.sh --build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
