{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Counter",
      "type": "lldb-dap",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "launchCommands": [
        "script import os, subprocess; lldb.debugger.CreateTarget(os.path.join(subprocess.check_output([os.environ.get('SUN_EXECUTABLE', 'sun'), 'describe', '--config', '${workspaceFolder}/sun-config.json', '--field', 'build_root'], text=True).strip(), 'counter'))",
        "process launch -s --working-dir \"${workspaceFolder}\""
      ]
    }
  ]
}
