using std;

/** Resolves typed presentation resources without native handles or state borrows. */
public module ui {

  /** Stores optional appearance properties for one interaction state. */
  public class Appearance {
    public var foreground: i64 = -1;
    public var background: i64 = -1;
    public var font: String;
    public var font_size: i32 = -1;
    public var border_width: i32 = -1;
    public var radius: i32 = -1;
    public var padding: i32 = -1;

    /** Creates an empty override; colors use packed RGB values. */
    init() AllocationResult<void> {
      this.font = try String("");
    }

    /** Copies only explicitly supplied properties from a higher-precedence appearance. */
    public method overlay(other: const ref Appearance) AllocationResult<void> {
      var a = make_heap_allocator();
      if (other.foreground >= 0) {
        this.foreground = other.foreground;
      }
      if (other.background >= 0) {
        this.background = other.background;
      }
      if (not other.font.is_empty()) {
        this.font = try other.font.clone(a);
      }
      if (other.border_width >= 0) {
        this.border_width = other.border_width;
      }
      if (other.radius >= 0) {
        this.radius = other.radius;
      }
      if (other.padding >= 0) {
        this.padding = other.padding;
      }
      if (other.font_size >= 0) {
        this.font_size = other.font_size;
      }

      return AllocationResult.Ok;
    }

    /** Compares resolved properties without allocating. */
    public const method equals(other: const ref Appearance) bool {
      return this.foreground == other.foreground and this.background == other.background and
        this.font.equals(other.font) and this.font_size == other.font_size and
        this.border_width == other.border_width and this.radius == other.radius and
        this.padding == other.padding;
    }

    /** Rejects invalid colors, sizes, or font text before rendering. */
    public const method valid() bool {
      if (this.border_width < -1 or this.radius < -1 or this.padding < -1 or this.foreground < -1 or
        this.foreground > 16777215 or this.background < -1 or this.background > 16777215 or
        this.font_size < -1 or this.font_size == 0) {
        return false;
      }
      for (var i: i64 = 0; i < this.font.length(); i += 1) {
        var c = match this.font.at(i) {
          AccessResult.Ok(c) => c,
          AccessResult.OutOfBounds(_) => 0
        };
        if (c < 32 or c == 34 or c == 42 or c == 92) {
          return false;
        }
      }
      return true;
    }
  }

  /** Owns normal and interaction-state overrides for one control. */
  public class Style {
    public var normal: Appearance;
    public var hover: Appearance;
    public var focus: Appearance;
    public var disabled: Appearance;

    /** Creates an empty style that inherits native defaults. */
    init() AllocationResult<void> {
      this.normal = try Appearance();
      this.hover = try Appearance();
      this.focus = try Appearance();
      this.disabled = try Appearance();
    }

    /** Applies a higher-precedence style without retaining references. */
    public method overlay(other: const ref Style) AllocationResult<void> {
      try this.normal.overlay(other.normal);
      try this.hover.overlay(other.hover);
      try this.focus.overlay(other.focus);
      try this.disabled.overlay(other.disabled);

      return AllocationResult.Ok;
    }

    /** Compares all interaction states. */
    public const method equals(other: const ref Style) bool {
      return this.normal.equals(other.normal) and this.hover.equals(other.hover) and
        this.focus.equals(other.focus) and this.disabled.equals(other.disabled);
    }

    /** Validates every appearance before renderer mutation. */
    public const method valid() bool {
      return this.normal.valid() and this.hover.valid() and this.focus.valid() and
        this.disabled.valid();
    }
  }

  /** Distinguishes resource types so references cannot silently change meaning. */
  public enum ResourceKind { Color, Font, Spacing, Style, Template, Theme }

  /** Records typed palette references for one resource appearance. */
  public class AppearanceReferences {
    public var foreground: String;
    public var background: String;
    public var font: String;
    public var font_size: String;
    public var border_width: String;
    public var radius: String;
    public var padding: String;

    /** Creates an appearance without palette references. */
    init() AllocationResult<void> {
      this.foreground = try String("");
      this.background = try String("");
      this.font = try String("");
      this.font_size = try String("");
      this.border_width = try String("");
      this.radius = try String("");
      this.padding = try String("");
    }
  }

  /** Associates a control kind with its resolved default style. */
  public class ThemeDefault {
    public var kind: Kind;
    public var style: Style;

    /** Transfers an owned style for one control kind. */
    init(kind: Kind, style: Style) {
      this.kind = kind;
      this.style = style;
    }
  }

  /** Owns a base appearance and explicit defaults for native control kinds. */
  public class Theme {
    public var base: Style;
    public var defaults: Vec<ThemeDefault>;

    /** Allocates an empty theme without replacing native defaults. */
    init(a: const ref HeapAllocator) AllocationResult<void> {
      this.base = try Style();

      this.defaults = try Vec<ThemeDefault>(a, 4);
    }

    /** Rejects duplicate defaults and invalid appearances. */
    public const method validate() SystemResult<void> {
      if (not this.base.valid()) {
        return SystemResult.Error(Error(1, "Invalid theme base"));
      }
      return validate_theme_defaults(this.defaults);
    }
  }

  /** Validates control defaults even when a handwritten view supplies them directly. */
  function validate_theme_defaults(defaults: const ref Vec<ThemeDefault>) SystemResult<void> {
    for (var i: i64 = 0; i < defaults.size(); i += 1) {
      if (defaults[i].kind == Kind.Group or not defaults[i].style.valid()) {
        return SystemResult.Error(Error(1, "Invalid theme default"));
      }
      for (var j: i64 = 0; j < i; j += 1) {
        if (defaults[j].kind == defaults[i].kind) {
          return SystemResult.Error(Error(1, "Duplicate theme control kind"));
        }
      }
    }
    return SystemResult.Ok;
  }

  /** Names a style used by one control kind in a theme resource. */
  public class ThemeReference {
    public var kind: Kind;
    public var name: String;

    /** Transfers the referenced style name. */
    init(kind: Kind, name: String) {
      this.kind = kind;
      this.name = name;
    }
  }

  /** Owns one typed resource, optional alias, or inherited style. */
  public class Resource {
    public var name: String;
    public var kind: ResourceKind;
    public var number: i64 = 0;
    public var text: String;
    public var style: Style;
    public var reference: String;
    public var based_on: String;
    public var normal_references: AppearanceReferences;
    public var hover_references: AppearanceReferences;
    public var focus_references: AppearanceReferences;
    public var disabled_references: AppearanceReferences;
    public var defaults: Vec<ThemeReference>;
    var scope: i64 = 0;

    /** Transfers the resource name into a typed definition. */
    init(name: String, kind: ResourceKind) AllocationResult<void> {
      this.style = try Style();

      this.normal_references = try AppearanceReferences();
      this.hover_references = try AppearanceReferences();
      this.focus_references = try AppearanceReferences();
      this.disabled_references = try AppearanceReferences();

      this.text = try String("");
      this.reference = try String("");
      this.based_on = try String("");
      this.defaults = try Vec<ThemeReference>(make_heap_allocator(), 4);

      this.name = name;
      this.kind = kind;
    }
  }

  /** Owns nested dictionaries with theme then application fallback scopes. */
  public class Resources {
    var entries: Vec<Resource>;
    var parents: Vec<i64>;

    /** Creates theme scope zero and application scope one. */
    init(a: const ref HeapAllocator) AllocationResult<void> {
      this.entries = try Vec<Resource>(a, 8);
      this.parents = try Vec<i64>(a, 4);
      try this.parents.push(-1);
      try this.parents.push(0);
    }

    /** Creates a component dictionary with an explicitly selected enclosing scope. */
    public method scope(parent: i64) SystemResult<i64> {
      if (parent < 0 or parent >= this.parents.size()) {
        return SystemResult.Error(Error(1, "Invalid resource parent scope"));
      }
      var index = this.parents.size();
      try this.parents.push(parent);
      return SystemResult.Ok(index);
    }

    /** Adds an owned definition after rejecting duplicates within the dictionary. */
    public method add(scope: i64, resource: Resource) SystemResult<void> {
      if (scope < 0 or scope >= this.parents.size() or resource.name.is_empty()) {
        return SystemResult.Error(Error(1, "Invalid resource declaration"));
      }
      for (var i: i64 = 0; i < this.entries.size(); i += 1) {
        if (this.entries[i].scope == scope and this.entries[i].name.equals(resource.name)) {
          return SystemResult.Error(Error(1, "Duplicate resource name"));
        }
      }
      resource.scope = scope;
      try this.entries.push(resource);
      return SystemResult.Ok;
    }

    /** Finds the nearest visible definition without following references. */
    const method find(scope: i64, name: const ref String) i64 {
      var current = scope;
      while (current >= 0 and current < this.parents.size()) {
        for (var i: i64 = 0; i < this.entries.size(); i += 1) {
          if (this.entries[i].scope == current and this.entries[i].name.equals(name)) {
            return i;
          }
        }
        current = this.parents[current];
      }
      return -1;
    }

    /** Resolves aliases with bounded traversal and strict resource type checking. */
    const method resolve(scope: i64, name: const ref String, kind: ResourceKind) SystemResult<i64> {
      var index = this.find(scope, name);
      for (var count: i64 = 0; count <= this.entries.size(); count += 1) {
        if (index < 0) {
          return SystemResult.Error(Error(1, "Missing resource"));
        }
        if (this.entries[index].kind != kind) {
          return SystemResult.Error(Error(1, "Resource type mismatch"));
        }
        if (this.entries[index].reference.is_empty()) {
          return SystemResult.Ok(index);
        }
        index = this.find(this.entries[index].scope, this.entries[index].reference);
      }
      return SystemResult.Error(Error(1, "Resource reference cycle"));
    }

    /** Validates every definition, including unused aliases and inherited styles. */
    public const method validate() SystemResult<void> {
      var a = make_heap_allocator();
      for (var i: i64 = 0; i < this.entries.size(); i += 1) {
        var resource = this.entries[i];
        var index = try this.resolve(resource.scope, resource.name, resource.kind);
        if (resource.kind == ResourceKind.Style) {
          var value = try this.style(resource.scope, resource.name);
        } else if (resource.kind == ResourceKind.Theme) {
          var value = try this.theme(resource.scope, resource.name);
        } else if (resource.kind == ResourceKind.Color or resource.kind == ResourceKind.Spacing) {
          var value = try this.number(resource.scope, resource.name, resource.kind);
        } else {
          if (this.entries[index].text.is_empty()) {
            return SystemResult.Error(Error(1, "Empty text resource"));
          }
          if (resource.kind == ResourceKind.Font) {
            var appearance = try Appearance();
            appearance.font = try this.entries[index].text.clone(a);
            if (not appearance.valid()) {
              return SystemResult.Error(Error(1, "Invalid font resource"));
            }
          }
        }
      }
      return SystemResult.Ok;
    }

    /** Resolves a color or spacing value without implicit conversion. */
    public const method number(
      scope: i64,
      name: const ref String,
      kind: ResourceKind
    ) SystemResult<i64> {
      if (kind != ResourceKind.Color and kind != ResourceKind.Spacing) {
        return SystemResult.Error(Error(1, "Resource is not numeric"));
      }
      var i = try this.resolve(scope, name, kind);
      var value = this.entries[i].number;
      if (value < 0 or (kind == ResourceKind.Color and value > 16777215)) {
        return SystemResult.Error(Error(1, "Invalid numeric resource"));
      }
      return SystemResult.Ok(value);
    }

    /** Explicitly copies a font or template name from a resolved resource. */
    public const method text(
      scope: i64,
      name: const ref String,
      kind: ResourceKind
    ) SystemResult<String> {
      if (kind != ResourceKind.Font and kind != ResourceKind.Template) {
        return SystemResult.Error(Error(1, "Resource is not text"));
      }
      var a = make_heap_allocator();
      var i = try this.resolve(scope, name, kind);
      return SystemResult.Ok(try this.entries[i].text.clone(a));
    }

    /** Resolves a palette-backed appearance in the dictionary that defines it. */
    const method appearance(
      scope: i64,
      value: const ref Appearance,
      references: const ref AppearanceReferences
    ) SystemResult<Appearance> {
      var result = try Appearance();
      try result.overlay(value);
      if (not references.foreground.is_empty()) {
        if (value.foreground >= 0) {
          return SystemResult.Error(Error(1, "Conflicting appearance value and resource"));
        }
        var number = try this.number(scope, references.foreground, ResourceKind.Color);
        result.foreground = number;
      }
      if (not references.background.is_empty()) {
        if (value.background >= 0) {
          return SystemResult.Error(Error(1, "Conflicting appearance value and resource"));
        }
        var number = try this.number(scope, references.background, ResourceKind.Color);
        result.background = number;
      }
      if (not references.font.is_empty()) {
        if (not value.font.is_empty()) {
          return SystemResult.Error(Error(1, "Conflicting appearance value and resource"));
        }
        result.font = try this.text(scope, references.font, ResourceKind.Font);
      }
      if (not references.font_size.is_empty()) {
        if (value.font_size >= 0) {
          return SystemResult.Error(Error(1, "Conflicting appearance value and resource"));
        }
        var number = try this.number(scope, references.font_size, ResourceKind.Spacing);
        if (number > 2147483647) {
          return SystemResult.Error(Error(1, "Appearance resource exceeds integer range"));
        }
        result.font_size = _convert<i32>(number);
      }
      if (not references.border_width.is_empty()) {
        if (value.border_width >= 0) {
          return SystemResult.Error(Error(1, "Conflicting appearance value and resource"));
        }
        var number = try this.number(scope, references.border_width, ResourceKind.Spacing);
        if (number > 2147483647) {
          return SystemResult.Error(Error(1, "Appearance resource exceeds integer range"));
        }
        result.border_width = _convert<i32>(number);
      }
      if (not references.radius.is_empty()) {
        if (value.radius >= 0) {
          return SystemResult.Error(Error(1, "Conflicting appearance value and resource"));
        }
        var number = try this.number(scope, references.radius, ResourceKind.Spacing);
        if (number > 2147483647) {
          return SystemResult.Error(Error(1, "Appearance resource exceeds integer range"));
        }
        result.radius = _convert<i32>(number);
      }
      if (not references.padding.is_empty()) {
        if (value.padding >= 0) {
          return SystemResult.Error(Error(1, "Conflicting appearance value and resource"));
        }
        var number = try this.number(scope, references.padding, ResourceKind.Spacing);
        if (number > 2147483647) {
          return SystemResult.Error(Error(1, "Appearance resource exceeds integer range"));
        }
        result.padding = _convert<i32>(number);
      }
      if (not result.valid()) {
        return SystemResult.Error(Error(1, "Invalid resolved appearance"));
      }
      return SystemResult.Ok(result);
    }

    /** Resolves all defaults using the theme resource's defining dictionary. */
    public const method theme(scope: i64, name: const ref String) SystemResult<Theme> {
      var i = try this.resolve(scope, name, ResourceKind.Theme);
      var resource = this.entries[i];
      var result = try Theme(make_heap_allocator());
      if (not resource.based_on.is_empty()) {
        result.base = try this.style(resource.scope, resource.based_on);
      }
      for (var entry: ref ThemeReference in resource.defaults) {
        try result.defaults.push(
          ThemeDefault(entry.kind, try this.style(resource.scope, entry.name))
        );
      }
      try result.validate();
      return SystemResult.Ok(result);
    }

    /** Resolves a style's inheritance chain from base to derived. */
    public const method style(scope: i64, name: const ref String) SystemResult<Style> {
      var a = make_heap_allocator();
      var chain = try Vec<i64>(a, 4);
      var i = try this.resolve(scope, name, ResourceKind.Style);
      while (true) {
        for (var j: i64 = 0; j < chain.size(); j += 1) {
          if (chain[j] == i) {
            return SystemResult.Error(Error(1, "Style inheritance cycle"));
          }
        }
        try chain.push(i);
        if (this.entries[i].based_on.is_empty()) {
          break;
        }
        i = try this.resolve(this.entries[i].scope, this.entries[i].based_on, ResourceKind.Style);
      }
      var result = try Style();
      for (var j = chain.size() - 1; j >= 0; j -= 1) {
        var resource = this.entries[chain[j]];
        var resolved = try Style();
        resolved.normal = try this.appearance(
          resource.scope,
          resource.style.normal,
          resource.normal_references
        );
        resolved.hover = try this.appearance(
          resource.scope,
          resource.style.hover,
          resource.hover_references
        );
        resolved.focus = try this.appearance(
          resource.scope,
          resource.style.focus,
          resource.focus_references
        );
        resolved.disabled = try this.appearance(
          resource.scope,
          resource.style.disabled,
          resource.disabled_references
        );
        try result.overlay(resolved);
      }
      if (not result.valid()) {
        return SystemResult.Error(Error(1, "Invalid style resource"));
      }
      return SystemResult.Ok(result);
    }
  }
}
