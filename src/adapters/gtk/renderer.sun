using std;

/** Renders owned UI descriptions using checked GTK widgets and native FIFO events. */
public module ui_gtk {

  /** Maps platform-independent node kinds to the checked binding vocabulary. */
  function widget_kind(kind: ui.Kind) i32 {
    return match kind {
      ui.Kind.Group => 0,
      ui.Kind.Row => 1,
      ui.Kind.Column => 2,
      ui.Kind.Grid => 3,
      ui.Kind.Scroll => 4,
      ui.Kind.Label => 5,
      ui.Kind.Button => 6,
      ui.Kind.TextInput => 7,
      ui.Kind.Checkbox => 8,
      ui.Kind.Select => 9,
      ui.Kind.Video => 10,
      ui.Kind.Viewport => 11,
      ui.Kind.Image => 12,
      ui.Kind.Drawing => 13
    };
  }

  /** Maps common alignment to GTK's fill, start, end, and center order. */
  function alignment(value: ui.Align) i32 {
    return match value {
      ui.Align.Fill => 0,
      ui.Align.Start => 1,
      ui.Align.End => 2,
      ui.Align.Center => 3
    };
  }

  /** Encodes a packed RGB color using numeric CSS channels. */
  function color(value: i64) String throws {
    return `rgb(${(value >> 16) & 255}, ${(value >> 8) & 255}, ${value & 255})`;
  }

  /** Emits one validated appearance with a fixed interaction selector. */
  function appearance(
    output: ref String,
    selector: static_ptr<u8>,
    value: const ref ui.Appearance
  ) void throws {
    output.append(selector);
    output.append(" {");
    if (value.foreground >= 0) {
      output.append("color:");
      output.append(color(value.foreground));
      output.append(";");
    }
    if (value.background >= 0) {
      output.append("background-color:");
      output.append(color(value.background));
      output.append(";background-image:none;");
    }
    if (not value.font.is_empty()) {
      output.append("font-family:\"");
      output.append(value.font);
      output.append("\";");
    }
    if (value.font_size > 0) {
      output.append("font-size:");
      output.append(value.font_size);
      output.append("px;");
    }
    if (value.border_width >= 0) {
      output.append("border-width:");
      output.append(value.border_width);
      output.append("px;box-shadow:none;");
      if (value.border_width == 0) {
        output.append("outline:none;transition:none;");
      }
    }
    if (value.radius >= 0) {
      output.append("border-radius:");
      output.append(value.radius);
      output.append("px;");
    }
    if (value.padding >= 0) {
      output.append("padding:");
      output.append(value.padding);
      output.append("px;");
    }
    output.append("}\n");

    return;
  }

  /** Keeps button keyboard-focus feedback distinct from pointer hover and click focus. */
  function stylesheet(style: const ref ui.Style, kind: ui.Kind) String throws {
    var css = String("");
    appearance(css, "*", style.normal);
    appearance(css, "*:hover", style.hover);
    appearance(
      css,
      kind == ui.Kind.Button ? "*:focus-visible" : "*:focus, *:focus-within",
      style.focus
    );
    appearance(css, "*:disabled", style.disabled);
    if (style.normal.border_width == 0) {
      css.append(
        "* button, * entry, * text {border:none;outline:none;box-shadow:none;transition:none;background-image:none;background-color:inherit;color:inherit;}\n"
      );
    }
    if (style.normal.radius == 0) {
      css.append(
        "* button, * entry, * text, * check, * trough, * slider, * popover contents {border-radius:0;}\n"
      );
    }
    return css;
  }

  /** Owns a heterogeneous widget, its subscription, and placement metadata. */
  class Control {
    var identity: u64;
    var viewport_id: i64 = 0;
    var drawing_id: i64 = 0;
    var kind: ui.Kind;
    var parent: u64 = 0;
    var previous: u64 = 0;
    var widget: gtk.Widget;
    var subscriptions: Vec<gtk.RegistrationId>;
    var row: i32 = 0;
    var column: i32 = 0;
    var row_span: i32 = 1;
    var column_span: i32 = 1;
    var choices: Vec<ui.Choice>;
    var applied_style: ui.Style;
    var styled: bool = false;

    /** Constructs a native control before registering user events. */
    init(
      identity: u64,
      element: const ref ui.Element,
      events: ref gtk.EventQueue,
      widget: gtk.Widget
    ) throws {
      this.applied_style = ui.Style();

      var a = make_heap_allocator();
      this.identity = identity;
      this.kind = element.kind;
      this.widget = widget;
      this.viewport_id = element.viewport_id;
      this.drawing_id = element.drawing_id;
      this.choices = Vec<ui.Choice>(a, 4);
      this.subscriptions = Vec<gtk.RegistrationId>(a, 4);
      this.apply(element);
      if (element.kind == ui.Kind.Button or element.kind == ui.Kind.TextInput or
        element.kind == ui.Kind.Checkbox or element.kind == ui.Kind.Select or
        element.kind == ui.Kind.Video) {
        this.subscriptions.push(events.on_widget(this.widget));
      }
    }

    /** Applies controlled values and common properties through checked APIs. */
    method apply(element: const ref ui.Element) void throws {
      var a = make_heap_allocator();
      if (element.kind == ui.Kind.Button or element.kind == ui.Kind.Label or
        element.kind == ui.Kind.TextInput or element.kind == ui.Kind.Checkbox) {
        var text = element.text.clone(a);
        this.widget.set_text(text);
      }
      var tooltip = element.tooltip.clone(a);
      var icon = element.icon.clone(a);
      this.widget.hint(tooltip, icon);
      if (element.kind == ui.Kind.Image) {
        var path = element.text.clone(a);
        this.widget.image(path);
      }
      if (element.kind == ui.Kind.Video) {
        this.widget.media_trim_controls(element.trim_controls);
        this.widget.media_frame_rate(element.frame_rate_num, element.frame_rate_den);
        var path = element.text.clone(a);
        this.widget.media(
          path,
          element.duration,
          element.trim_start,
          element.trim_end,
          element.position
        );
        var ranges = String("");
        for (var i: i64 = 0; i < element.trim_ranges.size(); i += 1) {
          if (i > 0) {
            ranges.append(";");
          }
          ranges.append(
            `${element.trim_ranges[i].id},${element.trim_ranges[i].start},${element.trim_ranges[i].end}`
          );
        }
        this.widget.media_ranges(ranges, element.active_range);
      }
      if (element.kind == ui.Kind.Checkbox) {
        this.widget.set_value(element.checked ? 1 : 0);
      }
      if (element.kind == ui.Kind.Select) {
        var changed = this.choices.size() != element.choices.size();
        if (not changed) {
          for (var i: i64 = 0; i < this.choices.size(); i += 1) {
            if (not this.choices[i].key.equals(element.choices[i].key) or
              not this.choices[i].text.equals(element.choices[i].text)) {
              changed = true;
            }
          }
        }
        if (changed) {
          this.widget.clear_options();
          this.choices.clear();
          for (var i: i64 = 0; i < element.choices.size(); i += 1) {
            var text = element.choices[i].text.clone(a);
            var key = element.choices[i].key.encoded();
            this.widget.add_option(text, key);
            this.choices.push(
              ui.Choice(
                element.choices[i].key.clone(a),
                element.choices[i].text.clone(a)
              )
            );
          }
        }
        this.widget.set_value(_convert<i32>(element.selected));
      }
      if (element.kind == ui.Kind.Grid) {
        this.widget.track(false, 0, 0, true);
        this.widget.track(true, 0, 0, true);
        if (element.rows.size() == 0) {
          this.widget.track(false, 0, 0, false);
        }
        if (element.columns.size() == 0) {
          this.widget.track(true, 0, 0, false);
        }
        for (var i: i64 = 0; i < element.rows.size(); i += 1) {
          var track = element.rows[i];
          this.widget.track(
            false,
            track.kind == ui.TrackKind.Auto ? 0 : (track.kind == ui.TrackKind.Fixed ? 1 : 2),
            track.value,
            false
          );
        }
        for (var i: i64 = 0; i < element.columns.size(); i += 1) {
          var track = element.columns[i];
          this.widget.track(
            true,
            track.kind == ui.TrackKind.Auto ? 0 : (track.kind == ui.TrackKind.Fixed ? 1 : 2),
            track.value,
            false
          );
        }
      }
      if (not this.styled or not this.applied_style.equals(element.style)) {
        var css = stylesheet(element.style, element.kind);
        this.widget.style(css);
        this.applied_style = ui.Style();
        this.applied_style.overlay(element.style);
        this.styled = true;
      }
      this.row = element.row;
      this.column = element.column;
      this.row_span = element.row_span;
      this.column_span = element.column_span;
      return this.widget.properties(
        element.enabled,
        element.visible,
        element.margin,
        element.width > element.min_width ? element.width : element.min_width,
        element.height > element.min_height ? element.height : element.min_height,
        alignment(element.horizontal),
        alignment(element.vertical),
        element.expand_x,
        element.expand_y,
        element.spacing
      );
    }
  }

  /** Retains a registered viewport independently of its mounted control. */
  class ViewportRegistration {
    var id: i64;
    var area: gtk.GLArea;
    var mounted: u64 = 0;

    /** Takes ownership of one unique surface registration. */
    init(id: i64, area: gtk.GLArea) {
      this.id = id;
      this.area = area;
    }
  }

  /** Retains a registered drawing independently of its mounted control. */
  class DrawingRegistration {
    var id: i64;
    var area: gtk.DrawingArea;
    var mounted: u64 = 0;

    /** Takes ownership of one unique surface registration. */
    init(id: i64, area: gtk.DrawingArea) {
      this.id = id;
      this.area = area;
    }
  }

  /** Owns the application, window, native controls, and exclusive GTK event queue. */
  public class Renderer implements ui.Renderer {
    var app: gtk.Application;
    var window: gtk.Window;
    var open_dialog: gtk.OpenDialog = gtk.OpenDialog();
    var save_dialog: gtk.SaveDialog = gtk.SaveDialog();
    var root: gtk.Widget;
    var events: gtk.EventQueue;
    var controls: Vec<Control>;
    var viewports: Vec<ViewportRegistration>;
    var drawings: Vec<DrawingRegistration>;
    var presented: bool = false;
    public var updates: i64 = 0;
    public var creates: i64 = 0;
    public var removals: i64 = 0;

    /** Prepares a window shown after its first completed render, using the default application identifier. */
    init(title: ref String) throws {
      var a = make_heap_allocator();
      var id = String("org.sunlang.UIPrototype");
      this.app = gtk.Application(id);
      this.window = gtk.Window(this.app);
      this.root = gtk.Widget(2);
      this.controls = Vec<Control>(a, 8);
      this.viewports = Vec<ViewportRegistration>(a, 4);
      this.drawings = Vec<DrawingRegistration>(a, 4);
      this.root.properties(true, true, 0, -1, -1, 0, 0, false, false, 8);
      this.window.set_widget(this.root);
      this.events = gtk.EventQueue(this.app);
      this.window.set_title(title);
      this.window.set_default_size(440, 360);
    }

    /** Prepares a window shown after its first completed render, with an owned application identifier. */
    init(title: ref String, id: String) throws {
      var a = make_heap_allocator();
      this.app = gtk.Application(id);
      this.window = gtk.Window(this.app);
      this.root = gtk.Widget(2);
      this.controls = Vec<Control>(a, 8);
      this.viewports = Vec<ViewportRegistration>(a, 4);
      this.drawings = Vec<DrawingRegistration>(a, 4);
      this.root.properties(true, true, 0, -1, -1, 0, 0, false, false, 8);
      this.window.set_widget(this.root);
      this.events = gtk.EventQueue(this.app);
      this.window.set_title(title);
      this.window.set_default_size(440, 360);
    }

    /** Disconnects subscriptions before closing the window. */
    deinit() {
      this.open_dialog.cancel();
      this.save_dialog.cancel();
      this.clear();
      this.window.close();
    }

    /** Finds a live core-issued identity. */
    method index(identity: u64) i64 {
      for (var i: i64 = 0; i < this.controls.size(); i += 1) {
        if (this.controls[i].identity == identity) {
          return i;
        }
      }
      return -1;
    }

    /** Finds a registered application-owned viewport identifier. */
    method viewport_index(id: i64) i64 {
      for (var i: i64 = 0; i < this.viewports.size(); i += 1) {
        if (this.viewports[i].id == id) {
          return i;
        }
      }
      return -1;
    }

    /** Registers an independently retained surface before a view mounts it. */
    public method register_viewport(id: i64, area: gtk.GLArea) void throws {
      if (id <= 0) {
        throw Error(1, "Viewport identifier must be positive");
      }
      for (var i: i64 = 0; i < this.viewports.size(); i += 1) {
        if (this.viewports[i].id == id or this.viewports[i].area.same(area)) {
          throw Error(1, "Viewport identifier or surface is already registered");
        }
      }
      this.viewports.push(ViewportRegistration(id, area));
      return;
    }

    /** Returns an explicitly retained surface for redraw and native status access. */
    public method viewport(id: i64) gtk.GLArea throws {
      var index = this.viewport_index(id);
      if (index < 0) {
        throw Error(1, "Unknown viewport identifier");
      }
      return gtk.GLArea(this.viewports[index].area);
    }

    /** Releases an unmounted registration; mounted surfaces must first leave the tree. */
    public method unregister_viewport(id: i64) void throws {
      var index = this.viewport_index(id);
      if (index < 0 or this.viewports[index].mounted != 0) {
        throw Error(1, "Viewport is missing or still mounted");
      }
      try {
        this.viewports.remove(index);
      } catch (error: std.IndexOutOfBoundsError) {}
      return;
    }

    /** Finds a registered application-owned drawing identifier. */
    method drawing_index(id: i64) i64 {
      for (var i: i64 = 0; i < this.drawings.size(); i += 1) {
        if (this.drawings[i].id == id) {
          return i;
        }
      }
      return -1;
    }

    /** Registers an independently retained surface before a view mounts it. */
    public method register_drawing(id: i64, area: gtk.DrawingArea) void throws {
      if (id <= 0) {
        throw Error(1, "Drawing identifier must be positive");
      }
      for (var i: i64 = 0; i < this.drawings.size(); i += 1) {
        if (this.drawings[i].id == id or this.drawings[i].area.same(area)) {
          throw Error(1, "Drawing identifier or surface is already registered");
        }
      }
      this.drawings.push(DrawingRegistration(id, area));
      return;
    }

    /** Returns an explicitly retained surface for redraw and native status access. */
    public method drawing(id: i64) gtk.DrawingArea throws {
      var index = this.drawing_index(id);
      if (index < 0) {
        throw Error(1, "Unknown drawing identifier");
      }
      return gtk.DrawingArea(this.drawings[index].area);
    }

    /** Releases an unmounted registration; mounted surfaces must first leave the tree. */
    public method unregister_drawing(id: i64) void throws {
      var index = this.drawing_index(id);
      if (index < 0 or this.drawings[index].mounted != 0) {
        throw Error(1, "Drawing is missing or still mounted");
      }
      try {
        this.drawings.remove(index);
      } catch (error: std.IndexOutOfBoundsError) {}
      return;
    }

    /** Creates an owned typed control and any native edit subscription. */
    public method create(identity: u64, element: const ref ui.Element) void throws {
      if (element.kind == ui.Kind.Viewport) {
        var index = this.viewport_index(element.viewport_id);
        if (index < 0 or this.viewports[index].mounted != 0) {
          throw Error(1, "Viewport is missing or already mounted");
        }
        this.controls.push(
          Control(identity, element, this.events, gtk.Widget(this.viewports[index].area))
        );

        this.viewports[index].mounted = identity;
      } else if (element.kind == ui.Kind.Drawing) {
        var index = this.drawing_index(element.drawing_id);
        if (index < 0 or this.drawings[index].mounted != 0) {
          throw Error(1, "Drawing is missing or already mounted");
        }
        this.controls.push(
          Control(identity, element, this.events, gtk.Widget(this.drawings[index].area))
        );

        this.drawings[index].mounted = identity;
      } else {
        this.controls.push(
          Control(identity, element, this.events, gtk.Widget(widget_kind(element.kind)))
        );
      }
      this.creates += 1;
      return;
    }

    /** Applies changed properties or restores a rejected controlled edit. */
    public method update(identity: u64, element: const ref ui.Element) void throws {
      var index = this.index(identity);
      if (index < 0) {
        throw Error(1, "Unknown GTK control");
      }
      if (element.kind == ui.Kind.Viewport and
        this.controls[index].viewport_id != element.viewport_id) {
        var next = this.viewport_index(element.viewport_id);
        if (next < 0 or this.viewports[next].mounted != 0) {
          throw Error(1, "Replacement viewport is missing or already mounted");
        }
        var old = this.viewport_index(this.controls[index].viewport_id);
        this.controls[index].widget.detach();
        if (old >= 0) {
          this.viewports[old].mounted = 0;
        }
        this.controls[index].widget = gtk.Widget(this.viewports[next].area);
        this.controls[index].viewport_id = element.viewport_id;
        this.controls[index].styled = false;
        this.viewports[next].mounted = identity;
      }
      if (element.kind == ui.Kind.Drawing and
        this.controls[index].drawing_id != element.drawing_id) {
        var next = this.drawing_index(element.drawing_id);
        if (next < 0 or this.drawings[next].mounted != 0) {
          throw Error(1, "Replacement drawing is missing or already mounted");
        }
        var old = this.drawing_index(this.controls[index].drawing_id);
        this.controls[index].widget.detach();
        if (old >= 0) {
          this.drawings[old].mounted = 0;
        }
        this.controls[index].widget = gtk.Widget(this.drawings[next].area);
        this.controls[index].drawing_id = element.drawing_id;
        this.controls[index].styled = false;
        this.drawings[next].mounted = identity;
      }
      (this.controls[index].apply(element));
      this.updates += 1;
      return;
    }

    /** Records logical placement for completion after all sibling scopes are known. */
    public method place(identity: u64, parent: u64, previous: u64) void throws {
      var i = this.index(identity);
      if (i < 0) {
        throw Error(1, "Unknown GTK placement identity");
      }
      this.controls[i].parent = parent;
      this.controls[i].previous = previous;
      return;
    }

    /** Places scoped siblings while flattening logical groups into their physical parent. */
    method layout(scope: u64, parent: u64, previous: u64) u64 throws {
      var logical_previous: u64 = 0;
      var native_previous = previous;
      for (var count: i64 = 0; count < this.controls.size(); count += 1) {
        var index: i64 = -1;
        for (var i: i64 = 0; i < this.controls.size(); i += 1) {
          if (this.controls[i].parent == scope and this.controls[i].previous == logical_previous) {
            index = i;
            break;
          }
        }
        if (index < 0) {
          break;
        }
        var identity = this.controls[index].identity;
        logical_previous = identity;
        if (this.controls[index].kind == ui.Kind.Group) {
          native_previous = this.layout(identity, parent, native_previous);
          continue;
        }
        var p = this.index(parent);
        var before = this.index(native_previous);
        var child = this.controls[index];
        if (parent == 0) {
          if (before < 0) {
            this.root.place_first(
              child.widget,
              child.row,
              child.column,
              child.row_span,
              child.column_span
            );
          } else {
            this.root.place_after(
              child.widget,
              this.controls[before].widget,
              child.row,
              child.column,
              child.row_span,
              child.column_span
            );
          }
        } else {
          if (p < 0) {
            throw Error(1, "Unknown GTK parent");
          }
          if (before < 0) {
            this.controls[p].widget.place_first(
              child.widget,
              child.row,
              child.column,
              child.row_span,
              child.column_span
            );
          } else {
            this.controls[p].widget.place_after(
              child.widget,
              this.controls[before].widget,
              child.row,
              child.column,
              child.row_span,
              child.column_span
            );
          }
        }
        this.layout(identity, identity, 0);
        native_previous = identity;
      }
      return native_previous;
    }

    /** Completes native placement and presents the initial tree with its configured window size. */
    public method finish() void throws {
      this.layout(0, 0, 0);
      if (not this.presented) {
        this.window.present();
        this.presented = true;
      }
      return;
    }

    /** Disconnects and detaches one node after its descendants are removed. */
    public method remove(identity: u64) void {
      var index = this.index(identity);
      if (index < 0) {
        return;
      }
      if (this.controls[index].subscriptions.size() > 0) {
        try {
          this.events.disconnect(this.controls[index].subscriptions[0]);
        } catch {}
      }
      this.controls[index].widget.detach();
      if (this.controls[index].kind == ui.Kind.Viewport) {
        var registration = this.viewport_index(this.controls[index].viewport_id);
        if (registration >= 0) {
          this.viewports[registration].mounted = 0;
        }
      }
      if (this.controls[index].kind == ui.Kind.Drawing) {
        var registration = this.drawing_index(this.controls[index].drawing_id);
        if (registration >= 0) {
          this.drawings[registration].mounted = 0;
        }
      }
      try {
        this.controls.remove(index);
      } catch (error: std.IndexOutOfBoundsError) {}
      this.removals += 1;
    }

    /** Requests native keyboard focus after a successful commit. */
    public method focus(identity: u64) void {
      var i = this.index(identity);
      if (i >= 0) {
        this.controls[i].widget.focus();
      }
    }

    /** Releases every control in reverse creation order. */
    public method clear() void {
      while (this.controls.size() > 0) {
        this.remove(this.controls[this.controls.size() - 1].identity);
      }
    }

    /** Converts a bounded native FIFO batch to owned semantic edit values. */
    method collect(tree: ref ui.Tree, queue: ref ui.EventQueue) void throws {
      var a = make_heap_allocator();
      for (var i: i64 = 0; i < 64; i += 1) {
        match this.events.next() {
          Option.Some(event) => {
            var id = event.registration();
            for (var control: ref Control in this.controls) {
              var matches = false;
              if (control.subscriptions.size() > 0) {
                matches = control.subscriptions[0].equals(id);
              }
              if (matches) {
                if (event.kind() == gtk.EventKind.TextChanged) {
                  if (control.kind == ui.Kind.Video) {
                    var fields = event.text.split(a, b':');
                    if (fields.size() == 3 or fields.size() == 4) {
                      var start = match fields[0].parse_i64() {
                        Option.Some(value) => value,
                        Option.None => -1
                      };
                      var end = match fields[1].parse_i64() {
                        Option.Some(value) => value,
                        Option.None => -1
                      };
                      var position = match fields[2].parse_i64() {
                        Option.Some(value) => value,
                        Option.None => -1
                      };
                      var range_id: i64 = 0;
                      if (fields.size() == 4) {
                        range_id = match fields[3].parse_i64() {
                          Option.Some(value) => value,
                          Option.None => -1
                        };
                      }
                      if (start >= 0 and end > start and position >= 0 and range_id >= 0) {
                        var value = ui.EventValue(start, end, position);
                        value.range_id = range_id;
                        tree.enqueue_value(control.identity, value, queue);
                      }
                    }
                  } else {
                    tree.enqueue_value(
                      control.identity,
                      ui.EventValue(event.text.clone(a)),
                      queue
                    );
                  }
                } else if (event.kind() == gtk.EventKind.Toggled) {
                  tree.enqueue_value(
                    control.identity,
                    ui.EventValue(event.value != 0),
                    queue
                  );
                } else if (event.kind() == gtk.EventKind.Selected) {
                  if (event.text.length() >= 2) {
                    var encoded_outcome: std.Option<String> = std.Option.None;

                    try {
                      var value = sun_ui_results.substring(
                        event.text,
                        a,
                        2,
                        event.text.length() - 2
                      );

                      encoded_outcome = std.Option.Some(value);
                    } catch (error: std.IndexOutOfBoundsError) {
                      encoded_outcome = std.Option.Some(String(""));
                    }

                    var encoded = match encoded_outcome {
                      std.Option.Some(value) => value,
                      std.Option.None => {
                        throw std.Error(1, "Exception handler produced no value");
                      }
                    };
                    if (event.text.starts_with("s:")) {
                      tree.enqueue_value(
                        control.identity,
                        ui.EventValue(ui.Key(encoded)),
                        queue
                      );
                    } else {
                      match encoded.parse_i64() {
                        Option.Some(key) => {
                          tree.enqueue_value(
                            control.identity,
                            ui.EventValue(ui.Key(key)),
                            queue
                          );
                        },
                        Option.None => {}
                      };
                    }
                  }
                } else {
                  tree.enqueue(control.identity, queue);
                }
                break;
              }
            }
          },
          Option.None => {
            break;
          }
        };
      }

      return;
    }

    /** Services GTK and collects native events according to this adapter's batching policy. */
    public method poll(tree: ref ui.Tree, queue: ref ui.EventQueue, block: bool) void throws {
      this.events.iterate(false);
      this.collect(tree, queue);
      if (block and queue.size() == 0 and this.running()) {
        this.events.iterate(true);
        this.collect(tree, queue);
      }
      gtk.clear_gl_context();

      return;
    }

    /** Waits on GTK's event loop, with a bounded wakeup only for external work polling. */
    public method wait_events(
      tree: ref ui.Tree,
      queue: ref ui.EventQueue,
      timeout_ms: u32
    ) void throws {
      if (queue.size() != 0 or not this.running()) {
        return;
      }
      if (timeout_ms == 0) {
        this.events.iterate(true);
        this.collect(tree, queue);
      } else {
        var wakeup = this.events.after(timeout_ms);
        this.events.iterate(true);
        this.collect(tree, queue);
        this.events.disconnect(wakeup);
      }
      gtk.clear_gl_context();
      return;
    }

    /** Sets a preferred window size through the checked GTK binding. */
    public method set_default_size(width: i32, height: i32) void throws {
      return this.window.set_default_size(width, height);
    }

    /** Opens a local input chooser parented to this renderer's window. */
    public method choose_input() void throws {
      var title = String("Open file");
      return this.open_dialog.show(this.window, title);
    }

    /** Opens a save chooser using a suggested output filename. */
    public method choose_output(filename: ref String) void throws {
      var title = String("Save file");
      return this.save_dialog.show(this.window, title, filename);
    }

    /** Consumes a chosen input path once without exposing platform handles. */
    public method take_input_path() Option<String> throws {
      return this.open_dialog.take_path();
    }

    /** Consumes a chosen output path once without exposing platform handles. */
    public method take_output_path() Option<String> throws {
      return this.save_dialog.take_path();
    }

    /** Exercises native timeline gestures through a mounted video control. */
    public method drag_media(identity: u64, start: f64, end: f64) void throws {
      var index = this.index(identity);
      if (index < 0) {
        throw Error(1, "Unknown media control");
      }
      return this.controls[index].widget.drag_media(start, end);
    }

    /** Exercises one arrow-key edit on the selected bar or playhead of a mounted video. */
    public method step_media(identity: u64, direction: i32) void throws {
      var index = this.index(identity);
      if (index < 0) {
        throw Error(1, "Unknown media control");
      }
      return this.controls[index].widget.step_media(direction);
    }

    /** Reports preview preparation or playback for acceptance checks. */
    public method media_status(identity: u64) i32 {
      var index = this.index(identity);
      return index < 0 ? -1 : this.controls[index].widget.media_status();
    }

    /** Reports decoded image availability for preview verification. */
    public method image_status(identity: u64) i32 {
      var index = this.index(identity);
      return index < 0 ? -1 : this.controls[index].widget.image_status();
    }

    /** Reads the actual preview timestamp for acceptance checks. */
    public method media_timestamp(identity: u64) i64 {
      var index = this.index(identity);
      return index < 0 ? 0 : this.controls[index].widget.media_timestamp();
    }

    /** Exercises the native play/pause transport without platform handles. */
    public method toggle_media(identity: u64) void {
      var index = this.index(identity);
      if (index >= 0) {
        this.controls[index].widget.toggle_media();
      }
    }

    /** Closes this window without stopping other application hosts. */
    public method close() void {
      this.window.close();
      gtk.clear_gl_context();
    }

    /** Reports whether the application window remains open. */
    public method running() bool {
      return this.window.is_open();
    }

    /** Emits a native click for acceptance tests. */
    public method click(identity: u64) void {
      var i = this.index(identity);
      if (i >= 0) {
        this.controls[i].widget.click();
      }
    }

    /** Simulates native editable input without bypassing event capture. */
    public method edit(identity: u64, text: ref String, value: i32) void throws {
      var i = this.index(identity);
      if (i < 0) {
        throw Error(1, "Unknown editable identity");
      }
      return this.controls[i].widget.edit(text, value);
    }

    /** Reads native allocation for layout acceptance checks. */
    public method extent(identity: u64, horizontal: bool) i32 {
      var i = this.index(identity);
      return i < 0 ? 0 : this.controls[i].widget.extent(horizontal);
    }

    /** Checks native keyboard focus for acceptance tests. */
    public method focused(identity: u64) bool {
      var i = this.index(identity);
      return i >= 0 and this.controls[i].widget.focused();
    }

    /** Checks native sibling order for acceptance tests. */
    public method follows(identity: u64, previous: u64) bool {
      var i = this.index(identity);
      var p = this.index(previous);
      if (i < 0) {
        return false;
      }
      if (previous == 0) {
        return this.controls[i].widget.first();
      }
      return p >= 0 and this.controls[i].widget.follows(this.controls[p].widget);
    }
  }
}
manifest {
  libraries: [
    "stdlib.moon",
    "sun_ui.moon",
    "${namo-robotics/sun_gobject}/lib/sun_gobject.moon",
    "${namo-robotics/sun_gobject}/lib/sun_gtk.moon"
  ]
}
