using std;

/** Adapts semantic buttons to GTK using sun_gobject's owned widgets and event queues. */
public module ui_gtk {

  /** Owns a button and its independently managed click subscription. */
  class Control {
    var identity: u64;
    var button: gtk.Button;
    var click_id: gtk.RegistrationId;

    /** Creates a native button using the checked sun_gobject API. */
    init(identity: u64, text: const ref String, events: ref gtk.EventQueue) SystemResult<void> {
      var a = make_heap_allocator();
      var label = text.clone(a);
      this.identity = identity;
      this.button = try gtk.Button(label);
      this.click_id = try events.on_clicked(this.button);
    }
  }

  /** Owns the application, window, layout, and controls on the GTK main thread. */
  public class Renderer implements ui.Renderer {
    var app: gtk.Application;
    var window: gtk.Window;
    var box: gtk.Box;
    var events: gtk.EventQueue;
    var controls: Vec<Control>;
    public var updates: i64 = 0;
    public var creates: i64 = 0;
    public var removals: i64 = 0;

    /** Opens checked native widgets and acquires a state-independent GTK event queue. */
    init(title: ref String) SystemResult<void> {
      var a = make_heap_allocator();
      var id = String("org.sunlang.UIPrototype");
      this.app = try gtk.Application(id);
      this.window = gtk.Window(this.app);
      this.controls = Vec<Control>(a, 8);
      this.box = try gtk.Box(gtk.Orientation.Vertical, 8);
      try this.window.set_box(this.box);
      this.events = try gtk.EventQueue(this.app);
      try this.window.set_title(title);
      try this.window.set_default_size(440, 360);
      try this.window.present();
    }

    /** Disconnects every button subscription before releasing the container. */
    deinit() {
      this.clear();
      this.window.close();
    }

    /** Finds a live control by its core-issued identity. */
    method index(identity: u64) i64 {
      for (var i: i64 = 0; i < this.controls.size(); i += 1) {
        if (this.controls[i].identity == identity) {
          return i;
        }
      }
      return -1;
    }

    /** Creates a checked native button and a FIFO click subscription. */
    public method create(identity: u64, text: const ref String) SystemResult<void> {
      var control = try Control(identity, text, this.events);
      this.controls.push(control);
      this.creates += 1;
      return SystemResult.Ok;
    }

    /** Copies changed text into the existing native button. */
    public method update(identity: u64, text: const ref String) SystemResult<void> {
      var index = this.index(identity);
      if (index < 0) {
        return SystemResult.Error(Error(1, "Unknown GTK control"));
      }
      var a = make_heap_allocator();
      var label = text.clone(a);
      try this.controls[index].button.set_label(label);
      this.updates += 1;
      return SystemResult.Ok;
    }

    /** Reorders without removing surviving widgets from their parent. */
    public method place(identity: u64, previous: u64) SystemResult<void> {
      var index = this.index(identity);
      if (index < 0) {
        return SystemResult.Error(Error(1, "Unknown GTK control"));
      }
      if (previous == 0) {
        return this.box.place_first(this.controls[index].button);
      }
      var before = this.index(previous);
      if (before < 0) {
        return SystemResult.Error(Error(1, "Unknown GTK sibling"));
      }
      return this.box.place_after(this.controls[index].button, this.controls[before].button);
    }

    /** Unparents the button and destroys its wrapper, disconnecting its click signal. */
    public method remove(identity: u64) void {
      var index = this.index(identity);
      if (index < 0) {
        return;
      }
      // The identity was created by this renderer's queue, so cancellation cannot fail.
      ignore_error(this.events.disconnect(this.controls[index].click_id));
      this.box.remove(this.controls[index].button);
      match this.controls.remove(index) {
        AccessResult.Ok(_) => {},
        AccessResult.OutOfBounds(_) => {}
      };
      this.removals += 1;
    }

    /** Requests native focus only after reconciliation finishes. */
    public method focus(identity: u64) void {
      var index = this.index(identity);
      if (index >= 0) {
        this.controls[index].button.focus();
      }
    }

    /** Removes every owned subscription; safe to call repeatedly. */
    public method clear() void {
      while (this.controls.size() > 0) {
        this.remove(this.controls[0].identity);
      }
    }

    /** Translates a bounded FIFO batch into semantic messages without running handlers. */
    method collect(tree: ref ui.Tree, queue: ref ui.EventQueue) void {
      for (var i: i64 = 0; i < 64; i += 1) {
        match this.events.next() {
          Option.Some(event) => {
            var id = event.registration();
            for (var control: ref Control in this.controls) {
              if (control.click_id.equals(id)) {
                tree.enqueue(control.identity, queue);
                break;
              }
            }
          },
          Option.None => {
            break;
          }
        };
      }
    }

    /** Applies this backend's batching and window-lifetime policy around native dispatch. */
    public method poll(tree: ref ui.Tree, queue: ref ui.EventQueue, block: bool) void {
      this.events.iterate(false);
      this.collect(tree, queue);
      if (block and queue.size() == 0 and this.running()) {
        this.events.iterate(true);
        this.collect(tree, queue);
      }
    }

    /** Reports whether the user has left the window open. */
    public method running() bool {
      return this.window.is_open();
    }

    /** Emits a real GTK clicked signal for deterministic acceptance scenarios. */
    public method click(identity: u64) void {
      var index = this.index(identity);
      if (index >= 0) {
        this.controls[index].button.click();
      }
    }

    /** Checks that a surviving widget retains native focus. */
    public method focused(identity: u64) bool {
      var index = this.index(identity);
      if (index < 0) {
        return false;
      }
      return this.controls[index].button.is_focused();
    }

    /** Reads native sibling order for acceptance checks. */
    public method follows(identity: u64, previous: u64) bool {
      var index = this.index(identity);
      if (index < 0) {
        return false;
      }
      if (previous == 0) {
        return this.box.is_first(this.controls[index].button);
      }
      var before = this.index(previous);
      if (before < 0) {
        return false;
      }
      return this.box.follows(this.controls[index].button, this.controls[before].button);
    }
  }
}
manifest { libraries: ["stdlib.moon", "sun_ui.moon", "sun_gobject.moon", "sun_gtk.moon"] }
