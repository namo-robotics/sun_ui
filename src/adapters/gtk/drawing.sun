using std;

/** Composes checked GTK widgets into a vector viewer with application-owned export policy. */
public module ui_gtk_drawing {

  /** Owns a plot window, toolbar, and document content without retaining platform handles. */
  public class Window {
    var app: gtk.Application;
    var window: gtk.Window;
    var layout: gtk.Box;
    var toolbar: gtk.Box;
    var export_button: gtk.Button;
    var status: gtk.Label;
    var area: gtk.DrawingArea;
    var chooser: gtk.SaveDialog;
    var svg: String;

    /** Creates checked widgets and installs the initial figure; GTK owns native lifetimes. */
    init(title: ref String, drawing: const ref ui_drawing.Drawing) throws {
      this.svg = String("");

      validate(drawing);
      var id = String("org.sunlang.PlotViewer");
      this.app = gtk.Application(id);
      this.window = gtk.Window(this.app);
      this.layout = gtk.Box(gtk.Orientation.Vertical, 8);
      this.toolbar = gtk.Box(gtk.Orientation.Horizontal, 12);
      var label = String("Export SVG…");
      this.export_button = gtk.Button(label);
      var empty = String("");
      this.status = gtk.Label(empty);
      this.area = gtk.DrawingArea();
      this.chooser = gtk.SaveDialog();
      this.toolbar.append(this.export_button);
      this.toolbar.append(this.status);
      this.layout.append(this.toolbar);
      this.layout.append(this.area);
      this.area.set_vexpand(true);
      this.window.set_box(this.layout);
      this.window.set_title(title);
      this.window.set_default_size(
        _convert<i32>(drawing.width),
        _convert<i32>(drawing.height)
      );
      this.update(drawing);
      this.window.present();
    }

    /** Parses a replacement before changing the surface or exported content. */
    public method update(drawing: const ref ui_drawing.Drawing) void throws {
      if (this.running() == false) {
        throw Error(1, "Plot window is closed");
      }
      validate(drawing);
      var content = drawing.svg();
      var document = svg.Document(content);
      this.area.set_document(document);
      this.svg = content;
      return;
    }

    /** Saves the current figure and reports the outcome through a checked toolbar label. */
    public method export_svg(path: ref String) void throws {
      if (this.running() == false) {
        throw Error(1, "Plot window is closed");
      }

      var operation_completed_2 = false;
      try {
        std.io.write_string(path, this.svg);
        operation_completed_2 = true;
        var message = `Saved: ${path}`;
        try {
          this.status.set_text(message);
        } catch {}
        return;
      } catch (error: std.Error) {
        if (operation_completed_2) {
          throw;
        }
        this.report_export_failure();
        throw error;
      } catch (error: std.AllocationError) {
        if (operation_completed_2) {
          throw;
        }
        try {
          this.report_export_failure();
        } catch {}
        throw error;
      } catch (error: std.InvalidArgumentError) {
        if (operation_completed_2) {
          throw;
        }
        this.report_export_failure();
        throw error;
      } catch (error: std.OverflowError) {
        if (operation_completed_2) {
          throw;
        }
        this.report_export_failure();
        throw error;
      }
    }

    /** Shows a failed export in the toolbar when a status message can be allocated. */
    method report_export_failure() void throws {
      var message = String("Export failed. Check the destination and try again.");
      try {
        this.status.set_text(message);
      } catch {}
      return;
    }

    /** Opens one chooser and consumes its result at the application dispatch boundary. */
    method process_export() void throws {
      if (this.export_button.take_click() and this.chooser.is_open() == false) {
        var title = String("Export plot as SVG");
        var filename = String("scientific-plot.svg");
        try {
          this.chooser.show(this.window, title, filename);
        } catch {}
      }

      var operation_completed_1 = false;
      try {
        var result = this.chooser.take_path();
        operation_completed_1 = true;
        match result {
          Option.Some(path) => {
            try {
              this.export_svg(path);
            } catch {}
          },
          Option.None => {}
        };
      } catch {
        if (operation_completed_1) {
          throw;
        }
        var message = String("Export requires a local file destination.");

        try {
          this.status.set_text(message);
        } catch {}
      }

      return;
    }

    /** Reports successful native rendering of the current figure. */
    public const method rendered() bool {
      return this.area.rendered();
    }

    /** Pumps the native context, then applies export and render-error presentation policy. */
    public method poll(block: bool) void throws {
      if (this.running() == false) {
        this.chooser.cancel();
        return;
      }
      this.app.iterate(block);
      if (this.running()) {
        this.process_export();
        if (this.area.render_failed()) {
          var message = String("Could not render the current figure.");
          try {
            this.status.set_text(message);
          } catch {}
        }
      } else {
        this.chooser.cancel();
      }

      return;
    }

    /** Reports whether the plot window is still open. */
    public const method running() bool {
      return this.window.is_open();
    }

    /** Requests positive default dimensions through the checked GTK API. */
    public method resize(width: i32, height: i32) void throws {
      return this.window.set_default_size(width, height);
    }

    /** Closes pending dialogs before closing the parent; owned wrappers release remaining resources. */
    deinit() {
      this.chooser.cancel();
      this.window.close();
    }
  }

  /** Rejects invalid dimensions before converting them to native integers. */
  function validate(drawing: const ref ui_drawing.Drawing) void throws {
    if (drawing.width >= 1.0 and drawing.width <= 16384.0 and drawing.height >= 1.0 and
      drawing.height <= 16384.0) {
      return;
    }
    throw Error(1, "Drawing dimensions must be between 1 and 16384");
  }
}
manifest {
  libraries: [
    "stdlib.moon",
    "sun_ui.moon",
    "${namo-robotics/sun_gobject}/lib/sun_gobject.moon",
    "${namo-robotics/sun_gobject}/lib/sun_gtk.moon"
  ]
}
