using std;

/** Composes checked GTK widgets into a vector viewer with application-owned export policy. */
public module ui_gtk_drawing {

  /** Owns a plot window, toolbar, and document content without retaining platform handles. */
  public class Window {
    var app: gtk.Application;
    var window: gtk.Window;
    var layout: gtk.Box;
    var toolbar: gtk.Box;
    var export_button: gtk.Button;
    var status: gtk.Label;
    var area: gtk.DrawingArea;
    var chooser: gtk.SaveDialog;
    var svg: String = String("");

    /** Creates checked widgets and installs the initial figure; GTK owns native lifetimes. */
    init(title: ref String, drawing: const ref ui_drawing.Drawing) SystemResult<void> {
      try validate(drawing);
      var id = String("org.sunlang.PlotViewer");
      this.app = try gtk.Application(id);
      this.window = gtk.Window(this.app);
      this.layout = try gtk.Box(gtk.Orientation.Vertical, 8);
      this.toolbar = try gtk.Box(gtk.Orientation.Horizontal, 12);
      var label = String("Export SVG…");
      this.export_button = try gtk.Button(label);
      var empty = String("");
      this.status = try gtk.Label(empty);
      this.area = try gtk.DrawingArea();
      this.chooser = gtk.SaveDialog();
      try this.toolbar.append(this.export_button);
      try this.toolbar.append(this.status);
      try this.layout.append(this.toolbar);
      try this.layout.append(this.area);
      this.area.set_vexpand(true);
      try this.window.set_box(this.layout);
      try this.window.set_title(title);
      try this.window.set_default_size(_convert<i32>(drawing.width), _convert<i32>(drawing.height));
      try this.update(drawing);
      try this.window.present();
    }

    /** Parses a replacement before changing the surface or exported content. */
    public method update(drawing: const ref ui_drawing.Drawing) SystemResult<void> {
      if (this.running() == false) {
        return SystemResult.Error(Error(1, "Plot window is closed"));
      }
      try validate(drawing);
      var content = drawing.svg();
      var document = try svg.Document(content);
      this.area.set_document(document);
      this.svg = content;
      return SystemResult.Ok;
    }

    /** Saves the current figure and reports the outcome through a checked toolbar label. */
    public method export_svg(path: ref String) SystemResult<void> {
      if (this.running() == false) {
        return SystemResult.Error(Error(1, "Plot window is closed"));
      }
      match std.io.write_string(path, this.svg) {
        SystemResult.Ok => {
          var message = `Saved: ${path}`;
          ignore_error(this.status.set_text(message));
          return SystemResult.Ok;
        },
        SystemResult.Error(error) => {
          var message = String("Export failed. Check the destination and try again.");
          ignore_error(this.status.set_text(message));
          return SystemResult.Error(error);
        }
      };
    }

    /** Opens one chooser and consumes its result at the application dispatch boundary. */
    method process_export() void {
      if (this.export_button.take_click() and this.chooser.is_open() == false) {
        var title = String("Export plot as SVG");
        var filename = String("scientific-plot.svg");
        ignore_error(this.chooser.show(this.window, title, filename));
      }
      match this.chooser.take_path() {
        SystemResult.Ok(result) => {
          match result {
            Option.Some(path) => {
              ignore_error(this.export_svg(path));
            },
            Option.None => {}
          };
        },
        SystemResult.Error(_) => {
          var message = String("Export requires a local file destination.");
          ignore_error(this.status.set_text(message));
        }
      };
    }

    /** Reports successful native rendering of the current figure. */
    public const method rendered() bool {
      return this.area.rendered();
    }

    /** Pumps the native context, then applies export and render-error presentation policy. */
    public method poll(block: bool) void {
      if (this.running() == false) {
        this.chooser.cancel();
        return;
      }
      this.app.iterate(block);
      if (this.running()) {
        this.process_export();
        if (this.area.render_failed()) {
          var message = String("Could not render the current figure.");
          ignore_error(this.status.set_text(message));
        }
      } else {
        this.chooser.cancel();
      }
    }

    /** Reports whether the plot window is still open. */
    public const method running() bool {
      return this.window.is_open();
    }

    /** Requests positive default dimensions through the checked GTK API. */
    public method resize(width: i32, height: i32) SystemResult<void> {
      return this.window.set_default_size(width, height);
    }

    /** Closes pending dialogs before closing the parent; owned wrappers release remaining resources. */
    deinit() {
      this.chooser.cancel();
      this.window.close();
    }
  }

  /** Rejects invalid dimensions before converting them to native integers. */
  function validate(drawing: const ref ui_drawing.Drawing) SystemResult<void> {
    if (drawing.width >= 1.0 and drawing.width <= 16384.0 and drawing.height >= 1.0 and drawing.height <= 16384.0) {
      return SystemResult.Ok;
    }
    return SystemResult.Error(Error(1, "Drawing dimensions must be between 1 and 16384"));
  }
}
manifest {
  library_id: "namo-robotics/sun_ui_gtk_drawing"
  libraries: ["stdlib.moon", "sun_ui.moon", "sun_gobject.moon", "sun_gtk.moon"]
}
