using std;

/** Compiles declarative XML into ordinary owned Sun view-building functions. */
public module markup {

  /** Owns an XML attribute and its original input location. */
  class Attribute {
    var name: String;
    var value: String;
    var offset: i64;

    /** Takes decoded content and a parser-provided source offset. */
    init(name: String, value: String, offset: i64) {
      this.name = name;
      this.value = value;
      this.offset = offset;
    }
  }

  /** Stores a parsed declaration in parent-before-child order. */
  class Node {
    var name: String;
    var attributes: Vec<Attribute>;
    var parent: i64;
    var offset: i64;

    /** Allocates attribute storage for a validated XML element. */
    init(name: String, parent: i64, offset: i64) std.AllocationResult<void> {
      var a = make_heap_allocator();
      this.name = name;
      this.parent = parent;
      this.offset = offset;
      this.attributes = try Vec<Attribute>(a, 4);
    }

    /** Compares an attribute without allocating a temporary during declaration lookup. */
    const method attr_equals(name: static_ptr<u8>, value: const ref String) bool {
      for (var i: i64 = 0; i < this.attributes.size(); i += 1) {
        if (this.attributes[i].name.equals_literal(name)) {
          return this.attributes[i].value.equals(value);
        }
      }
      return false;
    }

    /** Copies an attribute value, using an empty string for absence. */
    const method attr(name: static_ptr<u8>) std.AllocationResult<String> {
      var a = make_heap_allocator();
      for (var i: i64 = 0; i < this.attributes.size(); i += 1) {
        if (this.attributes[i].name.equals_literal(name)) {
          return std.AllocationResult.Ok(try this.attributes[i].value.clone(a));
        }
      }
      return std.AllocationResult.Ok(try String(""));
    }
  }

  /** Escapes a decoded XML value as a Sun string literal. */
  function quote(value: const ref String) std.AllocationResult<String> {
    var result = try String("\"");
    for (var i: i64 = 0; i < value.length(); i += 1) {
      var c = match value.at(i) {
        AccessResult.Ok(c) => c,
        AccessResult.OutOfBounds(_) => 0
      };
      if (c == 34) {
        try result.append("\\\"");
      } else if (c == 92) {
        try result.append("\\\\");
      } else if (c == 10) {
        try result.append("\\n");
      } else if (c == 13) {
        try result.append("\\r");
      } else if (c == 9) {
        try result.append("\\t");
      } else {
        try result.append_char(c);
      }
    }
    try result.append("\"");
    return std.AllocationResult.Ok(result);
  }

  /** Recognizes a single Sun identifier used for generated declarations. */
  function identifier(value: const ref String) bool {
    if (value.is_empty()) {
      return false;
    }
    for (var i: i64 = 0; i < value.length(); i += 1) {
      var c = match value.at(i) {
        AccessResult.Ok(c) => c,
        AccessResult.OutOfBounds(_) => 0
      };
      if (not ((c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 or
        (i > 0 and c >= 48 and c <= 57))) {
        return false;
      }
    }
    return true;
  }

  /** Recognizes a qualified Sun function name without permitting executable code. */
  function qualified(value: const ref String) std.AllocationResult<bool> {
    var a = make_heap_allocator();
    var parts = try value.split(a, b'.');
    if (parts.size() == 0) {
      return std.AllocationResult.Ok(false);
    }
    for (var part: ref String in parts) {
      if (not identifier(part)) {
        return std.AllocationResult.Ok(false);
      }
    }
    return std.AllocationResult.Ok(true);
  }

  /** Restricts markup dependencies to relative files below their declaring directory. */
  public function import_path(value: const ref String) std.AllocationResult<bool> {
    if (value.starts_with("/") or not value.ends_with(".view.xml") or value.contains("\\")) {
      return std.AllocationResult.Ok(false);
    }
    var a = make_heap_allocator();
    var parts = try value.split(a, b'/');
    for (var part: ref String in parts) {
      if (part.is_empty() or part.equals_literal(".") or part.equals_literal("..")) {
        return std.AllocationResult.Ok(false);
      }
    }
    return std.AllocationResult.Ok(true);
  }

  /** Extracts a whole-attribute expression or emits a typed literal. */
  function expression(value: const ref String, string_value: bool) std.Result<String> {
    var a = make_heap_allocator();
    if (value.starts_with("{") and value.ends_with("}")) {
      return std.Result.Ok(match try sun_ui_results.access(value.substr(a, 1, value.length() - 2)) {
        AccessResult.Ok(text) => text,
        AccessResult.OutOfBounds(_) => try String("")
      });
    }
    if (string_value) {
      var result = try String("try String(");
      try result.append(try quote(value));
      try result.append(")");
      return std.Result.Ok(result);
    }
    return std.Result.Ok(try value.clone(a));
  }

  /** Tests whether a tag names a built-in UI node. */
  function builtin(name: const ref String) bool {
    return name.equals_literal("Group") or name.equals_literal("Row") or
      name.equals_literal("Column") or name.equals_literal("Grid") or
      name.equals_literal("Scroll") or name.equals_literal("Label") or
      name.equals_literal("Button") or name.equals_literal("TextInput") or
      name.equals_literal("Checkbox") or name.equals_literal("Select") or
      name.equals_literal("Video") or name.equals_literal("Viewport") or
      name.equals_literal("Image");
  }

  /** Owns a discovered component signature without retaining its source parser. */
  class Registration {
    var name: String;
    var function_name: String;
    var source: String;
    var inputs: Vec<Node>;

    /** Takes the component identity and allocates its typed input declarations. */
    init(name: String, function_name: String, source: String) std.AllocationResult<void> {
      this.name = name;
      this.function_name = function_name;
      this.source = source;
      this.inputs = try Vec<Node>(make_heap_allocator(), 4);
    }
  }

  /** Holds application component names discovered before any view is generated. */
  public class Registry {
    var entries: Vec<Registration>;

    /** Creates an isolated registry for one application compilation. */
    init(a: const ref HeapAllocator) std.AllocationResult<void> {
      this.entries = try Vec<Registration>(a, 8);
    }
  }

  /** Owns parsing, validation, generated source, and its source map for one file. */
  public class Compiler {
    var input: String;
    var filename: String;
    var nodes: Vec<Node>;
    public var output: String ;
    public var imports: Vec<String>;
    public var source_map: String ;
    var line: i64 = 1;
    var prepared: bool = false;

    /** Takes original input without normalizing offsets or retaining external borrows. */
    init(filename: String, input: String) std.AllocationResult<void> {
      this.output = try String("");
      this.source_map = try String("");

      var a = make_heap_allocator();
      this.filename = filename;
      this.input = input;
      this.nodes = try Vec<Node>(a, 32);
      this.imports = try Vec<String>(a, 4);
    }

    /** Formats a semantic diagnostic at an original byte offset. */
    method failure(offset: i64, message: static_ptr<u8>) std.AllocationResult<Error> {
      var a = make_heap_allocator();
      var line: i64 = 1;
      var column: i64 = 1;
      for (var i: i64 = 0; i < offset; i += 1) {
        var c = match this.input.at(i) {
          AccessResult.Ok(c) => c,
          AccessResult.OutOfBounds(_) => 0
        };
        if (c == 13) {
          line += 1;
          column = 1;
        } else if (c == 10) {
          var previous = i > 0 ? match this.input.at(i - 1) {
            AccessResult.Ok(c) => c,
            AccessResult.OutOfBounds(_) => 0
          } : 0;
          if (previous != 13) {
            line += 1;
          }
          column = 1;
        } else if (c < 128 or c >= 192) {
          column += 1;
        }
      }
      var text = try this.filename.clone(a);
      try text.append(":");
      try text.append(line);
      try text.append(":");
      try text.append(column);
      try text.append(": ");
      try text.append(message);
      return std.AllocationResult.Ok(try Error(1, text));
    }

    /** Copies one reader element while its borrow remains valid. */
    method node(element: const ref std.xml.XmlElement, parent: i64, offset: i64) std.Result<Node> {
      var a = make_heap_allocator();
      var node = try Node(try element.name().local().clone(a), parent, offset);
      if (not element.name().uri().is_empty()) {
        node.name = try String("unsupported-namespace");
      }
      for (var i: i64 = 0; i < element.attribute_count(); i += 1) {
        var name = try element.attribute_name(i);
        var offset = node.offset;
        match try element.attribute_source_span(i) {
          Option.Some(span) => {
            offset = span.start;
          },
          Option.None => {}
        };
        match element.attribute(name) {
          Option.Some(value) => {
            var attribute_name = try name.local().clone(a);
            if (not name.uri().is_empty()) {
              attribute_name = try String("unsupported-namespace");
            }
            try node.attributes.push(Attribute(attribute_name, try value.clone(a), offset));
          },
          Option.None => {}
        };
      }
      return std.Result.Ok(node);
    }

    /** Parses exclusively through stdlib events and preserves their source spans. */
    method parse() std.Result<void> {
      var a = make_heap_allocator();
      var reader = try std.xml.XmlReader(a, this.input);
      var parent: i64 = -1;
      while (true) {
        match try reader.next() {
          Option.None => {
            return std.Result.Ok;
          },
          Option.Some(event) => {
            match event {
              std.xml.XmlEvent.Start(element) => {
                var node = try this.node(element, parent, reader.source_span().start);
                parent = this.nodes.size();
                try this.nodes.push(node);
              },
              std.xml.XmlEvent.End(_) => {
                parent = this.nodes[parent].parent;
              },
              std.xml.XmlEvent.Text(text) => {
                text.trim();
                if (not text.is_empty()) {
                  try this.nodes.push(
                    try Node(try String("unexpected-text"), parent, reader.source_span().start)
                  );
                }
              },
              std.xml.XmlEvent.Comment(_) => {},
              std.xml.XmlEvent.Instruction(_) => {}
            };
          }
        };
      }
      return std.Result.Ok;
    }

    /** Adds generated lines and their corresponding original input offsets. */
    method emit(text: const ref String, offset: i64) std.AllocationResult<void> {
      try this.source_map.append(this.line);
      try this.source_map.append("\t");
      try this.source_map.append(offset);
      try this.source_map.append("\n");
      try this.output.append(text);
      try this.output.append("\n");
      this.line += 1;
      for (var i: i64 = 0; i < text.length(); i += 1) {
        match text.at(i) {
          AccessResult.Ok(c) => {
            if (c == 10) {
              this.line += 1;
            }
          },
          AccessResult.OutOfBounds(_) => {}
        };
      }
    
      return std.AllocationResult.Ok;
}

    /** Rejects attributes outside a declaration's supported vocabulary. */
    method attributes(index: i64, allowed: static_ptr<u8>) std.Result<void> {
      var a = make_heap_allocator();
      var names = try (try String(allowed)).split_whitespace(a);
      for (var i: i64 = 0; i < this.nodes[index].attributes.size(); i += 1) {
        var found = false;
        for (var name: ref String in names) {
          if (name.equals(this.nodes[index].attributes[i].name)) {
            found = true;
            break;
          }
        }
        if (not found) {
          return std.Result.Error(
            try this.failure(this.nodes[index].attributes[i].offset, "Unknown attribute")
          );
        }
      }
      return std.Result.Ok;
    }

    /** Finds the component declaration enclosing a slot. */
    const method component_owner(index: i64) i64 {
      var current = this.nodes[index].parent;
      while (current > 0) {
        if (this.nodes[current].name.equals_literal("Component") or
          this.nodes[current].name.equals_literal("Template")) {
          return current;
        }
        current = this.nodes[current].parent;
      }
      return -1;
    }

    /** Finds a named XML content input on a component declaration. */
    const method content_input(owner: i64, name: const ref String) i64 {
      for (var p = owner + 1; p < this.nodes.size(); p += 1) {
        if (this.nodes[p].parent == owner and this.nodes[p].name.equals_literal("Content") and
          this.nodes[p].attr_equals("name", name)) {
          return p;
        }
      }
      return -1;
    }

    /** Checks content signatures and their single unconditional insertion points. */
    method validate_content(owner: i64) std.Result<void> {
      for (var p = owner + 1; p < this.nodes.size(); p += 1) {
        if (this.nodes[p].parent != owner) {
          continue;
        }
        var content = this.nodes[p].name.equals_literal("Content");
        if (not content and not this.nodes[p].name.equals_literal("Param")) {
          continue;
        }
        var name = try this.nodes[p].attr("name");
        if (not identifier(name)) {
          return std.Result.Error(
            try this.failure(this.nodes[p].offset, "Expected component input identifier")
          );
        }
        for (var previous = owner + 1; previous < p; previous += 1) {
          if (this.nodes[previous].parent == owner and
            (this.nodes[previous].name.equals_literal("Content") or
              this.nodes[previous].name.equals_literal("Param")) and
            this.nodes[previous].attr_equals("name", name)) {
            return std.Result.Error(
              try this.failure(this.nodes[p].offset, "Duplicate component input")
            );
          }
        }
        if (not content) {
          continue;
        }
        try this.attributes(p, "name");
        for (var nested = p + 1; nested < this.nodes.size(); nested += 1) {
          if (this.nodes[nested].parent == p) {
            return std.Result.Error(
              try this.failure(
                this.nodes[nested].offset,
                "Content declaration cannot contain children"
              )
            );
          }
        }
        if (this.nodes[owner].name.equals_literal("Import")) {
          continue;
        }
        var count: i64 = 0;
        for (var slot = owner + 1; slot < this.nodes.size(); slot += 1) {
          if (not this.nodes[slot].name.equals_literal("Slot") or
            this.component_owner(slot) != owner or not this.nodes[slot].attr_equals("name", name)) {
            continue;
          }
          count += 1;
          var parent = this.nodes[slot].parent;
          while (parent != owner) {
            var tag: const ref String = this.nodes[parent].name;
            if (tag.equals_literal("If") or tag.equals_literal("For") or
              tag.equals_literal("Else") or tag.contains(".")) {
              return std.Result.Error(
                try this.failure(
                  this.nodes[slot].offset,
                  "Content slot must have an unconditional insertion point"
                )
              );
            }
            parent = this.nodes[parent].parent;
          }
        }
        if (count != 1) {
          return std.Result.Error(
            try this.failure(
              this.nodes[p].offset,
              "Content requires exactly one Slot insertion point"
            )
          );
        }
      }
      for (var slot = owner + 1; slot < this.nodes.size(); slot += 1) {
        if (not this.nodes[slot].name.equals_literal("Slot") or
          this.component_owner(slot) != owner) {
          continue;
        }
        var name = try this.nodes[slot].attr("name");
        var declared = this.content_input(owner, name) >= 0;
        for (var p = owner + 1; p < this.nodes.size(); p += 1) {
          if (this.nodes[p].parent == owner and this.nodes[p].name.equals_literal("Param") and
            this.nodes[p].attr_equals("name", name)) {
            declared = true;
          }
        }
        if (not declared) {
          return std.Result.Error(try this.failure(this.nodes[slot].offset, "Unknown slot input"));
        }
      }
      return std.Result.Ok;
    }

    /** Compiles children in source order under one UI parent expression. */
    method children(index: i64, parent: const ref String) std.Result<void> {
      var owner: const ref String = this.nodes[index].name;
      var component = owner.equals_literal("View") or owner.equals_literal("Component") or
        owner.equals_literal("Template");
      if (component) {
        for (var r = index + 1; r < this.nodes.size(); r += 1) {
          if (this.nodes[r].parent == index and this.nodes[r].name.equals_literal("Resources")) {
            try this.resources(r, true);
          }
        }
      }
      for (var i = index + 1; i < this.nodes.size(); i += 1) {
        if (this.nodes[i].parent != index) {
          continue;
        }
        var name: const ref String = this.nodes[i].name;
        if (component and name.equals_literal("Resources")) {
          continue;
        }
        var owner: const ref String = this.nodes[index].name;
        if ((name.equals_literal("Param") or name.equals_literal("Content")) and
          (owner.equals_literal("Component") or owner.equals_literal("Template"))) {
          continue;
        }
        if ((name.equals_literal("Grid.Rows") or name.equals_literal("Grid.Columns")) and
          owner.equals_literal("Grid")) {
          continue;
        }
        if (name.equals_literal("Select.Options") and owner.equals_literal("Select")) {
          continue;
        }
        try this.child(i, parent);
      }
      return std.Result.Ok;
    }

    /** Resolves literal template names lexically, then through application and theme dictionaries. */
    method template_resource(
      index: i64,
      name: const ref String,
      theme_only: bool
    ) std.Result<i64> {
      var owner = index;
      while (owner >= 0) {
        var candidate: i64 = -1;
        for (var r: i64 = 1; r < this.nodes.size(); r += 1) {
          var dictionary = this.nodes[r].parent;
          if (dictionary < 0 or not this.nodes[dictionary].name.equals_literal("Resources") or
            this.nodes[dictionary].parent != owner) {
            continue;
          }
          var key = try this.nodes[r].attr("name");
          if (not key.equals(name)) {
            continue;
          }
          var scope = try this.nodes[r].attr("scope");
          if (theme_only and not scope.equals_literal("theme")) {
            continue;
          }
          if (candidate < 0 or not scope.equals_literal("theme")) {
            candidate = r;
          }
        }
        if (candidate >= 0) {
          if (not this.nodes[candidate].name.equals_literal("Template")) {
            return std.Result.Error(
              try this.failure(
                this.nodes[candidate].offset,
                "Resource type mismatch: expected Template"
              )
            );
          }
          return std.Result.Ok(candidate);
        }
        owner = this.nodes[owner].parent;
      }
      return std.Result.Error(
        try this.failure(this.nodes[index].offset, "Missing template resource")
      );
    }

    /** Resolves template aliases to a declared function whose parameters define the resource type. */
    method template_target(index: i64) std.Result<i64> {
      var current = index;
      for (var depth: i64 = 0; depth <= this.nodes.size(); depth += 1) {
        var reference = try this.nodes[current].attr("ref");
        if (not reference.is_empty()) {
          var scope = try this.nodes[current].attr("scope");
          current = try this.template_resource(
            this.nodes[this.nodes[current].parent].parent,
            reference,
            scope.equals_literal("theme")
          );
          continue;
        }
        var value = try this.nodes[current].attr("value");
        for (var d: i64 = 1; d < this.nodes.size(); d += 1) {
          if (this.nodes[d].parent != 0) {
            continue;
          }
          var tag: const ref String = this.nodes[d].name;
          if (not (tag.equals_literal("Template") or tag.equals_literal("Component") or
            tag.equals_literal("Import"))) {
            continue;
          }
          var name = try this.nodes[d].attr("name");
          if (name.equals(value)) {
            return std.Result.Ok(d);
          }
        }
        return std.Result.Error(
          try this.failure(
            this.nodes[current].offset,
            "Template resource requires a declared component function"
          )
        );
      }
      return std.Result.Error(try this.failure(this.nodes[index].offset, "Template resource cycle"));
    }

    /** Emits a typed function-valued resource; Sun checks even unused imported signatures. */
    method template_factory(index: i64) std.Result<void> {
      var target = try this.template_target(index);
      var function_name = try this.nodes[target].attr("function");
      if (function_name.is_empty()) {
        function_name = try this.nodes[target].attr("name");
      }
      try this.emit(
        try String("/** Returns the typed component function stored by this template resource. */"),
        this.nodes[index].offset
      );
      var line = try `function template_resource_${index}() function (ref ui.View, i64`;
      for (var p = target + 1; p < this.nodes.size(); p += 1) {
        if (this.nodes[p].parent == target and this.nodes[p].name.equals_literal("Param")) {
          var type = try this.nodes[p].attr("type");
          try line.append(", ");
          try line.append(type);
        } else if (this.nodes[p].parent == target and this.nodes[p].name.equals_literal("Content")) {
          try line.append(", ref ui.ContentSlot");
        }
      }
      try line.append(") SystemResult<void> { return ");
      try line.append(function_name);
      try line.append("; }");
      try this.emit(line, this.nodes[index].offset);
      return std.Result.Ok;
    }

    /** Finds the view that owns a declaration, excluding independent component definitions. */
    const method action_owner(index: i64) i64 {
      var current = index;
      while (current >= 0) {
        if (this.nodes[current].name.equals_literal("View")) {
          return current;
        }
        current = this.nodes[current].parent;
      }
      return -1;
    }

    /** Creates a deterministic route namespace separate from numeric application actions. */
    const method action_scope(index: i64) std.AllocationResult<String> {
      var name = try this.nodes[index].attr("name");
      return std.AllocationResult.Ok(try `${this.filename}#${name}`);
    }

    /** Emits queued dispatch to named functions or methods, preserving numeric fallback handling. */
    method action_dispatch(index: i64) std.Result<void> {
      var name = try this.nodes[index].attr("name");
      var state = try this.nodes[index].attr("state");
      var fallback = try this.nodes[index].attr("fallback");
      if (not fallback.is_empty() and not try qualified(fallback)) {
        return std.Result.Error(
          try this.failure(this.nodes[index].offset, "Fallback requires a function name")
        );
      }
      try this.emit(
        try String(
          "/** Dispatches captured actions to typed Sun handlers after native event collection. */"
        ),
        this.nodes[index].offset
      );
      var line = try `function ${name}_handle(state: ref ${state}, event: const ref ui.Event, queue: ref ui.EventQueue) SystemResult<void> {`;
      try this.emit(line, this.nodes[index].offset);
      var scope = try this.action_scope(index);
      line = try String("var scope = ");
      try line.append(try expression(scope, true));
      try line.append(";");
      try this.emit(line, this.nodes[index].offset);
      try this.emit(try String("if (event.action_scope.equals(scope)) {"), this.nodes[index].offset);
      for (var n = index + 1; n < this.nodes.size(); n += 1) {
        if (this.action_owner(n) != index or not builtin(this.nodes[n].name)) {
          continue;
        }
        for (var attribute: ref Attribute in this.nodes[n].attributes) {
          if (not (attribute.name.equals_literal("action") or
            attribute.name.equals_literal("changeAction")) or not try qualified(attribute.value)) {
            continue;
          }
          var id = n * 2 + (attribute.name.equals_literal("changeAction") ? 1 : 0);
          line = try `if (event.action == ${id}) { return `;
          try line.append(attribute.value);
          try line.append(
            attribute.value.starts_with("state.") ? "(event, queue); }" : "(state, event, queue); }"
          );
          try this.emit(line, attribute.offset);
        }
      }
      try this.emit(
        try String("return SystemResult.Error(Error(1, \"Unknown generated action\")); }"),
        this.nodes[index].offset
      );
      try this.emit(
        try String(
          "if (not event.action_scope.is_empty()) { return SystemResult.Error(Error(1, \"Action belongs to another view\")); }"
        ),
        this.nodes[index].offset
      );
      if (fallback.is_empty()) {
        try this.emit(try String("return SystemResult.Ok;"), this.nodes[index].offset);
      } else {
        line = try `return ${fallback}`;
        try line.append(fallback.starts_with("state.") ? "(event, queue);" : "(state, event, queue);");
        try this.emit(line, this.nodes[index].offset);
      }
      try this.emit(try String("}"), this.nodes[index].offset);
      return std.Result.Ok;
    }

