          for (var previous: i64 = 0; previous < c; previous += 1) {
            if (node.choices[c].key.equals(node.choices[previous].key)) {
              throw Error(1, "Duplicate select option key");
            }
          }
        }
        for (var j: i64 = 0; j < i; j += 1) {
          if (node.kind != Kind.Group and view.elements[j].kind != Kind.Group and physical >= 0 and
            view.elements[physical].kind == Kind.Scroll and
            this.physical_parent(view, j) == physical) {
            throw Error(1, "Scroll requires a single physical child");
          }
          if (view.elements[j].parent == node.parent) {
            if (view.elements[j].key.equals(node.key)) {
              throw Error(1, "Duplicate sibling key");
            }
          }
        }
      }
      return;
    }

    /** Removes unmatched subtrees before placement, including single-child replacements. */
    method prune(renderer: ref Renderer, view: const ref View) void throws {
      var a = make_heap_allocator();
      var identities = Vec<u64>(a, view.elements.size());
      for (var i: i64 = 0; i < view.elements.size(); i += 1) {
        var node = view.elements[i];
        var parent: u64 = node.parent < 0 ? 0 : identities[node.parent];
        var index = node.parent >= 0 and parent == 0 ? -1 : this.index(parent, node.key);
        identities.push(
          index >= 0 and this.mounted[index].element.kind == node.kind and
            this.mounted[index].element.template_id.equals(node.template_id) ? this.mounted[index].identity : 0
        );
      }
      for (var i = this.mounted.size() - 1; i >= 0; i -= 1) {
        var keep = false;
        for (var j: i64 = 0; j < identities.size(); j += 1) {
          if (identities[j] == this.mounted[i].identity) {
            keep = true;
            break;
          }
        }
        if (not keep) {
          renderer.remove(this.mounted[i].identity);
          try {
            this.mounted.remove(i);
          } catch (error: std.IndexOutOfBoundsError) {}
        }
      }

      return;
    }

    /** Builds the next mounted order and releases unmatched descendants before parents. */
    method commit(renderer: ref Renderer, view: ref View) void throws {
      var a = make_heap_allocator();
      var next = Vec<Mounted>(a, view.elements.size());
      this.prune(renderer, view);
      while (view.elements.size() > 0) {
        var element_outcome: std.Option<Element> = std.Option.None;

        try {
          var value = view.elements.remove(0);

          element_outcome = std.Option.Some(value);
        } catch (error: std.IndexOutOfBoundsError) {
          throw Error(1, "Internal index error");
        }

        var element = match element_outcome {
          std.Option.Some(value) => value,
          std.Option.None => {
            throw std.Error(1, "Exception handler produced no value");
          }
        };
        var parent: u64 = element.parent < 0 ? 0 : next[element.parent].identity;
        var previous: u64 = 0;
        for (var i = next.size() - 1; i >= 0; i -= 1) {
          if (next[i].parent == parent) {
            previous = next[i].identity;
            break;
          }
        }
        var index = this.index(parent, element.key);
        var id: u64 = 0;
        if (index >= 0 and this.mounted[index].element.kind == element.kind and
          this.mounted[index].element.template_id.equals(element.template_id)) {
          var old_outcome: std.Option<Mounted> = std.Option.None;

          try {
            var value = this.mounted.remove(index);

            old_outcome = std.Option.Some(value);
          } catch (error: std.IndexOutOfBoundsError) {
            throw Error(1, "Internal index error");
          }

          var old = match old_outcome {
            std.Option.Some(value) => value,
            std.Option.None => {
              throw std.Error(1, "Exception handler produced no value");
            }
          };
          id = old.identity;
          if (old.dirty or not old.element.equals(element)) {
            renderer.update(id, element);
          }
        } else {
          if (this.next_identity == 0) {
            throw Error(1, "Mounted identities exhausted");
          }
          id = this.next_identity;
          this.next_identity += 1;
          renderer.create(id, element);
        }
        renderer.place(id, parent, previous);
        next.push(Mounted(id, parent, element));
      }
      for (var i = this.mounted.size() - 1; i >= 0; i -= 1) {
        renderer.remove(this.mounted[i].identity);
      }
      renderer.finish();
      this.mounted = next;
      if (view.focus_path.size() > 0) {
        var id = this.identity_path(view.focus_path);
        if (id != 0) {
          renderer.focus(id);
        }
      } else {
        match view.focus_key {
          Option.Some(key) => {
            var id = this.identity(key);
            if (id != 0) {
              renderer.focus(id);
            }
          },
          Option.None => {}
        };
      }
      return;
    }

    /** Commits a valid description or clears resources after a renderer failure. */
    public method render(renderer: ref Renderer, view: View) void throws {
      if (this.stopped) {
        throw Error(1, "Tree is stopped");
      }
      if (not view.theme.valid()) {
        throw Error(1, "Invalid theme base");
      }
      validate_theme_defaults(view.control_defaults);
      for (var element: ref Element in view.elements) {
        var resolved = Style();
        resolved.overlay(view.theme);
        for (var entry: ref ThemeDefault in view.control_defaults) {
          if (entry.kind == element.kind) {
            resolved.overlay(entry.style);
          }
        }
        resolved.overlay(element.style);
        resolved.overlay(element.overrides);
        element.style = resolved;
      }
      this.validate(view);
      try {
        this.commit(renderer, view);
        return;
      } catch (error: std.Error) {
        this.shutdown(renderer);
        throw error;
      }
    }

    /** Captures a button action from a live identity. */
    public method enqueue(identity: u64, queue: ref EventQueue) void throws {
      this.enqueue_value(identity, EventValue(), queue);

      return;
    }

    /** Transfers an owned native edit value and captures current routing. */
    public method enqueue_value(
      identity: u64,
      value: EventValue,
      queue: ref EventQueue
    ) void throws {
      for (var item: ref Mounted in this.mounted) {
        if (item.identity == identity) {
          if (value.kind != ValueKind.None) {
            item.dirty = true;
          }
          var event = Event(identity, item.element.action, item.element.payload);
          event.action_scope = item.element.action_scope.clone(make_heap_allocator());
          event.value = value;
          queue.post(event);
          return;
        }
      }

      return;
    }

    /** Checks whether an event's mounted source still exists. */
    public const method alive(identity: u64) bool {
      for (var i: i64 = 0; i < this.mounted.size(); i += 1) {
        if (this.mounted[i].identity == identity) {
          return true;
        }
      }
      return false;
    }

    /** Reports whether the tree accepts renders and event dispatch. */
    public const method active() bool {
      return not this.stopped;
    }

    /** Idempotently releases resources and permanently stops this tree. */
    public method shutdown(renderer: ref Renderer) void {
      renderer.clear();
      this.mounted.clear();
      this.stopped = true;
    }
  }

  /** Owns application state and provides one bounded, nonrecursive dispatch boundary. */
  public class Session<State> {
    public var state: State;
    public var tree: Tree;
    public var queue: EventQueue;
    var dispatching: bool = false;
    var view: function (const ref State) View throws;
    var handle: function (ref State, const ref Event, ref EventQueue) void throws;

    /** Takes state ownership; named functions borrow it only for the duration of a call. */
    init(
      state: State,
      view: function (const ref State) View throws,
      handle: function (ref State, const ref Event, ref EventQueue) void throws
    ) throws {
      var a = make_heap_allocator();
      this.state = state;
      this.tree = Tree(a);
      this.queue = EventQueue(a);
      this.view = view;
      this.handle = handle;
    }

    /** Evaluates the pure view and commits it; call once before platform dispatch. */
    public method render(renderer: ref Renderer) void throws {
      var view = this.view(this.state);
      try {
        this.tree.render(renderer, view);
      } catch {
        if (not this.tree.active()) {
          this.queue.pending.clear();
        }
        throw;
      }
      if (not this.tree.active()) {
        this.queue.pending.clear();
      }
    }

    /** Processes only the current queue snapshot and batches one render afterwards. */
    public method dispatch(renderer: ref Renderer) void throws {
      if (not this.tree.active()) {
        this.queue.pending.clear();
        throw Error(1, "Tree is stopped");
      }
      if (this.dispatching) {
        throw Error(1, "Recursive dispatch is forbidden");
      }
      this.dispatching = true;
      var count = this.queue.pending.size();
      var changed = false;
      for (var i: i64 = 0; i < count; i += 1) {
        var event = this.queue.pending.remove(0);
        if (this.tree.alive(event.identity)) {
          try {
            this.handle(this.state, event, this.queue);
          } catch {
            this.tree.shutdown(renderer);
            this.queue.pending.clear();
            this.dispatching = false;
            throw;
          }
          changed = true;
        }
      }
      this.dispatching = false;
      if (changed) {
        this.render(renderer);
      }
      return;
    }
  }
}
