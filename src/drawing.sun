using std;

/** Provides owned vector drawings shared by export and platform drawing surfaces. */
public module ui_drawing {

  /** Escapes user text for XML content and quoted attributes. */
  public function escape(value: const ref String) String {
    var a = make_heap_allocator();
    var result = value.clone(a);
    result.replace("&", "&amp;");
    result.replace("<", "&lt;");
    result.replace(">", "&gt;");
    result.replace("\"", "&quot;");
    result.replace("'", "&apos;");
    return result;
  }

  /** Owns an SVG drawing in logical pixels; native viewers retain their own parsed copy. */
  public class Drawing {
    public var width: f64;
    public var height: f64;
    var body: String;

    /** Starts an explicitly sized white drawing. */
    init(width: f64, height: f64) {
      this.width = width;
      this.height = height;
      this.body = String("<rect width=\"100%\" height=\"100%\" fill=\"white\"/>\n");
    }

    /** Adds a stroked segment with an escaped CSS color. */
    public method line(x1: f64, y1: f64, x2: f64, y2: f64, color: const ref String, width: f64) void {
      var paint = escape(color);
      this.body.append(`<path d="M ${x1} ${y1} L ${x2} ${y2}" fill="none" stroke="${paint}" stroke-width="${width}" stroke-linecap="round"/>\n`);
    }

    /** Adds a filled circular marker. */
    public method circle(x: f64, y: f64, radius: f64, color: const ref String) void {
      var paint = escape(color);
      this.body.append(`<circle cx="${x}" cy="${y}" r="${radius}" fill="${paint}"/>\n`);
    }

    /** Adds selectable text, optionally centered and rotated about its baseline origin. */
    public method text(x: f64, y: f64, value: const ref String, size: f64, centered: bool, angle: f64) void {
      var content = escape(value);
      var anchor = String(centered ? "middle" : "start");
      this.body.append(`<text x="${x}" y="${y}" font-family="DejaVu Sans, sans-serif" font-size="${size}" fill="#202735" text-anchor="${anchor}" transform="rotate(${angle} ${x} ${y})">${content}</text>\n`);
    }

    /** Opens a clipped data group; pair with end_clip before serializing. */
    public method begin_clip(x: f64, y: f64, width: f64, height: f64) void {
      this.body.append(`<svg x="${x}" y="${y}" width="${width}" height="${height}" viewBox="${x} ${y} ${width} ${height}" overflow="hidden">\n`);
    }

    /** Closes the most recently opened clipping group. */
    public method end_clip() void {
      this.body.append("</svg>\n");
    }

    /** Copies a complete child drawing into a clipped viewport at its original logical size. */
    public method place(x: f64, y: f64, child: const ref Drawing) void {
      this.place_scaled(x, y, child.width, child.height, child);
    }

    /** Fits a child into a clipped viewport while preserving its aspect ratio and vector content. */
    public method place_scaled(x: f64, y: f64, width: f64, height: f64, child: const ref Drawing) void {
      this.body.append(`<svg x="${x}" y="${y}" width="${width}" height="${height}" viewBox="0 0 ${child.width} ${child.height}" overflow="hidden">\n`);
      this.body.append(child.body);
      this.body.append("</svg>\n");
    }

    /** Serializes a standalone vector image without touching the filesystem. */
    public const method svg() String {
      var result = String("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n");
      result.append(`<svg xmlns="http://www.w3.org/2000/svg" width="${this.width}" height="${this.height}" viewBox="0 0 ${this.width} ${this.height}">\n`);
      result.append(this.body);
      result.append("</svg>\n");
      return result;
    }

    /** Writes a standalone SVG, reporting filesystem failures to the caller. */
    public const method save(path: ref String) SystemResult<void> {
      var document = this.svg();
      return std.io.write_string(path, document);
    }
  }
}
