using std;

/** Provides owned vector drawings shared by export and platform drawing surfaces. */
public module ui_drawing {

  /** Escapes user text for XML content and quoted attributes. */
  public function escape(value: const ref String) AllocationResult<String> {
    var a = make_heap_allocator();
    var result = try value.clone(a);
    try result.replace("&", "&amp;");
    try result.replace("<", "&lt;");
    try result.replace(">", "&gt;");
    try result.replace("\"", "&quot;");
    try result.replace("'", "&apos;");
    return AllocationResult.Ok(result);
  }

  /** Owns an SVG drawing in logical pixels; native viewers retain their own parsed copy. */
  public class Drawing {
    public var width: f64;
    public var height: f64;
    var body: String;

    /** Starts an explicitly sized white drawing. */
    init(width: f64, height: f64) AllocationResult<void> {
      this.width = width;
      this.height = height;
      this.body = try String("<rect width=\"100%\" height=\"100%\" fill=\"white\"/>\n");
    }

    /** Adds a stroked segment with an escaped CSS color. */
    public method line(
      x1: f64,
      y1: f64,
      x2: f64,
      y2: f64,
      color: const ref String,
      width: f64
    ) AllocationResult<void> {
      var paint = try escape(color);
      try this.body.append(
        try `<path d="M ${x1} ${y1} L ${x2} ${y2}" fill="none" stroke="${paint}" stroke-width="${width}" stroke-linecap="round"/>\n`
      );

      return AllocationResult.Ok;
    }

    /** Adds a filled circular marker. */
    public method circle(
      x: f64,
      y: f64,
      radius: f64,
      color: const ref String
    ) AllocationResult<void> {
      var paint = try escape(color);
      try this.body.append(
        try `<circle cx="${x}" cy="${y}" r="${radius}" fill="${paint}"/>\n`
      );

      return AllocationResult.Ok;
    }

    /** Adds selectable text, optionally centered and rotated about its baseline origin. */
    public method text(
      x: f64,
      y: f64,
      value: const ref String,
      size: f64,
      centered: bool,
      angle: f64
    ) AllocationResult<void> {
      var content = try escape(value);
      var anchor = try String(centered ? "middle" : "start");
      try this.body.append(
        try `<text x="${x}" y="${y}" font-family="DejaVu Sans, sans-serif" font-size="${size}" fill="#202735" text-anchor="${anchor}" transform="rotate(${angle} ${x} ${y})">${content}</text>\n`
      );

      return AllocationResult.Ok;
    }

    /** Opens a clipped data group; pair with end_clip before serializing. */
    public method begin_clip(x: f64, y: f64, width: f64, height: f64) AllocationResult<void> {
      try this.body.append(
        try `<svg x="${x}" y="${y}" width="${width}" height="${height}" viewBox="${x} ${y} ${width} ${height}" overflow="hidden">\n`
      );

      return AllocationResult.Ok;
    }

    /** Closes the most recently opened clipping group. */
    public method end_clip() AllocationResult<void> {
      try this.body.append("</svg>\n");

      return AllocationResult.Ok;
    }

    /** Copies a complete child drawing into a clipped viewport at its original logical size. */
    public method place(x: f64, y: f64, child: const ref Drawing) AllocationResult<void> {
      try this.place_scaled(x, y, child.width, child.height, child);

      return AllocationResult.Ok;
    }

    /** Fits a child into a clipped viewport while preserving its aspect ratio and vector content. */
    public method place_scaled(
      x: f64,
      y: f64,
      width: f64,
      height: f64,
      child: const ref Drawing
    ) AllocationResult<void> {
      try this.body.append(
        try `<svg x="${x}" y="${y}" width="${width}" height="${height}" viewBox="0 0 ${child.width} ${child.height}" overflow="hidden">\n`
      );

      try this.body.append(child.body);
      try this.body.append("</svg>\n");

      return AllocationResult.Ok;
    }

    /** Serializes a standalone vector image without touching the filesystem. */
    public const method svg() AllocationResult<String> {
      var result = try String("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n");

      try result.append(
        try `<svg xmlns="http://www.w3.org/2000/svg" width="${this.width}" height="${this.height}" viewBox="0 0 ${this.width} ${this.height}">\n`
      );

      try result.append(this.body);
      try result.append("</svg>\n");
      return AllocationResult.Ok(result);
    }

    /** Writes a standalone SVG, reporting filesystem failures to the caller. */
    public const method save(path: ref String) SystemResult<void> {
      var document = try this.svg();
      return std.io.write_string(path, document);
    }
  }
}
