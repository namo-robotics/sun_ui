using std;

/** Owns one parsed source and its generated artifact destination. */
class SourceUnit {
  var input: String;
  var output: String;
  var compiler: markup.Compiler;
  var registered: bool;

  /** Transfers a parsed file into the generation graph. */
  init(input: String, output: String, compiler: markup.Compiler, registered: bool) {
    this.input = input;
    this.output = output;
    this.compiler = compiler;
    this.registered = registered;
  }
}

/** Owns one dependency traversal and its combined source with original-file mappings. */
class Generation {
  var active: Vec<String>;
  var seen: Vec<String>;
  var units: Vec<SourceUnit>;
  var source: String;
  var mapping: String;
  var line: i64 = 0;

  /** Allocates explicit recursion and deduplication storage. */
  init(a: const ref HeapAllocator) AllocationResult<void> {
    this.source = try String("");
    this.mapping = try String("");

    this.active = try Vec<String>(a, 4);
    this.seen = try Vec<String>(a, 4);
    this.units = try Vec<SourceUnit>(a, 4);
  }

  /** Adds one module exactly once and adjusts its map to the combined source. */
  method append(
    input: const ref String,
    compiler: const ref markup.Compiler
  ) AllocationResult<void> {
    var a = make_heap_allocator();
    var fields = try compiler.source_map.split_whitespace(a);
    for (var i: i64 = 0; i + 1 < fields.size(); i += 2) {
      var line = match fields[i].parse_i64() {
        Option.Some(value) => value,
        Option.None => 0
      };
      try this.mapping.append(this.line + line);
      try this.mapping.append("\t");
      try this.mapping.append(fields[i + 1]);
      try this.mapping.append("\t");
      try this.mapping.append(input);
      try this.mapping.append("\n");
    }
    try this.source.append(compiler.output);
    for (var i: i64 = 0; i < compiler.output.length(); i += 1) {
      match compiler.output.at(i) {
        AccessResult.Ok(c) => {
          if (c == 10) {
            this.line += 1;
          }
        },
        AccessResult.OutOfBounds(_) => {}
      };
    }

    return AllocationResult.Ok;
  }
}

/** Copies a path's directory, retaining its trailing separator. */
function directory(path: const ref String) std.Result<String> {
  var a = make_heap_allocator();
  var last: i64 = -1;
  for (var i: i64 = 0; i < path.length(); i += 1) {
    match path.at(i) {
      AccessResult.Ok(c) => {
        if (c == 47) {
          last = i;
        }
      },
      AccessResult.OutOfBounds(_) => {}
    };
  }
  if (last < 0) {
    return std.Result.Ok(try String("./"));
  }
  return std.Result.Ok(
    match try sun_ui_results.substring(path, a, 0, last + 1) {
      AccessResult.Ok(value) => value,
      AccessResult.OutOfBounds(_) => try String("./")
    }
  );
}

/** Writes one generated artifact after creating its containing directory. */
function publish(output: ref String, source: ref String, mapping: ref String) std.Result<void> {
  var a = make_heap_allocator();
  var mkdir = try std.process.Command(a, "mkdir");
  try mkdir.add_arg("-p");
  try mkdir.add_arg(try directory(output));
  if (try mkdir.status() != 0) {
    return std.Result.Error(Error(1, "Cannot create generated view directory"));
  }
  var map = try output.clone(a);
  try map.append(".map");
  try std.io.write_string(map, mapping);
  try std.io.write_string(output, source);
  return std.Result.Ok;
}

/** Parses the dependency graph before resolving registered component names. */
function collect(
  input: ref String,
  output: ref String,
  generation: ref Generation,
  registered: bool
) std.Result<void> {
  var a = make_heap_allocator();
  for (var i: i64 = 0; i < generation.active.size(); i += 1) {
    if (generation.active[i].equals(input)) {
      return std.Result.Error(Error(1, "Markup import cycle"));
    }
  }
  for (var i: i64 = 0; i < generation.seen.size(); i += 1) {
    if (generation.seen[i].equals(input)) {
      return std.Result.Ok;
    }
  }
  try generation.active.push(try input.clone(a));
  var compiler = try markup.Compiler(
    try input.clone(a),
    try std.io.read_to_string(a, input)
  );
  try compiler.prepare();
  for (var relative: ref String in compiler.imports) {
    var imported_input = try directory(input);
    try imported_input.append(relative);
    var imported_output = try directory(output);
    try imported_output.append(relative);
    try imported_output.replace(".view.xml", ".view.sun");
    try collect(imported_input, imported_output, generation, registered);
  }
  match generation.active.pop() {
    Option.Some(_) => {},
    Option.None => {}
  };
  try generation.seen.push(try input.clone(a));
  try generation.units.push(
    SourceUnit(
      try input.clone(a),
      try output.clone(a),
      compiler,
      registered
    )
  );

  return std.Result.Ok;
}

/** Reads explicitly listed sources from an XML application registry. */
function registry_sources(path: ref String) std.Result<Vec<String>> {
  var a = make_heap_allocator();
  var compiler = try markup.Compiler(
    try path.clone(a),
    try std.io.read_to_string(a, path)
  );
  return std.Result.Ok(try compiler.registry_sources());
}

/** Compiles registered components and views after discovering every typed signature. */
function run(input: ref String, output: ref String, registry_path: ref String) std.Result<void> {
  var a = make_heap_allocator();
  var generation = try Generation(a);
  if (not registry_path.is_empty()) {
    var sources = try registry_sources(registry_path);
    for (var relative: ref String in sources) {
      var source = try directory(registry_path);
      try source.append(relative);
      var artifact = try directory(output);
      try artifact.append("registered/");
      try artifact.append(relative);
      try artifact.replace(".view.xml", ".view.sun");
      try collect(source, artifact, generation, true);
    }
  }
  try collect(input, output, generation, false);
  var registry = try markup.Registry(a);
  for (var unit: ref SourceUnit in generation.units) {
    if (unit.registered) {
      try unit.compiler.register_components(registry);
    }
  }
  for (var unit: ref SourceUnit in generation.units) {
    try unit.compiler.use_registry(registry);
    try unit.compiler.compile();
    try generation.append(unit.input, unit.compiler);
  }
  // Publish only after every source has passed generation checks.
  for (var unit: ref SourceUnit in generation.units) {
    try publish(unit.output, unit.compiler.output, unit.compiler.source_map);
  }
  return publish(output, generation.source, generation.mapping);
}

/** Generates a view with an optional explicit or adjacent application registry. */
function main(argc: i32, argv: raw_ptr<raw_ptr<i8>>) std.Result<i32> {
  var a = make_heap_allocator();
  var env = try std.env.Env(a);
  var args = try env.args(argc, argv);
  if (args.size() != 3 and args.size() != 5) {
    std.io.eprintln("Usage: sun_viewc INPUT.view.xml OUTPUT.sun [--registry COMPONENTS.xml]");
    return std.Result.Ok(1);
  }
  var registry_path = try directory(args[1]);
  try registry_path.append("components.registry.xml");
  if (args.size() == 5) {
    if (not args[3].equals_literal("--registry")) {
      std.io.eprintln("Expected --registry COMPONENTS.xml");
      return std.Result.Ok(1);
    }
    registry_path = try args[4].clone(a);
  } else if (not try std.io.exists(registry_path)) {
    registry_path = try String("");
  }
  return std.Result.Ok(
    match run(args[1], args[2], registry_path) {
      std.Result.Ok => 0,
      (error: const ref IError) => {
        std.io.eprintln(try error.message());
        return std.Result.Ok(1);
      }
    }
  );
}
manifest {
  libraries: [
    "stdlib.moon"
  ], source_files: [
    "../results.sun",
    "../markup/compiler.sun"
  ]
}
