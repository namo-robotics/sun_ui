using std;

/** Verifies reader and attribute spans in the selected compiler's standard library. */
function main() i32 throws {
  var a = make_heap_allocator();
  var input = String("<probe value=\"1\"/>");
  var reader = std.xml.XmlReader(a, input);

  var operation_completed_2 = false;
  try {
    var event = reader.next();
    operation_completed_2 = true;
    match event {
      Option.Some(value) => {
        match value {
          std.xml.XmlEvent.Start(element) => {
            var span = reader.source_span();
            if (span.start != 0 or span.end != input.length()) {
              return 1;
            }

            var operation_completed_1 = false;
            try {
              var attribute = element.attribute_source_span(0);
              operation_completed_1 = true;
              match attribute {
                Option.Some(range) => {
                  return range.start == 7 and range.end == 16 ? 0 : 1;
                },
                Option.None => {
                  return 1;
                }
              };
            } catch (error: std.xml.XmlError) {
              if (operation_completed_1) {
                throw;
              }
              return 1;
            }
          },
          _ => {
            return 1;
          }
        };
      },
      Option.None => {
        return 1;
      }
    };
  } catch {
    if (operation_completed_2) {
      throw;
    }
    return 1;
  }

  return 1;
}
manifest {
  source_files: [
    "../results.sun"
  ]
  libraries: [
    "stdlib.moon"
  ]
}
