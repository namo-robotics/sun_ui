using std;

/** Builds the platform-independent package and optional GTK prototypes. */
module build_tasks {

  /** Runs a child command and preserves its failure as a build error. */
  function run(command: ref std.process.Command) SystemResult<void> {
    var status = try command.status();
    if (status != 0) {
      return SystemResult.Error(Error(status, "Build command failed"));
    }
    return SystemResult.Ok;
  }

  /** Reads an explicit environment override or copies the default value. */
  function setting(name: static_ptr<u8>, fallback: static_ptr<u8>) String {
    var a = make_heap_allocator();
    var env = std.env.Env(a);
    return match env.get(name) {
      Option.Some(value) => value.clone(a),
      Option.None => String(fallback)
    };
  }

  /** Configures the compiler with local bundles and an optional GTK dependency. */
  function compiler(gtk: bool) SystemResult<std.process.Command> {
    var a = make_heap_allocator();
    var executable = setting("SUN_EXECUTABLE", "sun");
    var command = std.process.Command(a, executable);
    command.add_arg("--dynamic");
    if (gtk) {
      var dependency = setting("SUN_GOBJECT_BUILD", "src/sun_gobject/build");
      command.add_arg("--lib-path");
      command.add_arg(dependency);
      var native = String("-L");
      native.append(dependency);
      native.append("/native");
      command.add_arg(native);
      command.add_arg("-l:libsun_gobject_native.a");
      var pkg = std.process.Command(a, "pkg-config");
      pkg.add_arg("--libs");
      pkg.add_arg("gtk4");
      var output = try pkg.output();
      if (output.status() != 0) {
        eprintln(output.stderr());
        return SystemResult.Error(Error(1, "Install GTK development dependencies"));
      }
      var flags = output.stdout().split_whitespace(a);
      for (var flag: ref String in flags) {
        command.add_arg(flag);
      }
      command.add_arg("-l:librsvg-2.so.2");
      // External native archives are outside the compiler's source cache.
      command.add_arg("--force-rebuild");
    }
    return SystemResult.Ok(command);
  }

  /** Compiles a named configuration entry with optional native GTK dependencies. */
  function compile(name: static_ptr<u8>, gtk: bool) SystemResult<void> {
    var target = try build_targets.load(name);
    var command = try compiler(gtk);
    command.add_arg(target.library ? "--emit-moon" : "-c");
    command.add_arg("-o");
    command.add_arg(target.output);
    command.add_arg(target.source);
    var source_path = target.source.clone(make_heap_allocator());
    if (source_path.equals_literal("examples/counter-xml/main.sun") or source_path.equals_literal("examples/tasks-xml/main.sun") or source_path.equals_literal("examples/forms/main.sun")) {
      var result = try command.output();
      print(result.stdout());
      eprint(result.stderr());
      if (result.status() != 0) {
        var a = make_heap_allocator();
        var parts = source_path.split(a, b'/');
        var view = parts[1].clone(a);
        view.replace("-xml", "");
        view.append(".view.xml");
        var original = String("examples/");
        original.append(parts[1]);
        original.append("/");
        original.append(view);
        var generated = String("build/generated/");
        generated.append(original);
        generated.replace(".view.xml", ".view.sun");
        ignore_error(build_diagnostics.annotate(result.stderr(), generated, original));
        return SystemResult.Error(Error(result.status(), "Generated view compilation failed"));
      }
      return SystemResult.Ok;
    }
    try run(command);
    return SystemResult.Ok;
  }

  /** Checks XML support before compiling products that require it. */
  function check_xml() SystemResult<void> {
    var a = make_heap_allocator();
    match compile("xml-probe", false) {
      SystemResult.Ok => {},
      SystemResult.Error(_) => {
        return SystemResult.Error(Error(1, "XML reader and source-span APIs are required. Run ./scripts/bootstrap-sun.sh --update or set SUN_EXECUTABLE to a current compiler."));
      }
    };
    var target = try build_targets.load("xml-probe");
    var check = std.process.Command(a, target.output);
    return run(check);
  }

  /** Runs a configured GTK program's acceptance scenario under a bounded virtual display. */
  function acceptance(name: static_ptr<u8>) SystemResult<void> {
    var a = make_heap_allocator();
    var target = try build_targets.load(name);
    var command = std.process.Command(a, "sh");
    command.add_arg("-eu");
    command.add_arg("-c");
    command.add_arg("export G_DEBUG=fatal-warnings GTK_A11Y=none GSK_RENDERER=cairo; timeout 30s dbus-run-session -- xvfb-run -a \"$1\" --self-test");
    command.add_arg("sun-ui-acceptance");
    command.add_arg(target.output);
    return run(command);
  }

  /** Builds core products without requiring GTK or sun_gobject. */
  public function build() SystemResult<void> {
    var a = make_heap_allocator();
    var mkdir = std.process.Command(a, "mkdir");
    mkdir.add_arg("-p");
    mkdir.add_arg("build");
    mkdir.add_arg("tmp");
    try run(mkdir);
    try check_xml();
    var executable = setting("SUN_EXECUTABLE", "sun");
    var version = std.process.Command(a, executable);
    version.add_arg("--version");
    var output = try version.output();
    var path = String("build/sun-version.txt");
    var text = output.stdout().clone(a);
    text.append(output.stderr());
    try std.io.write_string(path, text);
    try compile("sun_ui", false);
    try compile("sun_plot", false);
    try compile("tests", false);
    try compile("plot-tests", false);
    try compile("plot-export", false);
    return SystemResult.Ok;
  }

  /** Builds and tests markup tools using the selected compiler and its standard library. */
  public function markup() SystemResult<void> {
    var a = make_heap_allocator();
    var directory = std.process.Command(a, "mkdir");
    directory.add_arg("-p");
    directory.add_arg("build/generated/examples");
    try run(directory);
    try check_xml();
    try compile("viewc", false);
    try compile("markup-tests", false);
    var markup_target = try build_targets.load("markup-tests");
    var tests = std.process.Command(a, markup_target.tests);
    try run(tests);
    var viewc = try build_targets.load("viewc");
    var names = String("counter tasks forms").split_whitespace(a);
    for (var name: ref String in names) {
      var generate = std.process.Command(a, viewc.output);
      var example = name.clone(a);
      if (name.equals_literal("forms") == false) {
        example.append("-xml");
      }
      var input = String("examples/");
      input.append(example);
      input.append("/");
      input.append(name);
      input.append(".view.xml");
      var output = String("build/generated/examples/");
      output.append(example);
      output.append("/");
      output.append(name);
      output.append(".view.sun");
      generate.add_arg(input);
      generate.add_arg(output);
      try run(generate);
    }
    var scoped = std.process.Command(a, viewc.output);
    scoped.add_arg("tests/markup/scoped.view.xml");
    scoped.add_arg("build/generated/tests/markup/scoped.view.sun");
    try run(scoped);
    var actions = std.process.Command(a, viewc.output);
    actions.add_arg("tests/markup/actions.view.xml");
    actions.add_arg("build/generated/tests/markup/actions.view.sun");
    try run(actions);
    try compile("generated-view-tests", false);
    var generated_target = try build_targets.load("generated-view-tests");
    var generated_tests = std.process.Command(a, generated_target.tests);
    try run(generated_tests);
    return SystemResult.Ok;
  }

  /** Generates and compiles XML examples before their native acceptance checks. */
  public function markup_gtk() SystemResult<void> {
    try markup();
    try compile("counter-xml", true);
    try compile("tasks-xml", true);
    try compile("forms", true);
    try acceptance("counter-xml");
    try acceptance("tasks-xml");
    return acceptance("forms");
  }

  /** Builds the optional adapter and both native prototypes against an existing dependency build. */
  public function gtk() SystemResult<void> {
    try compile("sun_ui_gtk", true);
    try compile("counter", true);
    try compile("tasks", true);
    try plot_gtk();
    return SystemResult.Ok;
  }

  /** Builds the vector viewer against the checked GTK drawing bindings. */
  public function plot_gtk() SystemResult<void> {
    try compile("sun_ui_gtk_drawing", true);
    return compile("plot-viewer", true);
  }

  /** Exercises native vector drawing, replacement, and resize under a virtual display. */
  public function test_plot_gtk() SystemResult<void> {
    return acceptance("plot-viewer");
  }

  /** Runs the core tests or bounded GTK acceptance scenarios on a virtual display. */
  public function test(gtk: bool) SystemResult<void> {
    var a = make_heap_allocator();
    if (gtk == false) {
      var core = try build_targets.load("tests");
      var tests = std.process.Command(a, core.tests);
      try run(tests);
      var plot = try build_targets.load("plot-tests");
      var plot_tests = std.process.Command(a, plot.tests);
      try run(plot_tests);
      var export_target = try build_targets.load("plot-export");
      var example = std.process.Command(a, export_target.output);
      return run(example);
    }
    try acceptance("counter");
    try acceptance("tasks");
    return test_plot_gtk();
  }
}

/** Dispatches build and test tasks from the repository root. */
function main(argc: i32, argv: raw_ptr<raw_ptr<i8>>) i32 {
  var a = make_heap_allocator();
  var env = std.env.Env(a);
  var args = env.args(argc, argv);
  var result: SystemResult<void> = SystemResult.Ok;
  if (args.size() == 2 and args[1].equals_literal("build")) {
    result = build_tasks.build();
  } else if (args.size() == 2 and args[1].equals_literal("gtk")) {
    result = build_tasks.gtk();
  } else if (args.size() == 2 and args[1].equals_literal("test")) {
    result = build_tasks.test(false);
  } else if (args.size() == 2 and args[1].equals_literal("test-gtk")) {
    result = build_tasks.test(true);
  } else if (args.size() == 2 and args[1].equals_literal("plot-gtk")) {
    result = build_tasks.plot_gtk();
  } else if (args.size() == 2 and args[1].equals_literal("test-plot-gtk")) {
    result = build_tasks.test_plot_gtk();
  } else if (args.size() == 2 and args[1].equals_literal("markup")) {
    result = build_tasks.markup();
  } else if (args.size() == 2 and args[1].equals_literal("markup-gtk")) {
    result = build_tasks.markup_gtk();
  } else {
    eprintln("Usage: sun src/tools/build.sun -- [build|test|gtk|test-gtk|plot-gtk|test-plot-gtk|markup|markup-gtk]");
    return 1;
  }
  return match result {
    SystemResult.Ok => 0,
    SystemResult.Error(error) => {
      eprintln(error.message());
      return 1;
    }
  };
}
manifest { libraries: ["stdlib.moon"], source_files: ["diagnostics.sun", "targets.sun"] }
