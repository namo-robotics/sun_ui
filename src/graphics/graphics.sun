using std;

/** Provides explicitly owned drawing packets and independent surface state. */
public module gpu {

  /** Rejects embedded NUL bytes and invalid UTF-8 before a native string call. */
  public function validate_text(text: ref String) SystemResult<void> {
    if (unsafe { gu_text_valid(text.c_str(), _convert<u64>(text.length())); } == 0) {
      return SystemResult.Error(Error(1, "Graphics text must be UTF-8 without embedded NUL bytes"));
    }
    return SystemResult.Ok;
  }

  /** Selects triangle or line assembly from position triples. */
  public enum Primitive { Triangles, Lines }

  /** Distinguishes graphics input from semantic widget events. */
  public enum InputKind { Move, Button, Key, Scroll, Focus, Relative, Close }

  /** Owns a single input record; button releases use negative codes, key state is in x. */
  public class Input {
    public var kind: InputKind;
    public var code: i32;
    public var x: f64;
    public var y: f64;

    /** Copies a host event without retaining native storage. */
    init(kind: InputKind, code: i32, x: f64, y: f64) {
      this.kind = kind;
      this.code = code;
      this.x = x;
      this.y = y;
    }
  }

  /** Owns immutable CPU geometry; attribute zero contains packed XYZ positions. */
  public class Mesh {
    var pointer: raw_ptr<u8> = null;

    /** Copies position triples and optional indices after validating their bounds. */
    init(vertices: const ref Vec<f64>, indices: const ref Vec<i64>) SystemResult<void> {
      if (vertices.size() == 0 or vertices.size() % 3 != 0 or vertices.size() > 16777216 or indices.size() > 16777216) {
        return SystemResult.Error(Error(1, "Invalid mesh dimensions"));
      }
      for (var i: i64 = 0; i < vertices.size(); i += 1) {
        var v = vertices[i];
        if (v != v or v > 3.4e38 or v < -3.4e38) {
          return SystemResult.Error(Error(1, "Mesh positions must be finite"));
        }
      }
      for (var i: i64 = 0; i < indices.size(); i += 1) {
        if (_convert<i64>(indices[i]) >= vertices.size() / 3 or indices[i] < 0) {
          return SystemResult.Error(Error(1, "Mesh index exceeds vertex count"));
        }
      }
      this.pointer = unsafe { gu_mesh_new(_convert<i32>(vertices.size()), _convert<i32>(indices.size())); };
      for (var i: i64 = 0; i < vertices.size(); i += 1) {
        unsafe { gu_mesh_vertex(this.pointer, _convert<i32>(i), _convert<f32>(vertices[i])); };
      }
      for (var i: i64 = 0; i < indices.size(); i += 1) {
        unsafe { gu_mesh_index(this.pointer, _convert<i32>(i), _convert<u32>(indices[i])); };
      }
    }

    /** Releases this CPU asset reference; frames retain their own references. */
    deinit() {
      if (this.pointer != null) {
        unsafe { gu_mesh_free(this.pointer); };
      }
    }
  }

  /** Owns immutable GLSL sources compiled independently for each surface. */
  public class Shader {
    var pointer: raw_ptr<u8> = null;

    /** Copies source text; shader compilation errors are reported by the drawing surface. */
    init(vertex: ref String, fragment: ref String) SystemResult<void> {
      try validate_text(vertex);
      try validate_text(fragment);
      if (vertex.is_empty() or fragment.is_empty()) {
        return SystemResult.Error(Error(1, "Shader sources must not be empty"));
      }
      this.pointer = unsafe { gu_shader_new(vertex.c_str(), fragment.c_str()); };
    }

    /** Releases source storage after the last frame and GPU cache reference. */
    deinit() {
      if (this.pointer != null) {
        unsafe { gu_shader_free(this.pointer); };
      }
    }
  }

  /** Builds an owned packet; submission snapshots commands so later edits are independent. */
  public class Frame {
    var pointer: raw_ptr<u8> = null;

    /** Starts an empty frame with a normalized, finite clear color. */
    init(r: f64, g: f64, b: f64, a: f64) SystemResult<void> {
      if (not (r >= 0.0 and r <= 1.0 and g >= 0.0 and g <= 1.0 and b >= 0.0 and b <= 1.0 and a >= 0.0 and a <= 1.0)) {
        return SystemResult.Error(Error(1, "Invalid clear color"));
      }
      this.pointer = unsafe { gu_frame_new(_convert<f32>(r), _convert<f32>(g), _convert<f32>(b), _convert<f32>(a)); };
    }

    /** Releases the packet's CPU references. */
    deinit() {
      if (this.pointer != null) {
        unsafe { gu_frame_free(this.pointer); };
      }
    }

    /** Retains a shader and mesh with independent depth and alpha-blending settings. */
    public method draw(mesh: const ref Mesh, shader: const ref Shader, primitive: Primitive, depth: bool, blend: bool) SystemResult<void> {
      if (unsafe { gu_frame_draw(this.pointer, mesh.pointer, shader.pointer, primitive == Primitive.Lines ? 1 : 0, depth ? 1 : 0, blend ? 1 : 0); } == 0) {
        return SystemResult.Error(Error(1, "Invalid draw primitive count"));
      }
      return SystemResult.Ok;
    }

    /** Copies a float scalar, vector, or column-major matrix onto the most recent draw. */
    public method uniform(name: ref String, values: const ref Vec<f64>) SystemResult<void> {
      try validate_text(name);
      var count = values.size();
      if (not (count == 1 or count == 2 or count == 3 or count == 4 or count == 16)) {
        return SystemResult.Error(Error(1, "Uniform requires scalar, vector, or matrix values"));
      }
      for (var i: i64 = 0; i < count; i += 1) {
        unsafe { gu_uniform_value(_convert<i32>(i), _convert<f32>(values[i])); };
      }
      if (unsafe { gu_frame_uniform_built(this.pointer, name.c_str(), _convert<i32>(count)); } == 0) {
        return SystemResult.Error(Error(1, "Invalid uniform or missing draw"));
      }
      return SystemResult.Ok;
    }
  }

  /** Owns submitted CPU frames, input, diagnostics, and one context's GPU cache. */
  public class Surface {
    var pointer: raw_ptr<u8>;

    /** Allocates an initially empty surface independently of any window. */
    init() {
      this.pointer = unsafe { gu_surface_new(); };
    }

    /** Explicitly retains the same surface state without changing its host association. */
    init(other: const ref Surface) {
      this.pointer = other.pointer;
      unsafe { gu_surface_ref(this.pointer); };
    }

    /** Drops the application reference; a mounted host retains an independent reference. */
    deinit() {
      unsafe { gu_surface_free(this.pointer); };
    }

    /** Copies commands while retaining immutable assets, replacing the previous packet. */
    public method submit(frame: const ref Frame) void {
      unsafe { gu_surface_submit(this.pointer, frame.pointer); };
    }

    /** Copies the most recent rendering diagnostic, empty after a successful frame. */
    public const method error() String {
      return from_c_str(make_heap_allocator(), unsafe { gu_surface_error(this.pointer); });
    }

    /** Returns the number of successfully rendered frames. */
    public const method frames() i32 {
      return unsafe { gu_surface_frames(this.pointer); };
    }

    /** Returns the latest framebuffer size in physical pixels. */
    public const method extent(horizontal: bool) i32 {
      return unsafe { gu_surface_extent(this.pointer, horizontal ? 1 : 0); };
    }

    /** Enables optional center-pixel readback for deterministic acceptance checks. */
    public method readback(enabled: bool) void {
      unsafe { gu_surface_readback(this.pointer, enabled ? 1 : 0); };
    }

    /** Reads a stored RGBA channel from the latest test readback. */
    public const method pixel(channel: i32) i32 {
      return unsafe { gu_surface_pixel(this.pointer, channel); };
    }

    /** Pops one input event; overflow produces a focus-loss reset before later events. */
    public method next() Option<Input> {
      if (unsafe { gu_surface_next(this.pointer); } == 0) {
        return Option.None;
      }
      var k = _convert<i32>(unsafe { gu_surface_event(this.pointer, 0); });
      var kind = k == 1 ? InputKind.Move : (k == 2 ? InputKind.Button : (k == 3 ? InputKind.Key : (k == 4 ? InputKind.Scroll : (k == 5 ? InputKind.Focus : (k == 6 ? InputKind.Relative : InputKind.Close)))));
      return Option.Some(Input(kind, _convert<i32>(unsafe { gu_surface_event(this.pointer, 1); }), unsafe { gu_surface_event(this.pointer, 2); }, unsafe { gu_surface_event(this.pointer, 3); }));
    }

    /** Borrows the executor for host bindings that retain it before returning. */
    public const unsafe method raw_handle() raw_ptr<u8> {
      return this.pointer;
    }
  }
}
